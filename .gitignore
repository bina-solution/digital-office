digital-office/sim/apps/indox/dist-sim/
digital-office/sim/apps/indox/dist/
digital-office/sim/apps/indox/tsconfig.tsbuildinfo

# traefik ACME state — holds the account key and every issued TLS PRIVATE KEY.
# Tracked until 2026-07-29, which caused two problems: git records only the executable bit, so every
# clone landed at 644 and traefik SILENTLY skipped ACME ("permissions 644 ... are too open"), leaving
# the whole deployment on a self-signed cert; and any commit of it would have published private keys.
# bbox ensure_acme_perms creates it at 0600 on bring-up, which is the only place the mode can live.
platform-base/traefik/config/acme.json

# Phase-0 cleanup 2026-08-04: scratch hygiene
tmp/
tmp_*

# --- `bbox export` archives (scripts/deployment-archive.py) ---
# Multi-GB database dumps and volume tars, AND a copy of .env, the connections vault, the traefik
# ACME private keys and the catalog signing key — because an n8n dump restored without the matching
# N8N_ENCRYPTION_KEY yields credential rows that exist and cannot be decrypted, which is a restore
# that appears to succeed. The driver REFUSES to write anywhere `git check-ignore` does not claim,
# so deleting this line does not make the archive committable — it makes `bbox export` stop.
exports/

# Ground-truth index of the client's real documents (mail subjects, senders, filenames,
# Drive owners, file ids). Generated by data/ground-truth/*.py, ~76MB. This is live client
# business data: it must never enter git history. The CSVs stay on disk because the owner needs
# them as the success baseline -- the scripts beside them regenerate everything from source.
data/ground-truth/*.csv
apps/n8n/.push-cache/

# INDOX cycle run-output dumps: evidence, not source (~68 MB). Kept on disk, out of history.
apps/indox/issues/completed-docs.csv
apps/indox/issues/completed-merged.csv
apps/indox/issues/decide-census-20260819.csv

# Cygwin/MSYS crash dumps — never source.
*.stackdump

# INDOX extraction-draw overlays: a RENDER CACHE the app writes into its own source tree.
# apps/indox/docker-compose.yml bind-mounts ./storage:/app/.storage, so extraction.py's
# DRAW_CACHE_DIR (/app/.storage/extraction-draws) IS this directory. The endpoint renders on
# miss and serves on hit -- and extraction.py wipes the whole directory with shutil.rmtree on
# any query-settings edit, because a stale overlay would draw the pre-edit queries. Anything
# committed here is therefore deleted by the app itself, not by a person.
apps/indox/storage/extraction-draws/

# A window from ONE laptop onto a portable machine's bbox: two extra traefik routers pointing at
# a hardcoded LAN address. Machine-local by construction and additive -- the file's own header
# says so -- so it must not enter production IaC, where that address means nothing.
platform-base/traefik/config/posnet-window.yaml

# Point-in-time DB backups taken before a destructive fix (reclass cohorts, priority resends).
# Evidence the owner keeps on disk; multi-MB and never regenerated from source, so out of history.
data/backups/

# macOS Finder metadata
.DS_Store

# engine-wide job locks (scripts/lib.sh heavy_admit) — runtime state, never content
data/.locks/

# digital-assets output: the business's own domains, written by the app at run time
# (`data/wbcpq.com/…` — site content and generated media). Repository content never lives here, so
# the whole dotted-name directory is ignored rather than one domain at a time.
/data/*.*/

# the Stop hook's local switch and its two scratch files (.claude/hooks/work-left.py, check 4)
.claude/until-done
.claude/.work-left.*

# --- the OFFICE's own desired state (one per deployment, like .env beside .env.ex) ---
# The product default is tracked as platform.state.default.yaml; reconcile.ensure_state() creates this
# one from it on a checkout that has neither. Listing it here is the preparation for the owner's step
# of untracking it (see issues/one-offices-desired-state-is-what-every-clone-starts-from.yaml); git
# ignores this line for a file it still tracks, so it changes nothing until that step is taken.
/platform.state.yaml
