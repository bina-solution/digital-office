#!/usr/bin/env bash
#: new — a new meeting: its room, the host's link and the guests' link:  ./bbox meet new
# Runs the app's own CLI inside meet-start (apps/meet/start/cli.py), so it needs no address or key.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T meet-start python /app/cli.py new
