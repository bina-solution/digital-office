#!/usr/bin/env bash
#: meetings [N] — the newest N meetings that have a meet-flow page (default 10):  ./bbox meet meetings
# Runs the app's own CLI inside meet-start (apps/meet/start/cli.py), so it needs no address or key.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T meet-start python /app/cli.py meetings "${1:-10}"
