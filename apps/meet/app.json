{
  "id": "meet",
  "title": {
    "he": "פגישות לשכה",
    "en": "Video meetings"
  },
  "layer": 3,
  "kind": "service",
  "page": "meetings",
  "version": "0.1.0",
  "summary": {
    "he": "שיחות וידאו של המשרד — Jitsi Meet בעברית, מהדפדפן ומהנייד; מארחים נכנסים בחשבון המשרד, אורחים בקישור",
    "en": "The office's video meetings — Jitsi Meet in Hebrew, from a browser or a phone; hosts sign in with the office account, guests join by link"
  },
  "capabilities": [
    {
      "name": "recordings",
      "type": "protocol",
      "endpoint": "http://meet-start:8001",
      "link": true,
      "required_ops": [
        "list",
        "fetch",
        "to-plane"
      ]
    }
  ],
  "use": [
    {
      "capability": "kv",
      "strength": "wants",
      "after": false,
      "dependency": "weak"
    },
    {
      "capability": "identity",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "workflow",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "speech",
      "strength": "wants",
      "after": false,
      "dependency": "weak"
    },
    {
      "capability": "notify",
      "strength": "wants",
      "after": false,
      "dependency": "weak"
    }
  ],
  "blueprints": {
    "n8n": "blueprint/n8n"
  },
  "connections": [
    {"id": "project-pln-api-key", "required": false, "service": "project-pln"}
  ],
  "compose": "docker-compose.yml",
  "routing": [
    {
      "host": "meet",
      "port": 8000,
      "auth": "none"
    },
    {
      "host": "meet-start",
      "port": 8080,
      "service": "meet-start",
      "name": "meet-start",
      "auth": "sso",
      "url_env": "MEET_START_BASE_URL",
      "module": {
        "group": "תקשורת",
        "icon": "monitor",
        "embed": true,
        "alias": "meet",
        "id": "meet",
        "name": "פגישות לשכה",
        "desc": "פגישה חדשה, קישור לאורחים, Jitsi Meet",
        "order": 36,
        "url": "http://meet-start:8080",
        "url_env": "MEET_START_URL"
      },
      "sso": {
        "slug": "meet-start",
        "display_name": "Video meetings",
        "default_host": "meet-start.localhost",
        "base_url_env": "MEET_START_BASE_URL",
        "local_twin": true
      }
    }
  ],
  "progress_deadline_seconds": 900,
  "health": {
    "structural": "auto",
    "probe": {
      "http": "http://meet-start:8080/healthz",
      "interval": "30s"
    }
  },
  "data": {
    "volumes": [],
    "paths": ["data/meet/prosody", "data/meet/recordings"],
    "moved_from": {"data/meet/prosody": "meet_prosody_data", "data/meet/recordings": "meet_recordings"},
    "on_uninstall": "keep",
    "note": "data/meet/recordings (the volume meet_recordings until DGO-2019) is the office's record of its meetings: recordings/<session>/<room>_<time>.mp4 and metadata.json (the room, who was there), written by the recorder and listed in the tile. data/meet/prosody (meet_prosody_data) is prosody's store: the meetings' live captions (meet-captions/, the transcripts meet-start files with each meeting, kept MEET_CAPTIONS_KEEP_DAYS) beside its own files — state, never a cache."
  },
  "resources": {
    "cpus": "4.85",
    "memory": "3520M"
  },
  "agent": {
    "context": "AGENT.md",
    "order": 60
  }
}
