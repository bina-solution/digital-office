# === Supabase backend ===
# Already present in deployment .env.ex; reuse:
SUPABASE_DB_HOST=__PLACEHOLDER__   # e.g. supabase-db.<deployment>
SUPABASE_DB_PORT=5433
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=__PLACEHOLDER__
SUPABASE_SERVICE_KEY=__PLACEHOLDER__
SUPABASE_BASE_URL=supabase.hacohen.bina-solutions.co.il

# === Kafka ===
# No Kafka broker exists yet in the deployment. Decide between:
#   (a) Bringing up Redpanda / Kafka in compose.yml
#   (b) Re-using Redis Streams (already deployed)
# Plan currently says Kafka.
KAFKA_BROKERS=__PLACEHOLDER__       # e.g. redpanda:9092
KAFKA_TOPIC_PREFIX=incoming-documents
KAFKA_CLIENT_ID=apitools-incoming-documents
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=__PLACEHOLDER__
KAFKA_SASL_USERNAME=__PLACEHOLDER__
KAFKA_SASL_PASSWORD=__PLACEHOLDER__

# === Repo registry ===
# Where the list of document-repos themselves live. Options:
#   - in apitools' own .storage/incoming_documents/repos.json
#   - in a dedicated supabase table `incoming_doc_repos`
# Default: a local registry file (simplest for phase 3).
INCOMING_DOCS_REPO_REGISTRY=.storage/incoming_documents/repos.json

# === Service ===
INCOMING_DOCS_API_PREFIX=/incomingDocuments
INCOMING_DOCS_DEFAULT_REPO=prod_gsheet
