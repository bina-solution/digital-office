        "jsCode": "\n\n\nlet query = {\n  \"shipping_id_query\": {\n    \"action\": \"find after\",\n    \"action_value\": [\n        \"מספר תעודה בפנקס:\",\n        \"תעודת החזרה מלקוח מספר\",\n        \"משלוח אריזות מספר\",\n        \"תעודת משלוח מספר\",\n        \"משלוח מספר\",\n        \"תעודת משלוח מס':\",\n        \"תעודת משלוח מס'\",\n      \"מס' תמ\\\"ש\",\n        \"משלוח מספר\",\n         \"משלוח מס' :\",\n       \"תעודת משלוח מס'\",\n      \"תעודות משלוח\",\n        \"תעודת משלוח\",\n        \"תעודת משלוח מס\",\n      \"ת.משלוח מס.\",\n      \"ת.משלוח מס\",\n        \"תעודת משלוח\",\n        \"מספר משלוח\",\n        \"משלוח מס'\",\n      \"תע' משלוח\",\n      \"ת.משלוח\",\n      \"ת משלוח\",\n      \"מס משלוח\",\n      \"מס תעודה\",\n      \"מספר תעודה\",\n      \"סהכ תעודה\",\n      \"תעודה מס\",\n      \"תעודה:\",\n    ],\n    \"value_validations\": [\n        {\"validation_type\": \"has_number\"},\n        {\n            \"validation_type\": \"length_greater_than\",\n            \"validation_value\": 1\n        },\n        { \"validation_type\": \"length_less_than\", \"validation_value\": 20 },\n\n    ],\n    \"is_rtl\": true\n  },\n  \"match_index\": -1\n}\n\n\nif ([null,undefined,\"\", \"unkown\"].includes($json.COMPANY_DOC_ID)==false){\n  let not_doc_id_validation = { \n    \"validation_type\": \"not_ends_with\",\n    \"validation_value\": String($json.COMPANY_DOC_ID).slice?.(-5)\n  }\n  query.shipping_id_query.value_validations.push(not_doc_id_validation)\n}\nreturn query;\n"
