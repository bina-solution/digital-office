            },
            {
              "id": "bf20eb85-43d7-4bc2-84e2-100c18e47bd0",
              "name": "invoice_kws",
              "value": "={{ [\"חשבונית מס זיכוי מס':\",\n            \"חשבונית מס זיכוי\",\n      \"חשבונית מס מרוכזת מספר:\",\n            \"חשבונית מס מרכזת\",\n      \"חשבונית מס/קבלה מס':\",\n        \"חשבונית מס מספר:\",\n        \"חשבונית מס/קבלה\",\n      \"חשבונית מס / קבלה\",\n        \"חשבונית מס מספר\",\n        \"חשבונית מס מס':\",\n        \"חשבונית מס\\\"\",\n        \"חשבונית מס -\",\n        \"חשבונית מס :\",\n        \"חשבונית זיכוי\",\n        \"חשבונית מס'\",\n        \"חשבונית מס\"\n    ] }}",
              "type": "array"
            },
            {
              "id": "efe87ee9-df29-48d8-95ee-bf53619d89e2",
              "name": "shipment_kws",
              "value": "={{ [\n        \"משלוח אריזות מספר\",\n        \"תעודת משלוח מספר\",\n        \"משלוח מספר\",\n        \"תעודת משלוח מס':\",\n        \"תעודת משלוח מס'\",\n      \"מס' תמ\\\"ש\",\n        \"משלוח מספר\",\n         \"משלוח מס' :    \",\n       \"תעודת משלוח מס'\",\n        \"תעודת משלוח\",\n        \"תעודת משלוח מס\",\n        \"תעודת משלוח\",\n        \"מספר משלוח\",\n        \"משלוח מס'\",\n      \"תע' משלוח\",\n      \"ת.משלוח\",\n      \"מס תעודה\",\n      \"מספר תעודה\",\n      \"תעודה מס\",\n\n    ] }}",
              "type": "array"
            },
