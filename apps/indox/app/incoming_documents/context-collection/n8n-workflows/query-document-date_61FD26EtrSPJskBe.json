    {
      "parameters": {
        "jsCode": "\n\n// Compile regex once at module level (critical for performance)\nconst DOT_SEPARATOR = /^(\\d{1,2})\\.(\\d{1,2})\\.(\\d{2}|\\d{4})$/;\nconst SLASH_SEPARATOR = /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{2}|\\d{4})$/;\n\nfunction unifyDateFormat(dateString) {\n  // Early validation - fastest path\n  if (!dateString || typeof dateString !== 'string') return null;\n  \n  // Trim once\n  const str = dateString.trim();\n  \n  // Direct regex matching (faster than string operations)\n  let match = DOT_SEPARATOR.exec(str);\n  \n  if (!match) {\n    match = SLASH_SEPARATOR.exec(str);\n    if (!match) return null; // Invalid format\n  }\n  \n  // Destructure captured groups\n  let [, day, month, year] = match;\n  \n  // Fast string operations (avoid padStart for performance)\n  day = day.length === 1 ? '0' + day : day;\n  month = month.length === 1 ? '0' + month : month;\n  \n  // Handle 2-digit years efficiently\n  if (year.length === 2) {\n    year = '20' + year;\n  }\n  \n  // Direct string concatenation (fastest)\n  return day + '/' + month + '/' + year;\n}\n\n// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.result = unifyDateFormat(item.json.result)\n}\n\nreturn $input.all();"
      },
