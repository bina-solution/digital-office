    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// --- Process Add Request ---\n// This code validates incoming data, generates a unique ID, and maps the data to the Google Sheet format.\n\nconst body = $input.item.json;\n\n// 1. Validate required fields\nif (!body.NAME) {\n  throw new Error('Validation failed: Missing required fields NAME.');\n}\n\n// 2. Map and enrich the data for the new row\nconst newRow = {\n  ID: Math.floor(Math.random()*999999999) + Math.random().toString(36).substring(2, 8),\n  TYPE: body.TYPE?.toUpperCase() || '',\n  COMPANY_DOC_ID: body.COMPANY_DOC_ID || '',\n  COMPANY_ID: body.COMPANY_ID,\n  COMPANY_NAME: null,\n  NAME: body.NAME,\n  LINK: body.LINK,\n  SOURCE_TYPE: body.SOURCE_TYPE || '',\n  SOURCE_ID: body.SOURCE_ID || '',\n  SOURCE_LINK: body.SOURCE_LINK || '',\n  SIZE: body.SIZE || null,\n  HASH: body.HASH || '',\n  TIMESTAMP: new Date().toISOString(),\n  STATUS: body.STATUS || 'NEW',\n  REQUIRED_ACTION: body.REQUIRED_ACTION || '',\n  PURCHASE_ID: body.PURCHASE_ID || null,\n  LINKED_BS: body.LINKED_BS || null, \n  BS_LINE_AMOUNT: body.BS_LINE_AMOUNT || null,\n  BS_LINE_DATE: body.BS_LINE_DATE || null,\n  BS_LINE_NOTE: body.BS_LINE_NOTE || null\n};\n\n// Remove null values\nconst newRowWithoutNulls = Object.fromEntries(\n  Object.entries(newRow).filter(([key, value]) => value !== null)\n);\n// 3. Return the processed data for the next node\nreturn {\n  json: newRowWithoutNulls\n};\n"
      },
