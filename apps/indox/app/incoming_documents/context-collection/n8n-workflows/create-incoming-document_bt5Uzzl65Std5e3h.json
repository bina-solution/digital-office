        "jsCode": "// --- Data Filtering and Processing ---\n// This code applies the filters to the retrieved Google Sheets data\n\nconst allData = $('Google Sheets - Get All Rows1').all();\nconst filterConfig = $('Code - Process Get Request').first().json;\n\n// Helper function to check if a value matches the filter\nfunction matchesFilter(rowValue, filter) {\n  if (!rowValue) rowValue = '';\n  const rowValueStr = rowValue.toString().toLowerCase();\n  const filterValueStr = filter.value.toLowerCase();\n  \n  switch (filter.type) {\n    case 'exact':\n      return rowValueStr === filterValueStr;\n    case 'contains':\n      return rowValueStr.includes(filterValueStr);\n    default:\n      return false;\n  }\n}\n\n// Filter the data based on the provided filters\nconst filteredResults = allData.filter(item => {\n  const row = item.json;\n  \n  // All filters must match (AND logic)\n  return filterConfig.filters.every(filter => {\n    const fieldValue = row[filter.field];\n    return matchesFilter(fieldValue, filter);\n  });\n});\n\n// Prepare response data\nconst responseData = {\n  totalFound: filteredResults.length,\n  filters: filterConfig.filters.map(f => ({\n    field: f.field,\n    type: f.type,\n    value: f.value\n  })),\n  data: filteredResults.map(item => item.json)\n};\n\n// Return filtered results\nreturn filteredResults.length > 0 \n  ? [{ json: responseData }]\n  : [{ json: { ...responseData, error: 'No matching records found' } }];"
      },
      "id": "b83811ea-c8d4-477c-adc4-9807dad8ccc8",
      "name": "Code - Filter Data1",
