      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"error\": $json.error || \"No documents found matching the specified criteria\", \"totalFound\": $json.totalFound || 0, \"filters\": $json.filters || [] } }}",
        "options": {
          "responseCode": 404
        }
      },
      "id": "e9b41551-44ab-46ca-bad1-b5b6710e90cd",
      "name": "Response - Get Fail1",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        112,
        416
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// --- Enhanced Process Get Request ---\n// This code supports multiple query types: exact match, contains, and multiple field filtering\n\nconst query = $json.query;\n\n// Define valid searchable fields\nconst validFields = [\n  'ID', 'TYPE', 'COMPANY_DOC_ID', 'COMPANY_ID', 'COMPANY_NAME', 'HASH', \"SHORT_DOC_ID\",\n  'NAME', 'LINK', 'SOURCE_TYPE', 'SOURCE_ID', 'STATUS', 'REQUIRED_ACTION'\n];\n\n// Helper function to validate field names\nfunction isValidField(field) {\n  return validFields.includes(field.toUpperCase());\n}\n\n// Initialize filters array\nconst filters = [];\n\n// Process query parameters\nfor (const [key, value] of Object.entries(query)) {\n  if (!value || value === '') continue; // Skip empty values\n  \n  const upperKey = key.toUpperCase();\n  \n  // Handle 'contains' queries (field_contains=value)\n  if (key.endsWith('_contains')) {\n    const fieldName = key.replace('_contains', '').toUpperCase();\n    if (isValidField(fieldName)) {\n      filters.push({\n        type: 'contains',\n        field: fieldName,\n        value: value.toString()\n      });\n    }\n  }\n  // Handle exact match queries\n  else if (isValidField(upperKey)) {\n    filters.push({\n      type: 'exact',\n      field: upperKey,\n      value: value.toString()\n    });\n  }\n}\n\n// Validate that at least one filter was provided\nif (filters.length === 0) {\n  throw new Error('Validation failed: At least one valid query parameter is required. Valid fields: ' + validFields.join(', '));\n}\n\n// Return the filters configuration\nreturn {\n  json: {\n    filters: filters,\n    queryType: filters.length === 1 ? 'single' : 'multiple',\n    totalFilters: filters.length\n  }\n};"
      },
