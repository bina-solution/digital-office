#!/usr/bin/env bash
#: run an n8n workflow by id, with an optional pinned payload
# Trigger an n8n workflow by id via the internal REST API (from its trigger node), with an
# OPTIONAL JSON payload pinned on the "When Called" trigger (so callers can pass scope/params).
# Used to consolidate INDOX ops onto their canonical workflows:
#   INDOX Reset + Setup       = IndoxResetFull01   (clear-to-initial + seed config, via the API layer)
#       payload {"limit":N}    -> partial reset: at most N items per gmail label / drive folder
#       payload {"ids":[..]}   -> targeted reset of specific message/file ids (from sync STATUS)
#   INDOX Inject Demo Company = IndoxInjectDemo01   (companies + 30x5 demo docs from demo-docs)
# Usage: scripts/indox-trigger-wf <workflowId> ['<json-payload>']
set -euo pipefail
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"   # REPO_ROOT, N8N_CONTAINER
WFID="${1:?usage: indox-trigger-wf <workflowId> [json-payload]}"
PAYLOAD="${2:-}"
EM="$(grep -E '^N8N_OWNER_EMAIL=' "${REPO_ROOT}/.env" | cut -d= -f2-)"
PW="$(grep -E '^N8N_OWNER_PASSWORD=' "${REPO_ROOT}/.env" | cut -d= -f2-)"
docker exec -e EM="$EM" -e PW="$PW" -e WFID="$WFID" -e PAYLOAD="$PAYLOAD" "${N8N_CONTAINER}" node -e '
  const http=require("http");
  const r=(o,b)=>new Promise(s=>{const x=http.request(o,p=>{let d="";p.on("data",c=>d+=c);p.on("end",()=>s({h:p.headers,b:d}))});x.on("error",e=>s({h:{},b:String(e)}));if(b)x.write(b);x.end();});
  (async()=>{try{
    const l=await r({host:"localhost",port:5678,path:"/rest/login",method:"POST",headers:{"Content-Type":"application/json"}},JSON.stringify({emailOrLdapLoginId:process.env.EM,password:process.env.PW}));
    const ck=(l.h["set-cookie"]||[]).map(c=>c.split(";")[0]).join("; ");
    const g=await r({host:"localhost",port:5678,path:"/rest/workflows/"+process.env.WFID,method:"GET",headers:{Cookie:ck}});const wf=JSON.parse(g.b).data;
    if(!wf){console.log("workflow not found: "+process.env.WFID);process.exit(1);}
    const pl=process.env.PAYLOAD;
    // with a payload, start from the "When Called" trigger and pin the payload so the WF reads scope/params
    const called=wf.nodes.find(n=>n.type==="n8n-nodes-base.executeWorkflowTrigger");
    let start, body={workflowData:wf};
    // The payload must also REPLACE the workflow-s own pinData for the start node: body.workflowData
    // carries wf.pinData verbatim, and n8n prefers it, so a workflow that ships a pinned trigger
    // (indoxV2Driver01 pins {run_page:true}) ignored the payload entirely and ran its default path.
    // [2026-08-31] triggerToStartFrom must CARRY THE DATA on n8n 2.17: pinning alone left the
    // executeWorkflowTrigger with an empty item (measured: IndoxResetFull01 exec 3734995 saw
    // {} at When Called and refused). The trigger output is supplied as a full ITaskData in
    // triggerToStartFrom.data; the pin stays as a belt for older run semantics.
    if(pl && called){ start=called.name; let j={}; try{j=JSON.parse(pl);}catch(e){} const td={startTime:Date.now(),executionTime:0,executionStatus:"success",source:[],data:{main:[[{json:j}]]}}; body.startNodes=[{name:start}]; body.triggerToStartFrom={name:start,data:td}; body.pinData={[start]:[{json:j}]}; body.workflowData={...wf, pinData:{...(wf.pinData||{}), [start]:[{json:j}]}}; }
    else { start=(wf.nodes.find(n=>/Schedule|Trigger|When/.test(n.name))||wf.nodes[0]).name; body.startNodes=[{name:start}]; body.triggerToStartFrom={name:start}; }
    const run=await r({host:"localhost",port:5678,path:"/rest/workflows/"+process.env.WFID+"/run",method:"POST",headers:{"Content-Type":"application/json",Cookie:ck}},JSON.stringify(body));
    let eid="?";try{eid=JSON.parse(run.b).data.executionId;}catch(e){}
    console.log(process.env.WFID+" started (execution "+eid+")"+(pl?" scope="+pl:""));
  }catch(e){console.log("trigger failed: "+String(e).slice(0,140));process.exit(1);}})();'
