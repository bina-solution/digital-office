#!/usr/bin/env bash
#: decide only, over --id/--company/--status/--changed (or --sweep for every line): no lock, no action (the drain's dry run)
# bbox indox decide — DGO-231. Thin: the drain API (indoxV2BaseDrain01's webhook) through hooks/drain.py.
set -euo pipefail
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$(cd "${HOOK_DIR}/../../.." && pwd)/scripts/lib.sh"   # npath()
export PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1
exec python3 "$(npath "${HOOK_DIR}")/drain.py" decide "$@"
