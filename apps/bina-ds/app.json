{
  "id": "bina-ds",
  "title": {
    "he": "עזריה",
    "en": "Azaria"
  },
  "layer": 3,
  "people": "admins",
  "kind": "service",
  "page": "ai",
  "version": "0.1.0",
  "summary": {
    "he": "הסוכן של הלשכה — DeepSeek Harness בעברית, עוקב אחרי כל האפליקציות ופועל בהן",
    "en": "The office agent — a Hebrew-native DeepSeek Harness that follows and acts across every app"
  },
  "capabilities": [
    {
      "name": "office-agent",
      "type": "protocol",
      "interface": "agent.v1",
      "endpoint": "http://bina-ds:3081",
      "required_ops": [
        "health",
        "listSessions",
        "createSession",
        "getSession",
        "sendMessage",
        "listMessages"
      ]
    }
  ],
  "use": [
    {
      "capability": "identity",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "secrets",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "workflow",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "notify",
      "strength": "wants",
      "after": false,
      "dependency": "weak"
    },
    {
      "capability": "computers",
      "strength": "wants",
      "after": false,
      "dependency": "weak"
    }
  ],
  "connections": [
    {
      "id": "deepseek-key",
      "required": false
    },
    {
      "id": "openai-key",
      "required": false
    },
    {
      "id": "anthropic-key",
      "required": false
    },
    {
      "id": "computers-exec-token",
      "required": false,
      "note": "the office agent runs commands on machines through computers (DGO-1304)"
    }
  ],
  "contributes": {
    "env": {
      "any-concurrency": {
        "SPAN_SOURCE_BINA": "http://bina-ds:3081/timeline/spans",
        "SPAN_BUFFER_BINA": "20000"
      }
    }
  },
  "compose": "docker-compose.yml",
  "cli": { "alias": "bina" },
  "agent": {
    "context": "AGENT.md",
    "order": 3
  },
  "routing": [
    {
      "host": "azaria",
      "port": 3081,
      "auth": "sso",
      "emit_labels": true,
      "name": "azaria",
      "url_env": "AZARIA_BASE_URL",
      "module": {
        "group": "בינה מלאכותית",
        "icon": "bot",
        "embed": true,
        "alias": "bina",
        "id": "bina",
        "name": "עזריה",
        "desc": "הסוכן של הלשכה — כל השיחות, של עזריה ושל Claude, במקום אחד",
        "order": 1,
        "tab": true,
        "url": "http://bina-ds:3081",
        "url_env": "BINA_DS_URL",
        "passthrough": [
          {
            "path": "/",
            "match": "prefix",
            "transport": "http",
            "strip_mount_prefix": true
          }
        ]
      },
      "sso": {
        "slug": "azaria",
        "display_name": "Azaria",
        "default_host": "azaria.localhost",
        "base_url_env": "AZARIA_BASE_URL",
        "local_twin": true
      }
    },
    {
      "host": "bina",
      "port": 3080,
      "auth": "sso",
      "emit_labels": true,
      "sso": {
        "slug": "bina",
        "display_name": "Azaria · full harness",
        "default_host": "bina.localhost",
        "base_url_env": "BINA_DS_BASE_URL",
        "local_twin": true
      }
    }
  ],
  "health": {
    "structural": "auto",
    "probe": {
      "http": "http://bina-ds:3080/favicon.svg",
      "interval": "30s"
    }
  },
  "data": {
    "volumes": [
      "bina_ds_home"
    ],
    "on_uninstall": "keep"
  },
  "resources": {
    "cpus": "2",
    "memory": "2g"
  },
  "blueprints": {
    "n8n": "blueprint/n8n"
  }
}
