#!/usr/bin/env bash
#: generate — one answer to one prompt from a local model:  ./bbox ollama generate "<prompt>" -m <model> [--system "…"] [--max N] [--think] [--office <office>] [--json]
# apps/ollama/llm.py does the asking (POST /api/generate, not streamed): through this office's front, or a linked
# office's Ollama with --office. A prompt of "-" is read from stdin.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
front=""; running "ollama-screen-${DN}" && front="ollama-screen-${DN}"
OLLAMA_FRONT="${front}" exec python3 "$(npath "${REPO_ROOT}")/apps/ollama/llm.py" generate "$@"
