#!/usr/bin/env bash
#: unload — take a model out of memory now (its files stay):  ./bbox ollama unload <model> [--office <office>]
# apps/ollama/llm.py does the asking (POST /api/generate with keep_alive 0): through this office's front, or a linked
# office's Ollama with --office. `./bbox ollama loaded` says what is in memory.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
front=""; running "ollama-screen-${DN}" && front="ollama-screen-${DN}"
OLLAMA_FRONT="${front}" exec python3 "$(npath "${REPO_ROOT}")/apps/ollama/llm.py" unload "$@"
