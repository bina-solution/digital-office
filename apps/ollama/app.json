{
  "id": "ollama",
  "title": {
    "he": "מודלים מקומיים",
    "en": "Ollama"
  },
  "layer": 3,
  "kind": "service",
  "page": "ai",
  "version": "1.0.0",
  "summary": {
    "he": "הרצת מודלי שפה מקומית",
    "en": "Run local LLMs on your own hardware"
  },
  "capabilities": [
    {
      "name": "llm-local",
      "type": "protocol",
      "endpoint": "http://ollama:11434",
      "required_ops": [
        "generate",
        "chat",
        "embeddings",
        "pull"
      ]
    }
  ],
  "ops": [
    {"id": "models", "method": "GET", "path": "/api/tags", "access": "read", "verb": "models",
     "summary": {"he": "המודלים שהלשכה מחזיקה, וגודלם", "en": "the models this office holds, with their sizes"}},
    {"id": "loaded", "method": "GET", "path": "/api/ps", "access": "read", "verb": "loaded",
     "summary": {"he": "המודלים שבזיכרון עכשיו", "en": "the models in memory now"}},
    {"id": "show", "method": "POST", "path": "/api/show", "access": "read", "verb": "show",
     "summary": {"he": "מה מודל הוא: משפחה, גודל, קוונטיזציה, הקשר", "en": "what a model is: family, size, quantization, context"}},
    {"id": "generate", "method": "POST", "path": "/api/generate", "access": "read", "verb": "generate",
     "summary": {"he": "תשובה אחת לבקשה אחת", "en": "one answer to one prompt"}},
    {"id": "chat", "method": "POST", "path": "/api/chat", "access": "read", "verb": "chat",
     "summary": {"he": "תור אחד של שיחה", "en": "one turn of a chat"}},
    {"id": "embed", "method": "POST", "path": "/api/embed", "access": "read", "verb": "embed",
     "summary": {"he": "הווקטור של טקסט", "en": "the vector of a text"}},
    {"id": "unload", "method": "POST", "path": "/api/generate", "access": "write", "verb": "unload",
     "summary": {"he": "להוציא מודל מהזיכרון (הקבצים נשארים)", "en": "take a model out of memory (its files stay)"}}
  ],
  "use": [],
  "connections": [],
  "compose": "docker-compose.yml",
  "agent": {
    "context": "AGENT.md",
    "order": 85
  },
  "routing": [
    {
      "host": "ollama",
      "port": 11434,
      "auth": "sso",
      "emit_labels": false,
      "module": {
        "group": "תשתית",
        "icon": "brain",
        "embed": true,
        "alias": "ollama",
        "id": "ollama",
        "name": "מודלים מקומיים",
        "desc": "Ollama — מודלי שפה שרצים על המחשב הזה, בלי API חיצוני; הסוכן של כל לשכה מקושרת מוצא אותם",
        "order": 30,
        "service": "ollama",
        "url_env": "OLLAMA_INTERNAL_URL",
        "url": "http://ollama:11434"
      },
      "sso": {
        "slug": "ollama",
        "base_url_env": "OLLAMA_BASE_URL",
        "default_host": "ollama.localhost",
        "display_name": "Ollama",
        "local_twin": false
      }
    }
  ],
  "health": {
    "structural": "auto",
    "probe": {
      "http": "http://ollama:11434/api/tags",
      "interval": "60s"
    }
  },
  "data": {
    "volumes": [
      "ollama_data",
      "ollama_front_log"
    ],
    "cache": [
      "ollama_data",
      "ollama_front_log"
    ],
    "on_uninstall": "prompt"
  },
  "resources": {
    "cpus": "1.5",
    "memory": "6g"
  }
}
