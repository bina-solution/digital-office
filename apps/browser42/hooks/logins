#!/usr/bin/env bash
#: list | sources | sessions | await <service|host> [seconds] | sync | materialize | harvest | export <site>
# logins — one login, two stores, always the same in both.
#
#   logins list            what Chrome holds (origins + username lengths; passwords never read)
#   logins sources         what the credential plane offers, and which origin each entry maps to
#   logins sessions        which services the browser is SIGNED IN TO right now (cookie names and
#                          expiries only — never a value). `list` cannot answer it: a saved password
#                          outlives the session it was saved for, and a live session often has no
#                          password at all (SSO, a QR pairing, a device token).
#   logins await <svc> [s] the human handoff, MEASURED: wait until a live session for that service
#                          exists, then say what proved it. Exit 0 = connected, 2 = it did not
#                          happen inside the budget (default 300s).
#   logins sync            BOTH directions: plane -> Chrome (autofill) and Chrome -> plane (a new
#                          credential in חיבורים ומפתחות). Conflict rules live in logins.py's header.
#   logins materialize     plane -> Chrome only
#   logins harvest         Chrome -> plane only
#   logins export <site>   force one named site's Chrome login into its declared catalog row
#
# `bbox b42 <verb>` forwards here unchanged. The verb is a thin host-side wrapper because the profile
# lives inside the browser container (`cloakprofile:/profile`) and nowhere else: the work itself is
# `apps/browser42/logins.py`, mounted read-only at /logins.py, and this file only decides WHICH
# container is running and hands the arguments over. Nothing about Chrome's store is interpreted here.
#
# The password is never printed, in either direction: see the module docstring for the encoding (the
# container's keyring-less 'basic' store) and for what that implies about the profile volume.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"   # say, die, colors

APP_DIR="$(dirname "${SCRIPT_DIR}")"
# THIS office's browser container, by its exact name (compose: browser42-browser-${DEPLOYMENT_NAME}) — a
# substring matched another deployment's on the same engine — and its image and profile volume read from it:
# the names were written in as `digital-office…`, and on an office whose project is another (the HP's `mydgo`)
# the offline sync could never run, so every held store stopped the browser for nothing (the fifteenth reader).
BROWSER_NAME="browser42-browser-$(read_env DEPLOYMENT_NAME)"
[ "${BROWSER_NAME}" != "browser42-browser-" ] || BROWSER_NAME="browser42-browser-bina-deployment"
BROWSER="$(docker ps --filter "name=^/${BROWSER_NAME}\$" --format '{{.Names}}' | head -1)"
IMAGE="$(docker inspect -f '{{.Config.Image}}' "${BROWSER_NAME}" 2>/dev/null || true)"
VOLUME="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/profile"}}{{.Name}}{{end}}{{end}}' \
            "${BROWSER_NAME}" 2>/dev/null || true)"

[ -f "${APP_DIR}/logins.py" ] || die "apps/browser42/logins.py is missing"
[ -n "${IMAGE}" ] && [ -n "${VOLUME}" ] \
  || die "this office has no ${BROWSER_NAME} container to read its image and profile from — bbox apps enable browser42"

run_online() { docker exec "${BROWSER}" python3 /logins.py "$@"; }

# The offline path: no browser container, so no Chrome holding the store, while the profile volume,
# the state file and the network to the credential plane are all still there. Same work that
# start-browser.sh does at boot (section 4j) — deliberately one implementation, so what this prints
# by hand cannot differ from what a restart does.
OFFLINE=(-v "${VOLUME}:/profile"
         -v "${REPO_ROOT}/data/browser42:/data"
         -v "${APP_DIR}/logins.py:/logins.py:ro"
         --network traefik-network
         --entrypoint python3 "${IMAGE}")
run_offline() { docker run --rm "${OFFLINE[@]}" /logins.py "$@"; }

# The GUARDIAN of a sync that stopped the browser: a process of its own session (setsid), so that no signal to
# the wrapper or its group, and no KILL, reaches it — an EXIT trap in the wrapper could not outlive a second
# Ctrl-C or the KILL a timeout sends (the fourteenth reader). Once the wrapper is gone it waits for the offline
# run to end (or removes it, created and never started); waits until the engine says the browser's stop has
# FINISHED — an explicit "false" only, any other answer waits (the engine finishes a stop it was asked for,
# whoever then dies: the thirteenth); and starts the browser with `docker start`, the exact inverse of the
# stop (compose's `up` waited for the engine-wide heavy-job slot, hours behind a build: the fourteenth). When
# the wrapper started the browser itself it leaves a mark, and the guardian stands down.
#   guardian <wrapper pid> <offline container> <browser container> <done mark>
guardian() {
  local i st
  while kill -0 "$1" 2>/dev/null; do sleep 1; done
  if [ -e "$4" ]; then rm -f "$4"; return 0; fi
  for i in $(seq 1 900); do                          # the sync itself: up to 15 minutes, then it is ended
    st="$(docker inspect -f '{{.State.Status}}' "$2" 2>/dev/null)" || break      # gone: it ended (--rm)
    [ "${st}" = running ] || break                   # created and never started, or exited: removed below
    sleep 1
  done
  docker rm -f "$2" >/dev/null 2>&1 || true
  for i in $(seq 1 120); do                          # the stop, finished: up to 60 s
    [ "$(docker inspect -f '{{.State.Running}}' "$3" 2>/dev/null)" = false ] && break
    sleep 0.5
  done
  docker start "$3" >/dev/null 2>&1 || true
}

case "${1:-}" in
  sync|materialize|harvest)
    # ONE such sync at a time on this office, whichever path it takes: a second wrapper that lost the store's
    # own lock answered at once, started the browser, and Chrome opened the store while the first still wrote it
    # (the fifteenth reader); and one that came while the first had the browser stopped took the offline path
    # below with no lock at all (the reader of 1ebbe243). Held to the end of the guardian too (it inherits it).
    if command -v flock >/dev/null 2>&1 && mkdir -p "${REPO_ROOT}/data/.locks" 2>/dev/null \
       && exec {LOCK_FD}>>"${REPO_ROOT}/data/.locks/b42-logins.lock"; then
      flock -n "${LOCK_FD}" \
        || die "another logins sync is running on this office — nothing was done; run this again once it ends"
    fi
    # …and the browser is looked for once the lock is held: read before it, a sync whose engine answered slowly
    # saw the first one's browser stopped, got the lock once the first had started Chrome again, and wrote the
    # store offline under it (the reader of 8c03fbcd)
    BROWSER="$(docker ps --filter "name=^/${BROWSER_NAME}\$" --format '{{.Names}}' | head -1)"
    if [ -z "${BROWSER}" ]; then run_offline "$@"; exit $?; fi
    set +e
    first="$(run_online "$@")"; rc=$?
    set -e
    if [ "${rc}" -ne 3 ]; then
      printf '%s\n' "${first}"
      exit "${rc}"
    fi
    say "Chrome holds the password store — stopping the browser for the sync, then starting it again"
    # The browser comes back on ANY end from here on — a sync that answered badly (the eleventh reader of
    # DGO-1031), a TERM, HUP or second Ctrl-C wherever it lands, a KILL (the twelfth to fourteenth): the
    # guardian above, started BEFORE the stop. The offline run is CREATED first under a name the guardian
    # knows, then started attached: there is no moment it runs that the guardian cannot see, and Chrome is
    # never started while it writes the store.
    OFFLINE_NAME="browser42-logins-offline-$$-${RANDOM}"
    DONE="$(mktemp -u "${TMPDIR:-/tmp}/b42-logins-done.XXXXXX")"
    # the guardian is not this wrapper's child (a double fork: a tree-kill by parent pid reached it, and it had
    # no TERM handling: the fifteenth reader), and ignores INT, TERM and HUP
    if command -v setsid >/dev/null 2>&1; then
      ( setsid bash -c "trap '' INT TERM HUP; $(declare -f guardian); guardian \"\$@\"" \
          _ "$$" "${OFFLINE_NAME}" "${BROWSER}" "${DONE}" </dev/null >/dev/null 2>&1 & )
    else                                             # no setsid: signals are ignored, a KILL of the group is not
      ( ( trap '' INT TERM HUP; guardian "$$" "${OFFLINE_NAME}" "${BROWSER}" "${DONE}" ) </dev/null >/dev/null 2>&1 & )
    fi
    docker stop "${BROWSER}" >/dev/null \
      || die "the browser could not be stopped for the sync (docker stop ${BROWSER}) — nothing was synced"
    docker create --rm --name "${OFFLINE_NAME}" "${OFFLINE[@]}" /logins.py "$@" >/dev/null \
      || die "the offline sync could not be created — nothing was synced; the browser is started again"
    set +e
    out="$(docker start -a "${OFFLINE_NAME}")"; rc=$?
    set -e
    # an attach that broke early is not the sync's end: the browser waits for the container itself
    docker wait "${OFFLINE_NAME}" >/dev/null 2>&1 || true
    started=0
    docker start "${BROWSER}" >/dev/null || started=$?
    [ "${started}" -ne 0 ] || : > "${DONE}"
    printf '%s\n' "${out}"
    [ "${started}" -eq 0 ] \
      || die "the sync answered (above), and the browser could not be started again (docker start ${BROWSER}, exit ${started}) — its guardian tries again once this command ends"
    case "${rc}:${out}" in
      0:*'"ok": true'*) ;;
      *) die "the sync failed while the browser was stopped (exit ${rc}, see the output above); the browser is started again" ;;
    esac
    ;;
  list|sources|export|sessions)
    if [ -z "${BROWSER}" ]; then run_offline "$@"; exit $?; fi
    run_online "$@"
    ;;
  await)
    # Waiting for a person only means something while the browser is up: the session it waits for is
    # created in THAT browser, and a profile sitting still on disk cannot acquire one.
    [ -n "${BROWSER}" ] || die "the browser is not running — nothing can sign in until it is (bbox b42 task / bbox apps enable browser42)"
    run_online "$@"
    ;;
  *)
    die "usage: bbox b42 logins {list|sources|sessions|await <service|host> [seconds]|sync|materialize|harvest|export <site>}"
    ;;
esac
