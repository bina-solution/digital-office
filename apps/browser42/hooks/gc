#!/usr/bin/env bash
#: reap stale session groups (default: idle > 24h)
# gc — close + remove groups whose manifest last_seen is older than --stale HOURS
# (default 24). The automatic cleanup backstop for simultaneous multi-browsing agents.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"   # say, die, colors, DOCKER_HOST

BROWSER="$(docker ps --filter name=browser42-browser --format '{{.Names}}' | head -1)"
[ -n "${BROWSER}" ] || die "browser42-browser not running — run 'bbox run' first"
docker exec -i "${BROWSER}" python3 /group-manager.py gc "$@"
