#!/usr/bin/env bash
#: await <slug> <conditions> [seconds] — the STANDING human handoff: block until the PAGE says the
#: person finished (measured, never assumed), on a session tab that has no task budget.
# await — what an agent runs after handing a person a link.
#
#   bbox b42 open whatsapp-pair https://web.whatsapp.com       # the tab the human will look at
#   bbox b42 await whatsapp-pair "notext:Scan the QR code with your phone's camera" 280
#
# Why here and not only under `task`: a TASK is killed by its own clocks — 30 minutes of total wall
# time (`BROWSER42_TASK_TOTAL_SECONDS`) and 300s per request through the runner — and a person is not
# bounded that way. Measured 2026-10-14: the WhatsApp handoff died at exactly 30 minutes
# (`task_timeout`) while the owner had not been reached yet. A session tab has no such clock, so the
# long wait lives here; the conditions and the answer are identical to `bbox b42 task await`.
#
# Conditions are `<kind>:<value>`, comma-separated for several (all required): selector, gone, url,
# storage, text, notext. Success prints state:"met" plus what was observed; a timeout is a refusal
# (`await_timeout`) carrying what the page last showed.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"   # say, die, colors, DOCKER_HOST

BROWSER="$(docker ps --filter name=browser42-browser --format '{{.Names}}' | head -1)"
[ -n "${BROWSER}" ] || die "browser42-browser not running — run 'bbox run' first"
docker exec -i "${BROWSER}" python3 /group-manager.py await "$@"
