#!/usr/bin/env bash
#: flow — InterNIC's events (sign-ins, records, a lost session), the last 10 and then live:  ./bbox domain-internic flow [-n N] [--once] [--json]  (== dgo domain-internic flow)
# The app's stream on the office's event stream (flow.v1): the platform's reader, for `dgo:flow:domain-internic`.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "${SCRIPT_DIR}/../../../platform-base/redis/hooks/flow" domain-internic "$@"
