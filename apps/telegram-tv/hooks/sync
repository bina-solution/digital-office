#!/usr/bin/env bash
#: sync — how the sync of the Telegram chats is doing (reads; starts nothing):  ./bbox telegram-tv sync
# Pipes the app's own CLI (apps/telegram-tv/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T telegram-tv python - sync < "$(npath "${REPO_ROOT}")/apps/telegram-tv/cli.py"
