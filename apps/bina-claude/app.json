{
  "id": "bina-claude",
  "title": {
    "he": "בינה קלוד",
    "en": "Bina Claude"
  },
  "layer": 3,
  "people": "admins",
  "kind": "service",
  "page": "ai",
  "version": "0.1.0",
  "summary": {
    "he": "אפליקציית Claude Desktop הרשמית בתוך הלשכה, בכניסה אחת — מסך בקונסול, ו-CLI, API וזרימה על אותה כניסה",
    "en": "The official Claude Desktop app inside the office, with ONE sign-in — its screen in the console, and the CLI, the API and the flow on that same sign-in"
  },
  "agent_api_service": "bina-claude",
  "wraps": {
    "client": "Claude Desktop for Linux (beta), from Anthropic's apt repository (Dockerfile.desktop)",
    "headless": "Claude Code CLI, behind the agent.v1 adapter"
  },
  "capabilities": [
    {
      "name": "claude-agent",
      "type": "protocol",
      "interface": "agent.v1",
      "endpoint": "http://bina-claude:3091",
      "required_ops": [
        "health",
        "listSessions",
        "createSession",
        "getSession",
        "sendMessage",
        "listMessages"
      ]
    }
  ],
  "use": [
    {
      "capability": "identity",
      "strength": "requires",
      "after": true
    }
  ],
  "connections": [],
  "contributes": {
    "env": {
      "any-concurrency": {
        "SPAN_SOURCE_BINA_CLAUDE": "http://bina-claude:3091/timeline/spans",
        "SPAN_BUFFER_BINA_CLAUDE": "20000"
      }
    }
  },
  "compose": "docker-compose.yml",
  "cli": { "alias": "claude" },
  "agent": {
    "context": "AGENT.md",
    "order": 4
  },
  "routing": [
    {
      "host": "claude",
      "port": 3000,
      "auth": "sso",
      "service": "bina-claude-desktop",
      "emit_labels": true,
      "module": {
        "group": "ראשי",
        "icon": "sparkles",
        "embed": true,
        "alias": "bina-claude",
        "id": "bina-claude",
        "name": "בינה קלוד",
        "desc": "אפליקציית Claude המקורית, בתוך הלשכה",
        "order": 2,
        "url": "http://bina-claude-desktop:3000/",
        "url_env": "BINA_CLAUDE_URL",
        "passthrough": [
          {
            "path": "/api",
            "transport": "websocket",
            "match": "prefix",
            "strip_mount_prefix": true
          }
        ]
      },
      "sso": {
        "slug": "bina-claude",
        "display_name": "Bina Claude",
        "default_host": "claude.localhost",
        "base_url_env": "BINA_CLAUDE_BASE_URL",
        "local_twin": true
      }
    }
  ],
  "health": {
    "structural": "auto",
    "probe": {
      "http": "http://bina-claude:3091/v1/health",
      "interval": "30s"
    }
  },
  "data": {
    "volumes": [
      "bina_claude_home"
    ],
    "on_uninstall": "keep"
  },
  "resources": {
    "cpus": "2",
    "memory": "1536m"
  }
}
