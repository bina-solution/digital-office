#!/usr/bin/env bash
#: get — a file of «קבצים» by path, to a local file (or stdout):  ./bbox drive [-p <drive>] get "/הקלטות/x.m4a" [dest]
# A destination that is a folder takes the file's own name. The bytes stream; any size. The app's one door
# (hooks/cli → apps/drive/cli.py), on any of the office's drives.
exec bash "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cli" get "$@"
