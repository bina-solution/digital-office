#!/usr/bin/env bash
#: ls — what is in a folder of «קבצים», by path:  ./bbox drive ls /הקלטות
# Runs the app's own CLI inside its container (apps/drive/cli.py), so it needs no address or key.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T drive python /app/cli.py ls "${1:-/}"
