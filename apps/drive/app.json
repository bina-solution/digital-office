{
  "id": "drive",
  "title": {
    "he": "קבצים",
    "en": "Files"
  },
  "layer": 3,
  "kind": "adapter",
  "version": "1.0.0",
  "summary": {
    "he": "כל הקבצים של העסק במקום אחד — מסמכים, תמונות, הקלטות, פגישות וסרטונים; כל אפליקציה וכל סוכן קוראים וכותבים כאן",
    "en": "Every file of the business in one place — documents, photos, recordings, meetings and videos; every app and agent reads and writes here"
  },
  "capabilities": [
    {
      "name": "drive",
      "type": "service",
      "interface": "drive.v1",
      "endpoint": "http://drive:8975",
      "required_ops": [
        "list",
        "download",
        "upload",
        "move",
        "update",
        "delete",
        "createFromText"
      ],
      "optional_ops": [
        "watch",
        "revisions"
      ],
      "contract": "platform-service.v1"
    }
  ],
  "engine": {
    "id": "drive_local",
    "profiles": [
      {
        "id": "admin",
        "display_name": "מנהל",
        "admin": true
      },
      {
        "id": "user2",
        "display_name": "משתמש 2"
      }
    ]
  },
  "use": [
    {
      "capability": "workflow",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "sql",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "secrets",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "object-storage",
      "strength": "requires",
      "after": true,
      "ops": [
        "put",
        "get",
        "list",
        "delete"
      ]
    }
  ],
  "connections": [
    {
      "id": "supabase-service-key",
      "required": true
    },
    {
      "id": "supabase-db-password",
      "required": true
    }
  ],
  "blueprints": {
    "n8n": "blueprint/n8n"
  },
  "compose": "docker-compose.yml",
  "agent": {
    "context": "AGENT.md",
    "order": 15
  },
  "broker": {
    "service": "drive",
    "blank_env": [
      "SUPABASE_DB_PASSWORD",
      "SUPABASE_SERVICE_KEY"
    ],
    "entrypoint": [
      "sh",
      "/inject.sh",
      "gunicorn",
      "-c",
      "gunicorn.conf.py",
      "app:app"
    ]
  },
  "routing": [
    {
      "host": "drive",
      "port": 8975,
      "auth": "sso",
      "auth_exclude": [
        "/file/d/"
      ],
      "emit_labels": false,
      "module": {
        "group": "עסק",
        "icon": "folder",
        "embed": true,
        "alias": "drive",
        "id": "drive",
        "name": "קבצים",
        "desc": "מסמכים, תמונות, הקלטות וסרטונים",
        "order": 2,
        "service": "drive",
        "url_env": "DRIVE_URL",
        "url": "http://drive:8975"
      },
      "sso": {
        "slug": "drive",
        "default_host": "drive.localhost",
        "display_name": "Files",
        "local_twin": true,
        "base_url_env": "DRIVE_BASE_URL"
      }
    },
    {
      "port": 8975,
      "service": "drive",
      "auth": "none",
      "emit_labels": false,
      "module": {
        "group": "עסק",
        "icon": "mic",
        "embed": true,
        "alias": "recorder",
        "id": "recorder",
        "name": "הקלטות",
        "desc": "הקלטה בלחיצה — נשמרת ב«קבצים» ומגיעה לכל הסוכנים",
        "order": 3,
        "service": "drive",
        "url": "http://drive:8975/rec/"
      }
    }
  ],
  "health": {
    "structural": "auto",
    "probe": {
      "http": "http://drive:8975/readyz",
      "interval": "30s"
    }
  },
  "data": {
    "volumes": [
      "localdrive_data"
    ],
    "on_uninstall": "prompt",
    "sql": [
      {
        "instance": "supabase-db",
        "database": "postgres",
        "tables": [
          "drive_files",
          "drive_folders",
          "drive_profiles"
        ],
        "note": "created by adapters/local.py and profiles.py"
      }
    ]
  },
  "observability": {
    "sentry_platform": "python"
  },
  "contributes": {
    "env": {
      "any-concurrency": {
        "CUSTOM_SOURCE_DRIVE": "drive-${DEPLOYMENT_NAME:-bina-deployment}=drive",
        "CUSTOM_BUFFER_DRIVE": "8000"
      }
    }
  }
}
