{
  "id": "drive",
  "title": {
    "he": "קבצים",
    "en": "Files"
  },
  "layer": 3,
  "kind": "adapter",
  "page": "drive",
  "version": "1.0.0",
  "summary": {
    "he": "כל הקבצים של העסק במקום אחד — מסמכים, תמונות, הקלטות, פגישות וסרטונים; כל אפליקציה וכל סוכן קוראים וכותבים כאן",
    "en": "Every file of the business in one place — documents, photos, recordings, meetings and videos; every app and agent reads and writes here"
  },
  "capabilities": [
    {
      "name": "drive",
      "type": "service",
      "interface": "drive.v1",
      "endpoint": "http://drive:8975",
      "required_ops": [
        "list",
        "download",
        "upload",
        "move",
        "update",
        "delete",
        "createFromText"
      ],
      "optional_ops": [
        "watch",
        "revisions"
      ],
      "contract": "platform-service.v1"
    }
  ],
  "use": [
    {
      "capability": "kv",
      "strength": "wants",
      "after": false,
      "dependency": "weak"
    },
    {
      "capability": "workflow",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "secrets",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "drive-local",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "drive-google",
      "strength": "requires",
      "after": false
    }
  ],
  "blueprints": {
    "n8n": "blueprint/n8n"
  },
  "compose": "docker-compose.yml",
  "agent": {
    "context": "AGENT.md",
    "order": 15
  },
  "routing": [
    {
      "host": "drive",
      "port": 8975,
      "auth": "sso",
      "auth_exclude": [
        "/file/d/"
      ],
      "emit_labels": false,
      "module": {
        "group": "עבודה וקבצים",
        "icon": "folder",
        "embed": true,
        "alias": "drive",
        "id": "drive",
        "name": "קבצים",
        "desc": "מסמכים, תמונות, הקלטות וסרטונים",
        "order": 2,
        "tab": true,
        "service": "drive",
        "url_env": "DRIVE_URL",
        "url": "http://drive:8975"
      },
      "sso": {
        "slug": "drive",
        "default_host": "drive.localhost",
        "display_name": "Files",
        "local_twin": true,
        "base_url_env": "DRIVE_BASE_URL"
      }
    },
    {
      "port": 8975,
      "service": "drive",
      "auth": "none",
      "emit_labels": false,
      "module": {
        "group": "תקשורת",
        "icon": "mic",
        "embed": true,
        "alias": "recorder",
        "id": "recorder",
        "name": "הקלטות",
        "desc": "הקלטה בלחיצה — נשמרת ב«קבצים» ומגיעה לכל הסוכנים",
        "order": 3,
        "service": "drive",
        "url": "http://drive:8975/rec/"
      }
    }
  ],
  "health": {
    "structural": "auto",
    "probe": {
      "http": "http://drive:8975/readyz",
      "interval": "30s"
    }
  },
  "data": {
    "volumes": [],
    "paths": ["data/drive/state"],
    "moved_from": {"data/drive/state": "localdrive_data"},
    "on_uninstall": "prompt"
  },
  "observability": {
    "sentry_platform": "python"
  },
  "contributes": {
    "env": {
      "any-concurrency": {
        "CUSTOM_SOURCE_DRIVE": "drive-${DEPLOYMENT_NAME:-bina-deployment}=drive",
        "CUSTOM_BUFFER_DRIVE": "8000"
      }
    }
  },
  "cli": {
    "fallback": "cli"
  }
}
