  "cards": [
    { "dot": "violet", "title": "Declared, then compiled", "items": ["An app is a folder with an app.json; nothing else is edited to add one", "platform.state.yaml says which apps are on and what linked offices give", "The compiler is the only writer of that file and renders everything else from it"] },
    { "dot": "emerald", "title": "One way in", "items": ["Every request enters at the edge and is asked who it is", "The console frames each app under /a/<alias>/", "An app of a linked office is the same tile, reached through the link plane"] },
    { "dot": "amber", "title": "One hand on the machine", "items": ["app-management holds the checkout and the engine", "Enable, move, apply and the remote block all go through its API", "No office needs a shell on its own machine or on another's"] }
