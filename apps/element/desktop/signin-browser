#!/bin/sh
# /usr/local/bin/element-signin-browser <url> — this desktop's browser, for ONE thing: Element's own sign-in through
# a browser (DGO-1264; the pattern and its reasons are bina-claude's, DGO-1506: apps/bina-claude/desktop/signin-browser).
# desktop/autostart names it the http/https handler, and $BROWSER.
#
# A homeserver that signs in through a browser sends Element to one of two places, and back by a link:
#   SSO      https://<homeserver>/_matrix/client/<v>/login/sso/redirect[/<idp>]?redirectUrl=element://…
#   OIDC     https://<the server's account service>/…?…redirect_uri=io.element.desktop%3A…  (matrix.org's MAS)
# and the answer comes back as an element:// or io.element.desktop: link, which desktop/open-link hands to the
# running app. The homeserver is the owner's choice, so the HOST cannot be a list: the address is recognised by
# its Matrix sign-in path, or by naming Element's own return scheme. Anything else is not opened (it is logged
# by its host only): a link in a message opens on the owner's own computer, not on this screen.
#
# ONLY THE SIGN-IN. The browser runs without Chromium's sandbox (the container denies it the namespaces), as the
# desktop user. So the window lives at most ELEMENT_SIGNIN_MAX_S seconds (15 min), in a throwaway profile
# deleted when it closes, and the policy (browser-policy.json) blocks downloads. A new press closes an earlier
# window. The log names a host and a path, never the query (it carries the sign-in's state).
set -u
LOG="${HOME:-/config}/.element-open-url.log"
BIN="${ELEMENT_BROWSER_BIN:-chromium}"
TMP="${TMPDIR:-/tmp}"
PREFIX="element-signin."
MAX_S="${ELEMENT_SIGNIN_MAX_S:-900}"

note() {
  if [ -f "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 400 ]; then
    tail -n 200 "$LOG" > "$LOG.new" 2>/dev/null && mv -f "$LOG.new" "$LOG" 2>/dev/null
  fi
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG" 2>/dev/null || true
}
clean() { printf '%s' "$1" | tr -d '\000-\037\177'; }

url="${1:-}"
case "$url" in
  https://*) ;;
  *) note "refused: not an https address"; exit 2 ;;
esac
# A plain address only: a backslash ends the host for the browser but not for this parser, and whitespace or a
# byte outside printable ASCII has no place in a sign-in address.
case "$url" in
  *\\*|*" "*) note "refused: not a plain web address"; exit 2 ;;
esac
if [ "$(printf '%s' "$url" | LC_ALL=C tr -d '!-~'; printf x)" != x ]; then
  note "refused: not a plain web address"; exit 2
fi
rest="${url#*://}"
noq="${rest%%[?#]*}"
query="${rest#"$noq"}"
host="${noq%%/*}"
host="${host##*@}"
host="$(clean "${host%%:*}" | tr 'A-Z' 'a-z')"
path="/${noq#*/}"; [ "$path" = "/$noq" ] && path="/"
path="$(clean "$path")"
signin=no
case "$path" in
  /_matrix/client/*/login/sso/redirect|/_matrix/client/*/login/sso/redirect/*) signin=yes ;;
esac
case "$query" in
  *[?\&]redirect_uri=io.element.desktop*|*[?\&]redirectUrl=element*|*[?\&]redirectUrl=io.element.desktop*) signin=yes ;;
esac
if [ "$signin" != yes ]; then
  note "not opened link ${host}: this desktop's browser opens only Element's sign-in"
  exit 0
fi
if pkill -f -- "--user-data-dir=${TMP}/${PREFIX}" 2>/dev/null; then
  note "closed an earlier sign-in's window"
fi
profile="$(mktemp -d "${TMP}/${PREFIX}XXXXXX")" || { note "failed sign-in https://${host}${path}: no profile folder"; exit 1; }
id="${profile##*.}"
note "opened sign-in https://${host}${path} window=${id}"
cap=""; command -v timeout >/dev/null 2>&1 && cap="timeout -k 5 ${MAX_S}"
(
  $cap "$BIN" --no-sandbox --disable-gpu --disable-breakpad --password-store=basic \
    --user-data-dir="$profile" --no-first-run --no-default-browser-check --start-maximized --new-window \
    "$url" >/dev/null 2>&1
  rc=$?
  rm -rf "$profile"
  note "closed sign-in window=${id} (browser exit ${rc})"
) </dev/null >/dev/null 2>&1 &
exit 0
