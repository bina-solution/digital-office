#!/usr/bin/env bash
#: state — what Drive's object store holds, one `<name> <value>` per line:  ./bbox supabase state
#: In storage-api (data/supabase/storage): the files of its object tree — every byte Drive keeps, under the object ids
#: storage.objects indexes in the platform database. A count only, never a name. The data move
#: (platform/manager/datahome.py, DGO-2019) reads it before it moves the store and again after, and sends the store
#: back to its volume when what it held is gone. Plain sh: the storage-api image has busybox's find.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
# The data move names the container it measures; by hand, it is the office's own storage-api.
if [ -n "${DGO_STATE_CONTAINER:-}" ]; then
  inside() { docker exec -i "${DGO_STATE_CONTAINER}" "$@"; }
else
  . "${REPO_ROOT}/scripts/lib.sh"
  inside() { dcx exec -T storage "$@"; }
fi
inside sh -s <<'SH'
[ -d /var/lib/storage ] || exit 0
echo "storage.files $(find /var/lib/storage -type f 2>/dev/null | wc -l)"
SH
