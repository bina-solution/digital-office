#!/usr/bin/env bash
#: executions [hours] — n8n executions in the window (default 1 h):  ./bbox any-concurrency executions 6
# Pipes the app's own CLI (apps/any-concurrency/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T any-concurrency python - executions "$@" < "$(npath "${REPO_ROOT}")/apps/any-concurrency/cli.py"
