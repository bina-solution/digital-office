#!/usr/bin/env bash
#: spans [hours] [sources] — every span of the window (default 1 h; sources comma-separated):  ./bbox any-concurrency spans 2 n8n,traefik
# Pipes the app's own CLI (apps/any-concurrency/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T any-concurrency python - spans "$@" < "$(npath "${REPO_ROOT}")/apps/any-concurrency/cli.py"
