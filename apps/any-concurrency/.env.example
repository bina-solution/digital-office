# any-concurrency — environment variables reference
# Copy this file to .env and fill in values for your deployment.
# All variables are optional unless noted as REQUIRED.
#
# Usage with docker compose:
#   cp .env.example .env
#   # edit .env
#   docker compose -f docker-compose.standalone.yml up -d

# ── Port ───────────────────────────────────────────────────────────────────────
# Host port to bind. Container always listens on 8000.
PORT=8080

# ── n8n source (PostgreSQL) ───────────────────────────────────────────────────
# Set PG_HOST to enable the n8n workflow execution timeline.
# Leave PG_HOST empty to disable (ENABLE_N8N is derived from PG_HOST).
PG_HOST=           # e.g. localhost  or  postgres  (docker service name)
PG_PORT=5432
PG_USER=n8n
PG_PASS=           CHANGE_ME
PG_DB=n8n
# ENABLE_N8N=1     # auto-set to 1 when PG_HOST is non-empty

# n8n deep-link base URL — used to generate clickable links in the detail panel
# e.g. https://n8n.yourdomain.com  or  http://localhost:5678
N8N_URL=

# ── Traefik source (access log tail) ─────────────────────────────────────────
# Auto-discovers a running container with 'traefik' in its image name.
# Set TRAEFIK_CONTAINER to override auto-discovery with an exact container name.
# TRAEFIK_CONTAINER=traefik
ENABLE_TRAEFIK=1

# ── Docker events source ──────────────────────────────────────────────────────
ENABLE_DOCKER=1
DOCKER_BUFFER=5000        # ring-buffer size (number of spans kept in memory)

# ── LogSpan source (WA_SPAN log markers) ─────────────────────────────────────
# Any container that emits structured WA_SPAN JSON log lines becomes a source.
# Log line format:
#   WA_SPAN {"evt":"msg_start","id":"<id>","ts":<ms>,"from":"<identifier>"}
#   WA_SPAN {"evt":"msg_end","id":"<id>","ts":<ms>,"dur":<ms>,"ok":true}
# Set LOGSPAN_CONTAINER to the container name or leave empty to disable.
LOGSPAN_CONTAINER=        # e.g.  my-whatsapp-service
ENABLE_LOGSPAN=0          # set to 1 when LOGSPAN_CONTAINER is configured
WA_BUFFER=10000           # ring-buffer size (alias: LOGSPAN_BUFFER)

# ── Custom source (gunicorn/uvicorn JSON access logs) ─────────────────────────
# Any container that writes JSON access logs in the gunicorn/uvicorn format.
# Each log line must be valid JSON with at least: method, path, status, duration_ms.
# Set CUSTOM_CONTAINER to the container name or leave empty to disable.
CUSTOM_CONTAINER=         # e.g.  my-api-service
ENABLE_CUSTOM=0           # set to 1 when CUSTOM_CONTAINER is configured
APITOOLS_BUFFER=20000     # ring-buffer size (alias: CUSTOM_BUFFER)

# More than one such container? Each gets a lane of its own (own ring buffer, own tail task, own
# health entry). One variable per lane — CUSTOM_SOURCE_<ANYTHING>=<container>[=<lane>]:
# CUSTOM_SOURCE_MAILAPI=mailapi-my-deployment=mailapi
# CUSTOM_SOURCES=       # or one comma list: container[=lane],container[=lane]
# CUSTOM_BUFFER_MAILAPI=8000   # ring size for one lane
CUSTOM_BUFFER_DEFAULT=8000     # ring size for lanes that name none
# Successful health probes are dropped from these lanes (a FAILING probe is always kept), or the
# 30s polling would be most of a quiet service's lane. Set empty to keep every probe.
CUSTOM_HEALTH_PATHS=/healthz,/readyz,/health,/livez,/ping,/metrics

# ── Span sources (a lane an APP serves, rather than one tailed from a log) ────
# For work whose spans are not in a log line — an app that already HOLDS its spans as a table
# (start/end columns) and whose useful window is days of history, not whatever a ring holds.
# The app serves the projection in this service's own span schema and this service pulls it:
#   GET <url>?hours=<h>   the whole window   ·   GET <url>?since=<ms>  the delta poll
# One variable per lane — SPAN_SOURCE_<APP>=<url>[=<lane>]. The LANE NAME comes from the variable
# name (SPAN_SOURCE_INDOX -> `indox`), so a URL carrying a query string stays unambiguous:
# SPAN_SOURCE_INDOX=http://incoming-documents:8080/incomingDocuments/timeline/spans
# SPAN_SOURCES=          # or one comma list: url[=lane],url[=lane]
# SPAN_BUFFER_INDOX=20000      # live-tail ring for one lane (history comes from the endpoint)
SPAN_BUFFER_DEFAULT=20000      # ring size for lanes that name none
ENABLE_SPAN_SOURCES=1
SPAN_SOURCE_POLL_S=5           # delta poll interval
SPAN_SOURCE_TIMEOUT_S=25       # per-request timeout
SPAN_SOURCE_SEED_H=24          # window fetched once on attach
SPAN_SOURCE_OVERLAP_S=60       # re-asked window on each delta (absorbs clock skew; upserts dedupe)

# ── n8n background lanes (workers + task runners) ─────────────────────────────
# NOT configured as containers: the n8n container SET changes without an install (workers are
# scaled, each brings a task-runner sidecar), so this source asks Docker which containers exist
# and re-asks every N8N_LANES_SCAN_S — a worker that appears later gets its lane later, with no
# edit here. It matches by name structure: n8n, n8n-worker-<N>, n8n-worker-<N>-runners,
# n8n-task-runners, n8n-webhook[-<N>], each optionally suffixed with DEPLOYMENT_NAME.
# The whole set is ONE src (one timeline section) with one lane per container inside it.
ENABLE_N8N_LANES=1
N8N_LANES_SRC=n8n-bg      # the `src` the section is published under
N8N_LANES_SCAN_S=45       # rediscovery interval, seconds
N8N_LANES_BUFFER=24000    # ONE ring for the whole set (not per lane)
N8N_LANES_TAIL=5000       # lines replayed from each container on (re)attach

# ── Per-TASK spans for the task runners (n8n event bus) ───────────────────────
# n8n's task broker logs ONLY rejections/deferrals/ack-timeouts, and the JS runner logs nothing
# per task, so a task that SUCCEEDS appears in no log anywhere — which makes a busy runner look
# dead. n8n does record it on its internal event bus, and the event-bus log WRITER is unlicensed
# (only the log-streaming destinations are paid), so `n8n.runner.task.requested` +
# `n8n.runner.response.received` (paired on taskId) are already on disk in the n8n user folder.
# Mount that folder READ-ONLY (see docker-compose.yml) and this reads the pairs into one span per
# task, with the real start and end.
ENABLE_N8N_TASKS=1
N8N_EVENTLOG_DIR=/n8n-data
# `file[=lane]`. Both workers share one `-worker` file by default and a SUB-workflow execution
# never enters the queue, so n8n emits no host for it and those tasks land in the
# `runner-unattributed` lane rather than being guessed onto the wrong runner. To make attribution
# exact: give each n8n process its own event log with
# `N8N_EVENTBUS_LOGWRITER_LOGBASENAME=n8nEventLog-w1` (per worker; needs an n8n restart), then pin
# the files here — N8N_EVENTLOG_FILES=n8nEventLog.log=runner-main,n8nEventLog-w1.log=runner-1,...
N8N_EVENTLOG_FILES=n8nEventLog.log,n8nEventLog-worker.log
N8N_TASKS_POLL_S=1.5
N8N_TASKS_BACKFILL_BYTES=3000000   # how much existing log to replay on attach
N8N_TASKS_TTL_S=1800               # a request unanswered this long stops being tracked

# ── Traefik ring-buffer ───────────────────────────────────────────────────────
TRAEFIK_BUFFER=20000

# ── Webhook source (HTTP ingest) ──────────────────────────────────────────────
# Accepts POST /ingest/span or POST /ingest/spans from any app.
# Disable with ENABLE_WEBHOOK=0.
ENABLE_WEBHOOK=1
WEBHOOK_BUFFER=10000      # max spans retained in memory

# ── Redis (optional) — Bull queue visibility ──────────────────────────────────
# Set to enable the queue panel. Supports any Redis-compatible URL.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
