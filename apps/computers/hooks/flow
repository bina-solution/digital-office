#!/usr/bin/env bash
#: flow — every command run on a computer of this office (which computer, who asked, its first word, its exit), the last 10 and then live:  ./bbox computers flow [-n N] [--once] [--json]
# The app's stream on the office's event stream (flow.v1, DGO-1797): the platform's reader, for `dgo:flow:computers`.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "${SCRIPT_DIR}/../../../platform-base/redis/hooks/flow" computers "$@"
