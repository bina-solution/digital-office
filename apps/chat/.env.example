

# If using external traefik, set TRAEFIK_RELEASE to 0 else (locallly) set to 1
TRAEFIK_REPLICAS=0
TRAEFIK_LOG_LEVEL=DEBUG
TRAEFIK_API_INSECURE=true
TRAEFIK_DOCKER_EXPOSEDBYDEFAULT=false


# App configuration
APP_BASE_URL=chat.${DEPLOYMENT_DOMAIN}
APP_PORT=3000
NODE_ENV=production
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
SESSION_MAX_AGE=86400000 # 1 day
DAILY_MESSAGE_LIMIT=100
WA_ARCHIVE_ENABLED=true
WA_ARCHIVE_DB_PATH=/app/data/wa_archive.db
WA_ARCHIVE_SYNC_FULL_HISTORY=true
DEFAULT_COUNTRY_CODE=972
ADMIN_PHONE_1=050-000-0005
ADMIN_PHONE_2=050-000-0002
