          '<span class="r2"><span class="lm">'+lead+'<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(c.last)+'</span></span>'+tagHtml(c.tag)+pin+badge+'</span></span></div>';
      }).join('');
      host.querySelectorAll('.conv').forEach(function(el){var go=function(){openConv(el.getAttribute('data-id'));};el.onclick=go;el.onkeydown=function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();go();}};});
    }

    /* thread */
    var mob=function(){return window.matchMedia&&window.matchMedia('(max-width:820px)').matches;};
    function openConv(id){ S.openId=id; S.threadSig=''; var c=S.convs.filter(function(x){return x.id===id;})[0]; if(c)c.unread=0; renderList();
      if(mob()) document.querySelector('.chat').classList.add('mob-thread');   // slide to thread on phones
      // Opening a chat IS reading it. The badge was cleared locally only, so it came back on the next
      // load and the other side never saw a read tick — both halves of markRead were being skipped.
