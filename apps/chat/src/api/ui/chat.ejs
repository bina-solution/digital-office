    function mobBack(){ document.querySelector('.chat').classList.remove('mob-thread'); }
    /* An attachment on a message, rendered as a downloadable chip.
       The backend has carried `attachment` on every message shape from the start, and this renderer
       dropped it on the floor — so a file could be sent and then never seen, which is worse than not
       being able to send one. The bytes are fetched through THIS service (api/media/…), never from
       the engine's own URL: that host is only resolvable inside the docker network, and it wants the
       engine's own authorization, which a browser has no business holding. */
    function attHtml(a){
      if(!a||!a.name) return '';
      var kb=a.size?(a.size<1024?a.size+' B':Math.round(a.size/1024)+' KB'):'';
      return '<a class="att" href="api/media/'+encodeURIComponent(a.sha256||a.id||'')+'?name='+encodeURIComponent(a.name)+
        (S.active?'&connection_id='+encodeURIComponent(S.active):'')+'" download="'+esc(a.name)+'" title="הורדה">'+
        '<span class="att-ic">'+mark('clip')+'</span><span class="att-nm">'+esc(a.name)+'</span>'+(kb?'<span class="att-sz">'+kb+'</span>':'')+'</a>';
    }
    function bubble(msg,head,showSender){
      var sndr=(showSender&&msg.sender)?'<span class="sndr" style="color:'+(msg.scolor||'var(--blue)')+'">'+esc(msg.sender)+'</span>':'';
      var att=attHtml(msg.attachment);
      /* An attachment-only message has its filename as its preview text, so echoing that ABOVE the
         chip would print the name twice. */
      var txt=(att && msg.text==='📎 '+(msg.attachment&&msg.attachment.name))?'':esc(msg.text);
      return '<div class="msg '+(msg.dir==='out'?'out':'in')+(head?' head':'')+'">'+sndr+
        (txt?'<span class="txt">'+txt+'</span>':'')+att+
        '<span class="mt">'+clock(msg.mins)+(msg.dir==='out'?tickHtml(msg.status):'')+'</span></div>';
    }
    function msgsHtml(list,isGroup){
      var out='',prevKey=null,prevDay=null;
      list.forEach(function(mm){ var day=Math.floor(mm.mins/1440);
        if(day!==prevDay){ out+='<div class="daysep">'+daylabel(mm.mins)+'</div>'; prevDay=day; prevKey=null; }
        var key=mm.dir==='out'?'out':('in:'+(mm.sender||'')); var head=key!==prevKey;
        out+=bubble(mm, head, isGroup && mm.dir==='in' && head); prevKey=key;
      });
      return out;
    }
    function lastIsOut(m){ var e=m.querySelectorAll('.msg'); var l=e[e.length-1]; return l && l.classList.contains('out'); }
    function activeBotName(){var a=S.activeAcct;if(!a||a.activeBot==='none')return null;var b=S.bots.filter(function(x){return x.id===a.activeBot;})[0];return b?b.name:null;}
    function renderBotnote(){ var m=$('#msgs'); if(!m)return; var old=m.querySelector('.botnote'); if(old)old.remove();
      if(S.openContact && S.openContact.group) return;   // bots don't auto-reply in group chats
