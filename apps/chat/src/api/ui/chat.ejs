          <!-- phone-only twin of the sidebar's connection chip: under 820px aside.side is hidden, so
               without this the switcher and the bot controls would simply not exist on a phone. -->
          <button class="mconn" id="mConn" type="button" title="חיבור פעיל · החלפה"><span class="mdot" id="mConnDot"></span><span id="mConnName">—</span><svg class="mk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          <!-- …and of «שיחה חדשה»: the sidebar's button is hidden with the sidebar, and it was the only way to
               start a conversation - so none could be started from a phone, or from the window desktop mode opens
               this screen in (580px on a laptop). Never disabled: newChat() says why where the connection cannot. -->
          <button class="mnew" id="mNew" type="button" title="שיחה חדשה" aria-label="שיחה חדשה"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
        </div>
