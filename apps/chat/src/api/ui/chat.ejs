       WHY IT IS STILL IN THE APP, NOW THAT THE CONSOLE HAS A CHIP TOO. The console renders its own
       top-bar chip (renderAccountBar) for a module whose declaration carries `service:` — drive's and
       mail's do, and since c80af853 chat's does as well (routing[0].module.service = "chat" in
       apps/chat/app.json). So showEmbed() lights #acctChip and there are TWO controls on screen.
       Both are legitimate and neither is going away: this app is also served at its own origin
       (chat.hacohen.bina-solutions.co.il) where there is no console around it, and the shell owns
       "which account" for every embedded service by design. Making them agree is the fix; removing
       one is a different product.

       HOW THEY STAY IN SYNC. There is exactly ONE pointer — a file on this service's disk
       (chatapi/connections_client.js, /data/active.json) — and both controls write it: this one via
       POST api/account/select, the chip via POST /connections/select. The file being shared was never
       the problem. The problem was that a shared source of truth SAMPLED ONLY AT MOUNT is a cache:
       this app read the pointer once, inside boot(), so a chip click changed the pointer and the
       frame went on showing the previous account's label, badge, bot card and conversation list.
       Three edges close that, and all three are in this file:
         · the console posts a same-origin message into the frame on select / remove / wizard-close;
           the listener at the foot of this script answers it with resetForConnection() + boot().
         · every async continuation that writes per-connection state carries S.gen, so an answer
           about the connection we just left is dropped rather than painted (see fresh()).
         · loadConvs() checks the `account` field chatapi puts on every /conversations answer, which
           catches a pointer moved by something that cannot post a message at all — n8n, curl, or a
           second browser tab.
       If no message ever arrives (an older console), nothing breaks: showEmbed() re-sets the frame's
       src on every openModule(), so navigating away and back still re-boots the app. */
    function menuEl(){ return $('#acctMenu'); }
    function acctBtn(){ return $('#acctBtn'); }
    function hideMenu(){ var m=menuEl(),b=acctBtn(); if(m){m.classList.add('hidden'); if(b)b.setAttribute('aria-expanded','false');} }
    function toggleMenu(){ var m=menuEl(),b=acctBtn(); var open=m.classList.contains('hidden'); m.classList.toggle('hidden',!open); if(b)b.setAttribute('aria-expanded',open?'true':'false'); }
    /** One menu action, in mail's two-line shape (title + what it actually does). */
    function acctEntry(m,icon,title,sub,fn){
      var b=document.createElement('button');
      b.className='acct-add'; b.type='button'; b.setAttribute('role','menuitem');
      b.innerHTML='<span class="ai">'+icon+'</span><span class="acct-add-t"><span>'+esc(title)+
        '</span><span class="acct-add-s">'+esc(sub)+'</span></span>';
      b.onclick=function(e){ e.stopPropagation(); hideMenu(); fn(); };
      m.appendChild(b);
      return b;
    }
    function renderAcctMenu(){
      var m=menuEl(); if(!m)return; m.innerHTML='';
      acctRows(m);
      m.appendChild(node('div','acct-sep',''));
      /* ADD AN ACCOUNT IS FIRST, and named as an action — mail's ordering, for mail's reason. This
         entry has existed all along; what was missing was any suggestion that the control above it
         could be opened at all, which is what the plaque-shaped chip cost. */
      acctEntry(m,mark('plus'),'חיבור חשבון','וואטסאפ · טלגרם — אשף חיבור החשבון',openConnect);
      acctEntry(m,mark('bot'),'בוטים וחיבורים','איזה בוט עונה בכל חיבור, וההגדרות שלו',openBots);
      /* Administering the ENGINE is a different job from choosing a connection, and it exists only
         for the engine we run — so it is offered only while a local connection is active. On
         WhatsApp the equivalent gesture is pairing a device, which is «חיבור חשבון» above. */
      if(canAdminEngine())
        acctEntry(m,mark('user'),'פרופילים במנוע הפנימי','זהויות עם אישור גישה, ואנשי הקשר של המנוע',openEngine);
      /* The admin dashboard's remaining jobs — the subscriber list, the exports and a broadcast —
         reachable from the one control that already means "this app, not this conversation". */
      acctEntry(m,mark('tool'),'כלים וייצוא','ייצוא שיחות, הודעת תפוצה ורשימת המשתמשים',openTools);
      /* Not the same fact as #acctWarn: that one is the ACTIVE connection's readiness, this one is
         the connections SERVICE being unreachable, which costs every remote account at once. */
      if(!S.reachable){
        m.appendChild(node('div','acct-warn','<span>'+mark('alert')+'</span><span>שירות החיבורים אינו זמין — מוצג הצ׳אט המקומי בלבד.'+
          (S.connErr?' ('+esc(S.connErr)+')':'')+'</span>'));
      }
    }
    /** The connection rows themselves — shared by the sidebar menu and the phone-sized picker, so the
     *  two can never disagree about what is connected or which bot answers on it. */
    function acctRows(host,after){
      if(!S.accounts.length) host.appendChild(node('div','acct-empty','אין חיבורים זמינים'));
      S.accounts.forEach(function(c){
        var item=node('div','acct-item','');
        var pick=document.createElement('button');
        pick.className='acct-pick'; pick.type='button'; pick.setAttribute('role','menuitemradio');
        pick.setAttribute('aria-checked',c.id===S.active?'true':'false');
        pick.innerHTML='<span class="acct-l1"><span class="acct-dot" style="background:'+(STCOL[c.status]||'var(--line)')+'"></span>'+
          '<b class="acct-lbl">'+esc(c.label||c.id)+'</b>'+(c.id===S.active?'<span class="acct-on">'+mark('check','החיבור הפעיל')+'</span>':'')+'</span>'+
          (c.identity ? '<small class="acct-hint">'+esc(c.identity)+'</small>' : '')+
          '<small class="acct-proto">'+esc(provName(c))+' · בוט: '+esc(botNameOf(c.activeBot))+'</small>';
        pick.title=c.status==='ok'?'מצב אחרון מהשירות. בדיקה חיה מתבצעת על החיבור הפעיל בלבד.':(c.reason||STHE[c.status]||'');
        pick.onclick=function(e){ e.stopPropagation(); if(after)after(); selectConn(c.id); };
        item.appendChild(pick);
        /* Remove — only on a connection that HAS a vault row. The built-in local chat is synthetic
           (the service answers DELETE on it with a 400), so offering the control there would be a
           button whose only outcome is a refusal. */
        if(!c.builtin){
          var rm=document.createElement('button');
          rm.className='acct-rm'; rm.type='button'; rm.innerHTML=mark('x');
          rm.title='הסרת החיבור «'+(c.label||c.id)+'»';
          rm.setAttribute('aria-label',rm.title);
          rm.onclick=function(e){ e.stopPropagation(); if(after)after(); confirmRemoveConn(c); };
          item.appendChild(rm);
        }
        host.appendChild(item);
      });
    }
    /** Removing a connection deletes a credential — it gets a confirmation naming what goes, and the
     *  app re-boots afterwards because the ACTIVE pointer may have just been cleared by the service. */
    function confirmRemoveConn(c){
      var name=c.label||c.id;
      binaAsk({danger:true,ok:'הסרה',title:'להסיר את החיבור «'+name+'»?',
        body:'החיבור והסוד שלו יוסרו מכספת החיבורים. השיחות עצמן נשארות אצל הספק — '+
          'אבל האפליקציה לא תוכל להגיע אליהן עד שהחיבור יחובר מחדש.',
        facts:[['ספק',provName(c)]].concat(c.identity?[['חשבון',c.identity]]:[]),
        run:function(){ return must(del('/account/'+encodeURIComponent(c.id)),'הסרת החיבור נכשלה'); }
      }).then(function(ok){ if(ok){ tell('החיבור «'+name+'» הוסר'); return window.__chatReload(); } });
    }
    function node(tag,cls,html){ var e=document.createElement(tag); e.className=cls; e.innerHTML=html; return e; }

    /** The phone-sized switcher: same rows, presented as a sheet because there is no sidebar to
     *  anchor a dropdown to under 820px. */
    function openConnPicker(){
      // Same entries, same ORDER as the sidebar menu — add-an-account first — so the phone and the
      // desktop are one control presented twice, not two controls.
      var btns=[{label:'חיבור חשבון',onclick:function(){ closeModal(); openConnect(); }},
                {label:'בוטים וחיבורים',onclick:function(){ closeModal(); openBots(); }}];
      // Same gate as the sidebar menu, so the phone offers exactly what the desktop does.
      if(canAdminEngine()) btns.push({label:'פרופילים במנוע הפנימי',onclick:function(){ closeModal(); openEngine(); }});
      btns.push({label:'כלים וייצוא',onclick:function(){ closeModal(); openTools(); }});
      btns.push({label:'סגירה',pri:true,onclick:closeModal});
      modal('חיבור פעיל','<div id="connRows"></div>',btns);
      acctRows($('#connRows'),closeModal);
    }

    function selectConn(id){
      if(id===S.active){ hideMenu(); return; }
      post('/account/select',{id:id}).then(function(r){
        hideMenu();
        if(!r.ok) return tell((r.d&&r.d.error)||'החלפת החיבור נכשלה',true);
        // One door — the same one __chatReload() and the console's message go through, so all three
        // paths that mean "start over on a different connection" clear the same things.
        resetForConnection(id);
        return boot().then(function(){ tell('החיבור הוחלף: '+(S.activeAcct?S.activeAcct.label:id)); });
      });
    }

    /* ── modal ─────────────────────────────────────────────────────────────────── */
    function modal(title,bodyHtml,buttons){
      $('#mTitle').textContent=title; $('#mBody').innerHTML=bodyHtml;
      var f=$('#mFoot'); f.innerHTML='';
      (buttons||[]).forEach(function(b){
        var el=document.createElement('button'); el.type='button'; el.className='btn'+(b.pri?' pri':'');
        el.textContent=b.label; el.onclick=b.onclick; f.appendChild(el);
      });
      $('#ov').classList.remove('hidden');
    }
    function closeModal(){ $('#ov').classList.add('hidden'); }

    /* ── bots · the management surface ─────────────────────────────────────────────
       Two things live here and they are different questions. ATTACHMENT — which bot answers on which
       connection — is a full matrix rather than only the active connection's row, because the failure
       this prevents ("the WhatsApp number stopped answering") is invisible from a control that only
       ever shows the connection you happen to be looking at.

       SETTINGS is everything the bot itself declares — the schema comes from the bot, never from this
       file (GET api/bots/:id/settings returns {schema, settings}), so a bot that adds a knob gets a
       control here with no UI change. Values are per (connection, bot): the panel therefore follows
       the matrix ROW the operator selected, not the active connection, because the whole point of the
       contract is that the same bot runs a different policy on a public WhatsApp number than it does
       on internal local chat. A bot that declares no settings says so instead of showing an empty frame. */
    function capHtml(on,label){ return '<span class="cap'+(on?' on':'')+'">'+mark(on?'check':'x',on?'נתמך':'לא נתמך')+esc(label)+'</span>'; }
    function connLabel(id){ var c=S.accounts.filter(function(x){return x.id===id;})[0]; return (c&&(c.label||c.id))||id||'—'; }
    /* The panel's own state. `saved` is the server's LAST RESOLVED answer — the baseline every diff and
       every re-render is taken from, so the screen can never claim a value the service did not confirm.
       `token` invalidates an in-flight load/save when the operator moves to another row. */
    var BS={conn:null,bot:null,schema:[],saved:{},token:0};
    function ctlId(k){ return 'bs_'+String(k).replace(/[^a-zA-Z0-9]/g,'_'); }
    function fieldOf(k){ return BS.schema.filter(function(f){return f.key===k;})[0]||null; }
    function labelOf(k){ var f=fieldOf(k); return (f&&f.label)||k; }
    /** One control per declared field, chosen by `type` — the four the contract defines and no more.
     *  min/max/maxLength go into the markup so the browser refuses the value before the server has to. */
    function fieldHtml(f,val){
      var id=ctlId(f.key),k=esc(f.key),ctl,extra='';
      if(f.type==='boolean'){
        ctl='<label class="sw"><input type="checkbox" id="'+id+'" data-key="'+k+'"'+(val?' checked':'')+'><i></i></label>';
      }else if(f.type==='number'){
        ctl='<input type="number" id="'+id+'" data-key="'+k+'" step="1" inputmode="numeric" value="'+esc(val)+'"'+
          (f.min!==undefined?' min="'+esc(f.min)+'"':'')+(f.max!==undefined?' max="'+esc(f.max)+'"':'')+'>';
        if(f.min!==undefined||f.max!==undefined)
          extra='<span class="bset-unit">'+esc((f.min!==undefined?f.min:'')+'–'+(f.max!==undefined?f.max:''))+'</span>';
      }else if(f.type==='select'){
        ctl='<select id="'+id+'" data-key="'+k+'">'+(f.options||[]).map(function(o){
          var v=(o&&typeof o==='object'&&o.value!==undefined)?o.value:o;
          var l=(o&&typeof o==='object'&&o.label!==undefined)?o.label:v;
          return '<option value="'+esc(v)+'"'+(String(v)===String(val)?' selected':'')+'>'+esc(l)+'</option>';
        }).join('')+'</select>';
      }else{
        ctl='<input type="text" id="'+id+'" data-key="'+k+'" value="'+esc(val)+'"'+(f.maxLength?' maxlength="'+esc(f.maxLength)+'"':'')+'>';
        if(f.maxLength) extra='<span class="bset-unit">'+esc('≤'+f.maxLength)+'</span>';
      }
      return '<div class="bset-row" data-row="'+k+'">'+
        '<span class="bset-x"><label class="bset-lbl" for="'+id+'">'+esc(f.label||f.key)+'</label>'+
          (f.hint?'<span class="bset-hint">'+esc(f.hint)+'</span>':'')+'</span>'+
        '<span class="bset-ctl">'+ctl+extra+'</span></div>';
    }
    function openBots(){
      var body='<div class="mlbl">בוט לכל חיבור</div><div id="botMatrix"></div><div id="botDetail"></div>';
      modal('בוטים וחיבורים',body,[{label:'סגירה',pri:true,onclick:closeModal}]);
      S.botConn=(S.activeAcct&&S.activeAcct.id)||null;
      drawBotMatrix();
    }
    function drawBotMatrix(){
      var host=$('#botMatrix'); if(!host)return;
      if(!S.accounts.filter(function(x){return x.id===S.botConn;}).length)
        S.botConn=(S.activeAcct&&S.activeAcct.id)||(S.accounts[0]&&S.accounts[0].id)||null;
      host.innerHTML=S.accounts.map(function(c){
        return '<div class="brow'+(c.id===S.botConn?' on':'')+'" data-conn="'+esc(c.id)+'" role="button" tabindex="0"'+
          ' aria-pressed="'+(c.id===S.botConn?'true':'false')+'" title="עריכת ההגדרות בחיבור זה">'+
          '<span class="pic" style="background:'+esc(c.color||'var(--muted)')+'">'+
          provIco(c.provider)+'</span>'+
          '<span class="bx"><span class="bn">'+esc(c.label||c.id)+'</span><span class="bs">'+
            // the protocol name is the label of the built-in connection, and echoing it under itself
            // reads as a rendering fault rather than as a second fact
            (provName(c)===(c.label||'')?'':esc(provName(c))+(c.identity?' · ':''))+esc(c.identity||'')+'</span></span>'+
          '<select data-conn="'+esc(c.id)+'">'+S.bots.map(function(b){
            return '<option value="'+esc(b.id)+'"'+(b.id===c.activeBot?' selected':'')+'>'+esc(b.name)+'</option>';
          }).join('')+'</select></div>';
      }).join('')||'<div class="acct-empty">אין חיבורים</div>';
      host.querySelectorAll('select').forEach(function(sel){
        sel.onchange=function(){ sel.disabled=true; var cid=sel.getAttribute('data-conn');
          setBot(cid,sel.value).then(function(){ sel.disabled=false; pickBotConn(cid,true); });
        };
      });
      // The row is what selects the connection being configured; the select inside it is a different
      // control and must keep its own click.
      host.querySelectorAll('.brow').forEach(function(row){
        var go=function(e){ if(e.target&&e.target.closest&&e.target.closest('select'))return; pickBotConn(row.getAttribute('data-conn')); };
        row.onclick=go;
        row.onkeydown=function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); go(e); } };
      });
      drawBotDetail(S.botConn);
    }
    /** Move the panel to `connId`. `force` re-reads even if the row did not change (the attached bot did). */
    function pickBotConn(connId,force){
      if(!force&&connId===S.botConn) return;
      S.botConn=connId;
      var host=$('#botMatrix');
      if(host) host.querySelectorAll('.brow').forEach(function(r){
        var on=r.getAttribute('data-conn')===connId;
        r.classList.toggle('on',on); r.setAttribute('aria-pressed',on?'true':'false');
      });
      drawBotDetail(connId);
    }
    /** Load and render the settings of whichever bot is attached to `connId`, ON that connection. */
    function drawBotDetail(connId){
      var d=$('#botDetail'); if(!d)return;
      var c=S.accounts.filter(function(x){return x.id===connId;})[0]||null;
      var botId=(c&&c.activeBot)||'none', b=botOf(botId), tk=++BS.token;
      BS.conn=connId; BS.bot=botId; BS.schema=[]; BS.saved={};
      var head='<div class="mlbl">ההתנהגות בחיבור «'+esc(connLabel(connId))+'»</div>';
      if(!c){ d.innerHTML='<div class="bcard"><h4>אין חיבור נבחר</h4><p>בחר/י חיבור מהרשימה שלמעלה.</p></div>'; return; }
      if(!b){
        d.innerHTML=head+'<div class="bcard"><h4>'+esc(botNameOf(botId))+'</h4>'+
          '<p>לא יופעל מענה אוטומטי בחיבור הזה. כל ההודעות הנכנסות ממתינות לצוות.</p>'+
          '<div class="note">אין מה להגדיר — בחר/י בוט לחיבור הזה כדי לפתוח את ההגדרות שלו.</div></div>';
        return;
      }
      d.innerHTML=head+'<div class="bcard"><h4>'+esc(b.name)+'</h4><p>'+esc(b.desc||'')+'</p>'+
        '<div class="mlbl">מה הבוט עושה תמיד</div><div class="caps">'+
          capHtml(true,'שאלות')+capHtml(true,'בחירה בתפריט')+capHtml(true,'פקודות')+
          capHtml(true,'בקשה לנציג')+capHtml(true,'קבצים מצורפים')+
        '</div><div id="botSet"><div class="acct-empty">טוען הגדרות…</div></div></div>';
      jx('/bots/'+encodeURIComponent(botId)+'/settings?connection_id='+encodeURIComponent(connId)).then(function(r){
        if(tk!==BS.token)return;                       // the operator moved on — that answer is stale
        var host=$('#botSet'); if(!host)return;
        if(!r.ok){ host.innerHTML='<div class="mlbl">הגדרות</div><div class="note">לא ניתן לטעון את ההגדרות: '+
          esc((r.d&&r.d.error)||('שגיאה '+r.status))+'</div>'; return; }
        BS.schema=(r.d&&r.d.schema)||[]; BS.saved=(r.d&&r.d.settings)||{};
        BS.conn=(r.d&&r.d.connection_id)||connId;      // the service decides which connection it answered for
        renderBotSet();
      });
    }
    /** Draw the controls from BS.schema over BS.saved — the only place values reach the screen. */
    function renderBotSet(){
      var host=$('#botSet'); if(!host)return;
      if(!BS.schema.length){
        host.innerHTML='<div class="mlbl">הגדרות</div><div class="note">הבוט הזה אינו מגדיר הגדרות הניתנות לשינוי — כל ההתנהגות שלו קבועה.</div>';
        return;
      }
      host.innerHTML='<div class="mlbl">הגדרות בחיבור זה</div>'+
        BS.schema.map(function(f){ return fieldHtml(f,BS.saved[f.key]); }).join('')+
        '<div class="bset-foot"><button class="btn pri" id="bsSave" type="button">שמירה</button>'+
        '<button class="btn" id="bsUndo" type="button">ביטול שינויים</button>'+
        '<button class="btn" id="bsReset" type="button">איפוס לברירת המחדל</button>'+
        '<span class="bset-state" id="bsState"></span></div>';
      host.querySelectorAll('[data-key]').forEach(function(el){
        var ev=(el.tagName==='SELECT'||el.type==='checkbox')?'change':'input';
        el.addEventListener(ev,function(){ clearFieldErr(el.getAttribute('data-key')); markDirty(); });
      });
      $('#bsSave').onclick=saveBotSet;
      $('#bsUndo').onclick=function(){ renderBotSet(); };
      $('#bsReset').onclick=resetBotSet;
      markDirty();
    }
    /** Back to whatever the BOT declares — which is not the same as writing today's defaults back.
     *  The service stores overrides only, so this DELETEs them; saving the current defaults instead
     *  would pin them, and a bot that later changed a default would keep running the old one here. */
    function resetBotSet(){
      var conn=BS.conn,bot=BS.bot,tk=BS.token,d;
      // What was saved for this bot on this connection is gone once reset, so it is asked (see `must`).
      binaAsk({danger:true,ok:'איפוס',title:'לאפס את ההגדרות לברירת המחדל?',
        body:'הערכים שנשמרו לבוט בחיבור הזה יימחקו, והבוט יתנהג כפי שהוא עצמו מגדיר.',
        facts:[['בוט',botNameOf(bot)],['חיבור',connLabel(conn)]],
        run:function(){ return must(jx('/bots/'+encodeURIComponent(bot)+'/settings',{method:'DELETE',
          headers:{'Content-Type':'application/json'},body:JSON.stringify({connection_id:conn})}),'האיפוס נכשל')
          .then(function(r){ d=r.d||{}; }); }
      }).then(function(ok){
        if(!ok||tk!==BS.token)return;
        BS.saved=d.settings||BS.saved;
        renderBotSet();
        var n=(d.cleared||[]).length;
        tell(n?('אופסו '+n+' הגדרות · '+connLabel(conn)):('אין מה לאפס — הכל בברירת המחדל'));
      });
    }
    function currentVals(){
      var out={};
      BS.schema.forEach(function(f){
        var el=document.getElementById(ctlId(f.key)); if(!el)return;
        out[f.key]= f.type==='boolean' ? !!el.checked
          : f.type==='number' ? (el.value===''?'':Number(el.value))
          : el.value;
      });
      return out;
    }
    /** Only what actually changed goes on the wire. The API takes a partial set, and sending the whole
     *  form would silently re-write keys this operator never touched. */
    function changedVals(){
      var cur=currentVals(),out={},n=0;
      Object.keys(cur).forEach(function(k){ if(String(cur[k])!==String(BS.saved[k])){ out[k]=cur[k]; n++; } });
      return {vals:out,n:n};
    }
    function markDirty(){
      var st=$('#bsState'),sv=$('#bsSave'); if(!st||!sv)return;
      var n=changedVals().n;
      sv.disabled=!n; sv.style.opacity=n?'1':'.55'; sv.style.cursor=n?'pointer':'default';
      st.classList.remove('bad');
      st.textContent=n?(n===1?'שינוי אחד לא נשמר':n+' שינויים לא נשמרו'):'הכל שמור';
    }
    function clearFieldErr(key){
      var row=key&&$('#botSet .bset-row[data-row="'+String(key).replace(/"/g,'')+'"]'); if(!row)return;
      row.classList.remove('bad'); var e=row.querySelector('.bset-err'); if(e)e.remove();
    }
    /** A 400 names the offending FIELD inside quotes — put the reason next to that control and focus it.
     *  A generic toast would throw away the one thing the API went to the trouble of telling us. */
    function showFieldErr(key,msg){
      var row=key&&$('#botSet .bset-row[data-row="'+String(key).replace(/"/g,'')+'"]');
      if(!row){ var st=$('#bsState'); if(st){ st.textContent=msg; st.classList.add('bad'); } return false; }
      clearFieldErr(key);
      row.classList.add('bad');
      row.querySelector('.bset-ctl').insertAdjacentHTML('beforeend','<span class="bset-err">'+esc(msg)+'</span>');
      var el=document.getElementById(ctlId(key)); if(el&&el.focus)el.focus();
      return true;
    }
    function saveBotSet(){
      var ch=changedVals(); if(!ch.n)return;
      BS.schema.forEach(function(f){ clearFieldErr(f.key); });
      var sv=$('#bsSave'); sv.disabled=true; sv.style.opacity='.55';
      var st=$('#bsState'); if(st){ st.classList.remove('bad'); st.textContent='שומר…'; }
      var conn=BS.conn,bot=BS.bot,tk=BS.token;
      jx('/bots/'+encodeURIComponent(bot)+'/settings',{method:'PUT',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({connection_id:conn,settings:ch.vals})}).then(function(r){
        if(tk!==BS.token)return;
        if(!r.ok){
          var msg=(r.d&&r.d.error)||('שמירת ההגדרות נכשלה ('+r.status+')');
          var m=/"([^"]+)"/.exec(msg), key=m&&fieldOf(m[1])?m[1]:null;
          var pointed=showFieldErr(key,msg);
          markDirty();
          return tell(pointed?('לא נשמר — «'+labelOf(key)+'»'):msg,true);
        }
        // The PUT answers with the FULL resolved set. Re-render from THAT: what was sent is a request,
        // what came back is what the service actually holds.
        BS.saved=(r.d&&r.d.settings)||BS.saved;
        if(r.d&&r.d.connection_id) BS.conn=r.d.connection_id;
        renderBotSet();
        tell('ההגדרות נשמרו · '+connLabel(conn));
      });
    }

    /* ── connect ───────────────────────────────────────────────────────────────────
       The catalogue is the SERVICE's (GET api/chat-providers), which is itself derived from the
       protocols adapters/index.js can build — so this screen can never offer a backend that would
       fail on its first op. It is provider-first with auth methods, the same shape mail's flow uses,
       because the two apps share a switcher vocabulary and should share this one too.

       `direct` is what splits the flow in half, and it is the service's answer, not a guess here:
         · direct  — the credential is a STRING the operator has (a Telegram bot token). It is typed
                     here and POSTed to api/account/add, which forwards it to the vault. Chat still
                     stores nothing: the vault is the only writer.
         · not direct — the pairing is a browser ceremony (WhatsApp's QR, proxied by the console's
                     חיבורים ומפתחות screen with the chat-auth basic auth). This hands over rather
                     than inventing a second place where a pairing is attempted. */
    var CONN={providers:[],pick:null};
    function openConnect(){
      modal('חיבור חשבון צ׳אט','<div id="connBody"><div class="acct-empty">טוען ספקים…</div></div>',
        [{label:'סגירה',pri:true,onclick:closeModal}]);
      jx('/chat-providers').then(function(r){
        var host=$('#connBody'); if(!host)return;
        if(!r.ok){ host.innerHTML='<div class="note">לא ניתן לטעון את רשימת הספקים: '+esc((r.d&&r.d.error)||('שגיאה '+r.status))+'</div>'; return; }
        CONN.providers=(r.d&&r.d.providers)||[]; CONN.pick=null;
        drawProviders();
      });
    }
    function drawProviders(){
      var host=$('#connBody'); if(!host)return;
      var have={}; S.accounts.forEach(function(a){ have[a.provider]=true; });
      host.innerHTML='<div class="mlbl">מה אפשר לחבר</div>'+CONN.providers.map(function(p){
        var m=p.auth_methods&&p.auth_methods[0]||{};
        var meta=PROTOHE[m.protocol]||{color:'var(--muted)',ic:'·'};
        var connected=have[String(m.protocol||'').replace(/^chat_/,'')];
        return '<div class="prow" role="button" tabindex="0" data-prov="'+esc(p.id)+'">'+
          '<span class="pic" style="background:'+esc(meta.color)+'">'+(meta.mk?mark(meta.mk):esc(meta.ic))+'</span>'+
          '<span class="px"><span class="pn">'+esc(p.name)+(connected?' · מחובר':'')+(p.builtin?' · מובנה':'')+'</span>'+
          '<span class="pd">'+esc(p.description||'')+'</span></span>'+
          '<span class="cap'+(m.direct?' on':'')+'">'+(m.direct?'הזנת מפתח':'קישור בלשכה')+'</span></div>';
      }).join('')+'<div id="connForm"></div>';
      host.querySelectorAll('.prow[data-prov]').forEach(function(row){
        var go=function(){ pickProvider(row.getAttribute('data-prov')); };
        row.onclick=go; row.onkeydown=function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); go(); } };
      });
    }
    function pickProvider(id){
      CONN.pick=id;
      var p=CONN.providers.filter(function(x){return x.id===id;})[0]; if(!p)return;
      var m=(p.auth_methods||[])[0]||{};
      var f=$('#connForm'); if(!f)return;
      if(p.builtin){
        f.innerHTML='<div class="bcard"><h4>'+esc(p.name)+'</h4><p>'+esc(m.can||'')+'</p>'+
          '<div class="note">מובנה בפלטפורמה — קיים תמיד ואין מה לחבר.</div></div>';
        return;
      }
      if(!m.direct){
        f.innerHTML='<div class="bcard"><h4>'+esc(m.label||p.name)+'</h4>'+
          '<p>'+esc(m.explain||'')+'</p>'+
          '<div class="bset-foot"><button class="btn pri" id="connGo" type="button">פתיחת מסך החיבורים</button>'+
          '<span class="bset-state">שם נשמרים הסודות של כל השירותים</span></div></div>';
        $('#connGo').onclick=function(){ closeModal(); gotoConnections(); };
        return;
      }
      f.innerHTML='<div class="bcard"><h4>'+esc(m.label||p.name)+'</h4><p>'+esc(m.explain||m.can||'')+'</p>'+
        '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="cf_label">שם לתצוגה</label>'+
          '<span class="bset-hint">איך החיבור ייקרא ברשימת החיבורים.</span></span>'+
          '<span class="bset-ctl"><input type="text" id="cf_label" value="'+esc(p.name)+'"></span></div>'+
        (m.needs||[]).map(function(k){
          return '<div class="bset-row" data-row="'+esc(k)+'"><span class="bset-x">'+
            '<label class="bset-lbl" for="cf_'+esc(k)+'">'+esc(k)+'</label></span>'+
            '<span class="bset-ctl"><input type="text" id="cf_'+esc(k)+'" data-need="'+esc(k)+'" autocomplete="off" spellcheck="false" dir="ltr"></span></div>';
        }).join('')+
        '<div class="bset-foot"><button class="btn pri" id="cfSave" type="button">חיבור</button>'+
        (m.help_url?'<a class="btn" href="'+esc(m.help_url)+'" target="_blank" rel="noopener">עזרה</a>':'')+
        '<span class="bset-state" id="cfState"></span></div></div>';
      $('#cfSave').onclick=function(){ submitConnect(m); };
    }
    function submitConnect(m){
      var label=($('#cf_label')&&$('#cf_label').value||'').trim();
      var secret={},missing=null;
      (m.needs||[]).forEach(function(k){
        var el=document.getElementById('cf_'+k), v=(el&&el.value||'').trim();
        if(!v){ if(!missing)missing=k; return; }
        secret[k]=v;
      });
      var st=$('#cfState');
      if(!label){ if(st){st.classList.add('bad');st.textContent='נדרש שם לתצוגה';} return; }
      if(missing){ if(st){st.classList.add('bad');st.textContent='נדרש '+missing;} return; }
      var btn=$('#cfSave'); btn.disabled=true; btn.style.opacity='.55';
      if(st){ st.classList.remove('bad'); st.textContent='מחבר…'; }
      post('/account/add',{protocol:m.protocol,label:label,secret:secret}).then(function(r){
        if(!r.ok){
          btn.disabled=false; btn.style.opacity='1';
          if(st){ st.classList.add('bad'); st.textContent=(r.d&&r.d.error)||('החיבור נכשל ('+r.status+')'); }
          return;
        }
        var id=r.d&&r.d.id;
        if(st){ st.textContent='בודק את החיבור…'; }
        // Added is not the same as WORKING. The service can verify one connection without selecting
        // it (api/account/:id/probe), so a token that will 401 on its first message says so NOW —
        // while the operator is still looking at the field they typed it into.
        return jx('/account/'+encodeURIComponent(id)+'/probe').then(function(pr){
          closeModal();
          var ok=pr.ok&&pr.d&&pr.d.ok;
          tell(ok?('החיבור «'+label+'» נוסף ונבדק'):('החיבור «'+label+'» נוסף — אך הבדיקה נכשלה: '+((pr.d&&pr.d.reason)||'')),!ok);
          return window.__chatReload();
        });
      });
    }
    /* The app runs inside the console's frame. Same origin, so the hash can be set directly; if it is
       ever embedded cross-origin the access throws and a new tab is the honest fallback. */
    function gotoConnections(){
      try{ if(window.top&&window.top!==window){ window.top.location.hash='#/m/connections'; return; } }catch(e){}
      window.open('/#/m/connections','_blank','noopener');
    }

    /* ── tools · what the /admin dashboard used to be ──────────────────────────────
       The dashboard was a second surface for the same service, and the simulation has no such thing:
       accounts, bots, conversations AND subscribers are one app. So its four sections came here.
       #connect and #settings already had homes (the switcher, and the per-connection bot panel).
       What was left is below, and each piece says which layer answers it:

         · ייצוא שיחות   ABSTRACT — GET api/export/conversations goes through the adapter contract, so
                         it works on local chat, WhatsApp and Telegram alike. It replaces the
                         dashboard's api/wa-archive/* view, which could only ever read the WhatsApp
                         SQLite archive.
         · תפוצה         ABSTRACT — POST api/broadcast fans out over CONVERSATIONS, which every
                         backend has.
         · משתמשים       WHATSAPP-ONLY, and labelled as such. "Subscriber" is a concept of the
                         WhatsApp bot's own store (src/data/subscribers); there is no canonical op
                         behind it, and n8n reads it. Relocating the screen without pretending the
                         data is cross-backend is the honest move.
         · שליחת מסמך    WHATSAPP-ONLY. Sending to a PHONE NUMBER that has no conversation has no
                         canonical equivalent — the contract addresses conversations, not addresses.
                         The legacy route stays (n8n's "WhatsApp Send Document" workflow posts to it)
                         and so does this form, rather than deleting a capability to look tidy. */
    var TOOLS={subs:[],loaded:false};
    function openTools(){
      modal('כלים וייצוא',
        '<div class="tool-sec"><div class="mlbl">ייצוא שיחות · החיבור הפעיל</div>'+
          '<div class="bcard"><h4>'+esc((S.activeAcct&&S.activeAcct.label)||'—')+'</h4>'+
          '<p>כל השיחות וההודעות של החיבור הפעיל, כפי שהשירות רואה אותן. עובד על כל סוג חיבור — '+
          'צ׳אט מקומי, וואטסאפ וטלגרם — כי הייצוא עובר דרך אותה שכבת פעולות שהאפליקציה משתמשת בה.</p>'+
          '<div class="bset-foot"><button class="btn pri" id="tExpCsv" type="button">ייצוא CSV</button>'+
          '<button class="btn" id="tExpJson" type="button">ייצוא JSON</button>'+
          '<span class="bset-state">'+esc(S.convs.length+' שיחות')+'</span></div></div></div>'+

        '<div class="tool-sec"><div class="mlbl">הודעת תפוצה</div>'+
          '<div class="bcard"><p>אותה הודעה לכל השיחות בחיבור הפעיל. נשלחת דרך שכבת הפעולות, '+
          'ולכן פועלת גם בטלגרם ובצ׳אט המקומי.</p>'+
          '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="tBcast">תוכן ההודעה</label>'+
          '<span class="bset-hint">תישלח לכל '+esc(S.convs.length)+' השיחות ברשימה.</span></span></div>'+
          '<textarea id="tBcast" rows="3" style="width:100%;resize:vertical;padding:9px 11px;border:1px solid var(--line);border-radius:10px;font:inherit;font-size:13px;background:var(--surface);color:var(--ink)"></textarea>'+
          '<div class="bset-foot"><button class="btn pri" id="tBcastGo" type="button">שליחה לכולם</button>'+
          '<span class="bset-state" id="tBcastState"></span></div></div></div>'+

        '<div class="tool-sec"><div class="mlbl">משתמשי הבוט · וואטסאפ בלבד</div>'+
          '<div class="bcard"><p>מי שכתב לבוט הוואטסאפ. זהו מאגר של הבוט עצמו ולא של החיבור הפעיל, '+
          'ולכן הוא אינו משתנה כשמחליפים חיבור.</p>'+
          '<div id="tUsers"><div class="acct-empty">טוען משתמשים…</div></div>'+
          '<div class="bset-foot"><button class="btn pri" id="tUsrExp" type="button">ייצוא רשימה</button>'+
          '<button class="btn" id="tUsrRestore" type="button">שחזור מגיבוי</button>'+
          '<button class="btn danger" id="tUsrDel" type="button">מחיקת כל המשתמשים</button>'+
          '<input type="file" id="tUsrFile" accept=".json" style="display:none">'+
          '<span class="bset-state" id="tUsrState"></span></div></div></div>'+

        '<div class="tool-sec"><div class="mlbl">שליחת מסמך למספר · וואטסאפ בלבד</div>'+
          '<div class="bcard"><p>שליחה למספר טלפון שאין לו שיחה פתוחה. אין לזה מקבילה בשכבת הפעולות '+
          '(היא מכירה שיחות, לא כתובות), ולכן זה עובר במסלול הוואטסאפ הישיר — אותו מסלול ש-n8n משתמש בו.</p>'+
          '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="tDocTo">מספר טלפון</label>'+
            '<span class="bset-hint">לדוגמה 050-000-0007</span></span>'+
            '<span class="bset-ctl"><input type="text" id="tDocTo" dir="ltr" inputmode="tel"></span></div>'+
          '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="tDocCap">כיתוב</label></span>'+
            '<span class="bset-ctl"><input type="text" id="tDocCap"></span></div>'+
          '<div class="bset-foot"><input type="file" id="tDocFile" accept="application/pdf">'+
          '<button class="btn pri" id="tDocGo" type="button">שליחה</button>'+
          '<span class="bset-state" id="tDocState"></span></div></div></div>',
        [{label:'סגירה',pri:true,onclick:closeModal}]);

      var conn=(S.active?('&connection_id='+encodeURIComponent(S.active)):'');
      $('#tExpCsv').onclick=function(){ download('/export/conversations?format=csv'+conn); tell('הייצוא ירד כקובץ CSV'); };
      $('#tExpJson').onclick=function(){ download('/export/conversations?format=json'+conn); tell('הייצוא ירד כקובץ JSON'); };
      $('#tBcastGo').onclick=doBroadcast;
      $('#tUsrExp').onclick=function(){ download('/subscribers/backup'); tell('רשימת המשתמשים ירדה'); };
      $('#tUsrRestore').onclick=function(){ $('#tUsrFile').click(); };
      $('#tUsrFile').onchange=doRestore;
      $('#tUsrDel').onclick=confirmDeleteUsers;
      $('#tDocGo').onclick=doSendDoc;
      loadSubscribers();
    }
    function loadSubscribers(){
      jx('/subscribers').then(function(r){
        var host=$('#tUsers'); if(!host)return;
        if(!r.ok){ host.innerHTML='<div class="note">לא ניתן לטעון את המשתמשים: '+esc((r.d&&r.d.error)||('שגיאה '+r.status))+'</div>'; return; }
        var list=Array.isArray(r.d)?r.d:((r.d&&r.d.subscribers)||[]);
        TOOLS.subs=list; TOOLS.loaded=true;
        var st=$('#tUsrState'); if(st)st.textContent='סה״כ '+list.length;
        if(!list.length){ host.innerHTML='<div class="acct-empty">אין משתמשים רשומים</div>'; return; }
        // The first 100 only, and it SAYS so — a silently truncated list reads as "that is everyone",
        // and the export below is the surface that hands over all of them.
        var show=list.slice(0,100);
        host.innerHTML='<div class="uwrap"><table class="utab"><thead><tr>'+
          '<th>שם</th><th>מספר</th><th>אינטראקציה אחרונה</th></tr></thead><tbody>'+
          show.map(function(u){
            var t=u.lastInteraction||u.updatedAt||u.createdAt;
            var when=t?new Date(t).toLocaleString('he-IL'):'לא זמין';
            return '<tr><td>'+esc(u.fullName||u.name||'לא זמין')+'</td>'+
              '<td class="ltr">'+esc(u.phoneNumber||'')+'</td><td>'+esc(when)+'</td></tr>';
          }).join('')+'</tbody></table></div>'+
          (list.length>show.length?'<div class="note">מוצגים '+show.length+' מתוך '+list.length+' — הייצוא כולל את כולם.</div>':'');
      });
    }
    function doBroadcast(){
      var ta=$('#tBcast'),st=$('#tBcastState'); if(!ta)return;
      var text=ta.value.trim(),d;
      if(!text){ st.classList.add('bad'); st.textContent='ההודעה ריקה'; return; }
      if(!S.convs.length){ st.classList.add('bad'); st.textContent='אין שיחות בחיבור הזה'; return; }
      st.classList.remove('bad'); st.textContent='';
      /* `to:'all'` is typed here rather than defaulted by the service — a broadcast that goes out
         because a field was omitted cannot be taken back. Nor can one that goes out on one press: it is
         asked first, with what will be sent and to how many. A partial send (207) is an answer, not a
         refusal — some of it went out — so it closes the question and is said on the screen. */
      binaAsk({danger:true,ok:'שליחה לכולם',title:'לשלוח את ההודעה לכל השיחות?',
        body:'הודעה שנשלחה אי אפשר להחזיר.',
        facts:[['חיבור',(S.activeAcct&&S.activeAcct.label)||'—'],['שיחות',String(S.convs.length)],
               ['הודעה',text.length>140?text.slice(0,140)+'…':text]],
        run:function(){ return post('/broadcast',{text:text,to:'all'}).then(function(r){
          d=r.d||{}; d.partial=r.status===207;
          if(!r.ok) throw new Error(d.error||'התפוצה נכשלה'); }); }
      }).then(function(ok){
        if(!ok)return;
        if(d.partial){ st.classList.add('bad'); st.textContent='נשלחו '+d.sent+', נכשלו '+d.failed; return tell('תפוצה חלקית: '+d.failed+' נכשלו',true); }
        st.textContent='נשלחו '+d.sent; ta.value=''; tell('ההודעה נשלחה ל-'+d.sent+' שיחות'); loadConvs();
      });
    }
    function doRestore(e){
      var f=e.target.files&&e.target.files[0]; if(!f)return;
      var fd=new FormData(); fd.append('backupFile',f);
      var st=$('#tUsrState'); st.classList.remove('bad'); st.textContent='משחזר…';
      // No Content-Type header: the browser has to set the multipart boundary itself.
      api('/subscribers/restore',{method:'POST',body:fd}).then(function(r){
        e.target.value='';
        if(!r.ok){ st.classList.add('bad'); st.textContent='השחזור נכשל ('+r.status+')'; return tell('השחזור נכשל',true); }
        tell('הרשימה שוחזרה'); loadSubscribers();
      },function(){ st.classList.add('bad'); st.textContent='השחזור נכשל'; });
    }
    /* Every user at once, and no way back: the one question here that also asks for its words to be typed -
       the office's way for an act of that size (the vault's «מחק הכל» is the other). */
    function confirmDeleteUsers(){
      binaAsk({danger:true,ok:'מחיקה',title:'למחוק את כל המשתמשים?',
        body:'הפעולה מוחקת את כל רשומות המשתמשים של בוט הוואטסאפ ואי אפשר לבטל אותה. מומלץ לייצא את הרשימה לפני כן.',
        facts:[['משתמשים',String(TOOLS.subs.length)]],
        input:{label:'להמשך, הקלד: מחק הכל',must:'מחק הכל'},
        run:function(){ return must(del('/subscribers'),'המחיקה נכשלה'); }
      }).then(function(v){ if(v!=null){ tell('כל המשתמשים נמחקו'); loadSubscribers(); } });
    }
    function doSendDoc(){
      var to=($('#tDocTo').value||'').trim(),cap=($('#tDocCap').value||'').trim();
      var f=$('#tDocFile').files&&$('#tDocFile').files[0];
      var st=$('#tDocState'); st.classList.remove('bad');
      if(!to){ st.classList.add('bad'); st.textContent='נדרש מספר טלפון'; return; }
      if(!f){ st.classList.add('bad'); st.textContent='נדרש קובץ'; return; }
      var fd=new FormData(); fd.append('document',f); fd.append('phoneNumber',to); fd.append('caption',cap);
      var btn=$('#tDocGo'); btn.disabled=true; btn.style.opacity='.55'; st.textContent='שולח…';
      api('/bot/send-document',{method:'POST',body:fd}).then(function(res){
        btn.disabled=false; btn.style.opacity='1';
        return res.json().then(function(d){return {ok:res.ok,d:d||{}};},function(){return {ok:res.ok,d:{}};});
      }).then(function(r){
        // The WhatsApp route answers a refusal with {success:false} and a 400 — the BODY is the
        // verdict, exactly as it is for a conversation send.
        if(!r.ok||r.d.success===false){ st.classList.add('bad'); st.textContent=r.d.message||r.d.error||'השליחה נכשלה'; return tell('השליחה נכשלה',true); }
        st.textContent='נשלח'; tell('המסמך נשלח אל '+to);
      },function(){ btn.disabled=false; btn.style.opacity='1'; st.classList.add('bad'); st.textContent='השליחה נכשלה'; });
    }

    /* ── the private chat engine · PROFILES ────────────────────────────────────────
       An ENGINE is software that moves messages; a PROFILE is an IDENTITY on one, holding a
       CREDENTIAL. On WhatsApp that credential comes from a paired device, on Telegram from a bot
       token — both minted somewhere else, which is exactly why you cannot CREATE an identity there:
       you pair, you register. The private engine is one we run, so we mint the credential ourselves.

       THIS SCREEN IS NOT THE CONNECT WIZARD, and that is deliberate: creating an identity and
       connecting to one are different acts. Creating a profile here mints its key AND its connection
       in the same operation, so the new identity appears in the switcher immediately — the separate
       "now go and connect it" step had no decision in it and is what made adding a user
       undiscoverable.

       WHAT CHANGED. This used to be a list of PEOPLE with an `operator` toggle, and the screen said
       out loud that it was not authentication: anyone who opened the app could pick any identity.
       Now every identity holds a minted API key; the engine resolves credential → profile, and a
       request carrying one profile's key cannot act as another. The screen is therefore offered only
       to a profile in the ADMIN ring, and the service — not this file — decides who that is. */
    var ENG={profiles:[],users:[],busy:false};
    /** Is this connection on the engine we run? The provider is the protocol with `chat_` stripped
     *  (chat_local -> local); both spellings are accepted for the same reason PROVIDERS accepts both. */
    function isLocalConn(a){ var p=(a&&a.provider)||''; return p==='local'||p==='chat_local'; }
    /** Offer profile management only where it is REAL (a private engine is bound) and PERMITTED (the
     *  acting profile is an admin). Both halves come from the service's own answer — /engine/whoami —
     *  so this cannot advertise a ring the engine will refuse. */
    function canAdminEngine(){ return !!(S.me&&S.me.is_admin&&isLocalConn(S.activeAcct)); }
    function engState(msg,bad){ var st=$('#engState'); if(!st)return; st.classList.toggle('bad',!!bad); st.textContent=msg||''; }

    /** THE KEY IS SHOWN ONCE. The service stores only its hash, so there is no route that can show it
     *  again — the screen has to say that plainly, or an operator closes the dialog and files a bug
     *  against a lookup that cannot exist. The honest recovery is a rotation, and it is named here. */
    function showKey(title,profileId,key){
      modal(title,
        '<div class="bcard"><h4>אישור הגישה של «'+esc(profileId)+'»</h4>'+
        '<p>המפתח מוצג <b>פעם אחת בלבד</b>. השירות שומר רק את הטביעה שלו, ולכן אין מסך שיציג אותו שוב. '+
        'העתק אותו עכשיו. אם אבד — מחליפים אותו (החלפת מפתח), וכל לקוח שמחזיק את הישן יפסיק לעבוד.</p>'+
        '<div class="bset-row"><span class="bset-ctl" style="flex:1">'+
          '<input type="text" id="engKeyOut" dir="ltr" readonly value="'+esc(key)+'" style="width:100%">'+
        '</span></div>'+
        '<p>המפתח נשמר גם במאגר החיבורים של הפלטפורמה, ומשם אוטומציות יכולות למשוך אותו.</p></div>',
        [{label:'העתקה',pri:true,onclick:function(){
          var el=$('#engKeyOut'); if(!el)return;
          el.select();
          var done=function(){ tell('המפתח הועתק'); };
          if(navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(key).then(done,function(){ tell('ההעתקה נכשלה — סמן והעתק ידנית',true); });
          else { try{ document.execCommand('copy'); done(); }catch(e){ tell('ההעתקה נכשלה — סמן והעתק ידנית',true); } }
        }},{label:'סגירה',onclick:function(){ closeModal(); openEngine(); }}]);
    }

    function openEngine(){
      ENG={profiles:[],users:[],busy:false};
      modal('פרופילים במנוע הפנימי',
        '<div class="note">המסך הזה מנהל <b>זהויות</b> על המנוע שאנחנו מפעילים — כל אחת עם אישור גישה משלה. '+
          'רשימת החיבורים בוחרת באיזו זהות פועלים; כאן קובעים מי בכלל קיים.</div>'+
        '<div class="mlbl" id="engLbl">פרופילים</div>'+
        '<div class="uwrap englist" id="engList"><div class="acct-empty">טוען פרופילים…</div></div>'+
        '<div class="note">כל בקשה למנוע הפנימי מזוהה מול פרופיל. בקשה שמחזיקה את המפתח של פרופיל אחד '+
          'אינה יכולה לפעול בשם אחר, והמנהל האחרון אינו ניתן להורדה, להשהיה או למחיקה — אחרת אין דרך חזרה.</div>'+

        '<div class="bcard"><h4>פרופיל חדש</h4>'+
        '<p>יצירת פרופיל מייצרת גם את אישור הגישה שלו וגם את החיבור שלו — בפעולה אחת. '+
        'הזהות תופיע מיד ברשימת החיבורים.</p>'+
        '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="engName">שם</label>'+
          '<span class="bset-hint">כך הפרופיל יופיע ברשימת החיבורים ובשיחות.</span></span>'+
          '<span class="bset-ctl"><input type="text" id="engName" maxlength="60" autocomplete="off"></span></div>'+
        '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="engId">מזהה</label>'+
          '<span class="bset-hint">אותיות קטנות, ספרות, מקף וקו תחתון.</span></span>'+
          '<span class="bset-ctl"><input type="text" id="engId" dir="ltr" autocomplete="off" spellcheck="false"></span></div>'+
        '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="engAdminNew">מנהל</label>'+
          '<span class="bset-hint">מנהל יכול ליצור, לערוך, להשהות ולמחוק פרופילים אחרים.</span></span>'+
          '<span class="bset-ctl"><label class="sw"><input type="checkbox" id="engAdminNew"><i></i></label></span></div>'+
        '<div class="bset-foot"><button class="btn pri" id="engAdd" type="button">יצירת פרופיל</button>'+
        '<span class="bset-state" id="engState"></span></div></div>'+

        '<div class="mlbl">אנשי קשר</div>'+
        '<div class="note">איש קשר הוא מישהו <b>לדבר איתו</b>, לא מישהו <b>להיות</b>. אין לו אישור גישה '+
          'ואי אפשר לפעול בשמו.</div>'+
        '<div class="uwrap englist" id="engContacts"><div class="acct-empty">טוען…</div></div>'+
        '<div class="bcard"><h4>איש קשר חדש</h4>'+
        '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="cName">שם</label></span>'+
          '<span class="bset-ctl"><input type="text" id="cName" maxlength="60" autocomplete="off"></span></div>'+
        '<div class="bset-row"><span class="bset-x"><label class="bset-lbl" for="cHandle">כינוי (לא חובה)</label>'+
          '<span class="bset-hint">שורת המשנה ליד השם — תפקיד, מחלקה או תיאור קצר.</span></span>'+
          '<span class="bset-ctl"><input type="text" id="cHandle" maxlength="60" autocomplete="off"></span></div>'+
        '<div class="bset-foot"><button class="btn" id="cAdd" type="button">הוספת איש קשר</button>'+
        '<span class="bset-state" id="cState"></span></div></div>',
        [{label:'סגירה',pri:true,onclick:closeModal}]);
      $('#engAdd').onclick=createProfile;
      $('#cAdd').onclick=createContact;
      loadEngine();
    }

    function loadEngine(){
      return Promise.all([jx('/engine/profiles'),jx('/engine/users')]).then(function(r){
        var host=$('#engList');
        // A 403 here is the ADMIN RING refusing, which is a different fact from a broken engine and
        // must read as one. The service's own sentence goes on screen either way.
        if(host){
          if(!r[0].ok||(r[0].d&&r[0].d.ok===false)){
            ENG.profiles=[];
            host.innerHTML='<div class="note">'+esc((r[0].d&&r[0].d.error)||('לא ניתן לטעון פרופילים ('+r[0].status+')'))+'</div>';
          } else {
            ENG.profiles=(r[0].d&&r[0].d.profiles)||[];
            renderProfiles();
          }
        }
        var ch=$('#engContacts');
        if(ch){
          if(!r[1].ok||(r[1].d&&r[1].d.ok===false)){
            ENG.users=[];
            ch.innerHTML='<div class="note">'+esc((r[1].d&&r[1].d.error)||('לא ניתן לטעון אנשי קשר ('+r[1].status+')'))+'</div>';
          } else {
            ENG.users=((r[1].d&&r[1].d.users)||[]).filter(function(u){return !u.profile;});
            renderContacts();
          }
        }
      });
    }

    function renderProfiles(){
      var host=$('#engList'); if(!host)return;
      var lbl=$('#engLbl');
      var admins=ENG.profiles.filter(function(p){return p.is_admin&&p.status==='active';});
      if(lbl) lbl.textContent='פרופילים · '+ENG.profiles.length+' סה״כ, '+admins.length+' מנהלים';
      if(!ENG.profiles.length){ host.innerHTML='<div class="acct-empty">אין פרופילים במנוע</div>'; return; }
      var meId=(S.me&&S.me.profile&&S.me.profile.id)||null;
      host.innerHTML=ENG.profiles.map(function(p){
        // The LAST admin is the one control this screen must refuse, and it says why on the control
        // itself rather than only after the click — a disabled button with no reason is a bug report.
        var last=p.is_admin&&p.status==='active'&&admins.length<=1;
        var mine=p.id===meId;
        // The connection id is shown because it is what the switcher, the bot attachment and any
        // automation are keyed by — "where do I find this identity" should not need explaining.
        var sub='<span dir="ltr">'+esc(p.id)+'</span>'+
          (p.instance_id?' · <span dir="ltr">'+esc(p.instance_id)+'</span>':' · <b>ממתין לחיבור</b>');
        return '<div class="brow" data-pid="'+esc(p.id)+'">'+
          '<span class="avatar"><span class="av sm" style="background:'+esc(colorFor(p.id))+'">'+
            esc(initialsOf(p.display_name||p.id))+'</span></span>'+
          '<span class="bx"><span class="bn">'+esc(p.display_name||p.id)+(mine?' · אני':'')+'</span>'+
            '<span class="bs">'+sub+'</span></span>'+
          '<span class="cap'+(p.is_admin?' on':'')+'">'+(p.is_admin?'מנהל':'פרופיל')+'</span>'+
          (p.status==='active'?'':'<span class="cap">מושהה</span>')+
          '<button class="btn sm" data-act="key" data-pid="'+esc(p.id)+'" title="החלפת אישור הגישה. כל לקוח שמחזיק את הישן יפסיק לעבוד.">מפתח</button>'+
          '<button class="btn sm" data-act="admin" data-pid="'+esc(p.id)+'"'+(last?' disabled title="זהו המנהל האחרון — הורדתו תשאיר את המנוע בלי אף אחד שיכול לנהל פרופילים"':'')+'>'+
            (p.is_admin?'הורדה ממנהל':'הפיכה למנהל')+'</button>'+
          '<button class="btn sm" data-act="susp" data-pid="'+esc(p.id)+'"'+(last?' disabled title="זהו המנהל האחרון — אי אפשר להשהות אותו"':'')+'>'+
            (p.status==='active'?'השהיה':'הפעלה')+'</button>'+
          '<button class="btn sm" data-act="del" data-pid="'+esc(p.id)+'"'+(last?' disabled title="זהו המנהל האחרון — אי אפשר למחוק אותו"':'')+'>הסרה</button>'+
        '</div>';
      }).join('');
      host.querySelectorAll('button[data-act]').forEach(function(el){
        el.onclick=function(){ profileAction(el.getAttribute('data-act'),el.getAttribute('data-pid')); };
      });
    }

    function renderContacts(){
      var ch=$('#engContacts'); if(!ch)return;
      if(!ENG.users.length){ ch.innerHTML='<div class="acct-empty">אין אנשי קשר</div>'; return; }
      ch.innerHTML=ENG.users.map(function(u){
        return '<div class="brow">'+
          '<span class="avatar"><span class="av sm" style="background:'+esc(u.color||colorFor(u.id))+'">'+
            esc(initialsOf(u.name||u.id))+'</span></span>'+
          '<span class="bx"><span class="bn">'+esc(u.name||u.id)+'</span>'+
            '<span class="bs">'+(u.handle?esc(u.handle)+' · ':'')+'<span dir="ltr">'+esc(u.id)+'</span></span></span>'+
          '<span class="cap">איש קשר</span></div>';
      }).join('');
    }

    /** Deterministic avatar colour, matching the server's palette so an identity keeps one colour. */
    function colorFor(key){
      var P=['sky-d','violet','lime-d','olive-d','plum-d','muted'].map(function(n){return 'var(--'+n+')';}),h=0,i;   // the palette's line steps, in the server's order
      for(i=0;i<String(key||'').length;i++) h=(h*31+String(key).charCodeAt(i))>>>0;
      return P[h%P.length];
    }

    /**
     * One profile operation. The list is ALWAYS re-read afterwards — including on failure, so a
     * refused change snaps back to what the service actually holds rather than staying where the
     * finger left it — and boot() re-reads the connections, because creating or removing a profile
     * adds or removes a row from the switcher.
     */
    function profileAction(act,pid){
      if(ENG.busy||!pid)return;
      var p=ENG.profiles.filter(function(x){return x.id===pid;})[0]||{},name=p.display_name||pid,d;
      var at='/engine/profiles/'+encodeURIComponent(pid);
      var patch=function(body){ return jx(at,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); };
      /* The request: its answer kept for `done`, or the service's refusal thrown — for the question to
         say where one was asked, for the screen's own line where the change is a plain switch. */
      var run=function(){
        ENG.busy=true; engState('מעדכן…');
        return must(act==='key'?post(at+'/key',{}):act==='admin'?patch({is_admin:!p.is_admin})
            :act==='susp'?patch({status:p.status==='active'?'suspended':'active'}):del(at),'הפעולה נכשלה')
          .then(function(r){ ENG.busy=false; d=r.d||{}; },function(e){ ENG.busy=false; engState(''); throw e; });
      };
      var done=function(){
        if(act==='key'){
          // Reload BEFORE showing the key: the dialog replaces this one, and its "close" reopens
          // the screen — which must already reflect the rotation.
          return loadEngine().then(boot).then(function(){ showKey('אישור גישה חדש',pid,d.key); });
        }
        engState(act==='del'?('«'+pid+'» הוסר — ההיסטוריה שלו נשמרה'):('«'+pid+'» עודכן'));
        tell(act==='del'?('הפרופיל «'+pid+'» הוסר'):('הפרופיל «'+pid+'» עודכן'));
        return loadEngine().then(function(){ return boot(); });
      };
      // Deleting a profile removes ACCESS, never data — and saying so is the difference between a
      // confirmation an operator can answer and one they have to guess at.
      var ask=act==='del'?{ok:'הסרה',title:'להסיר את הפרופיל «'+name+'»?',
          body:'אישור הגישה שלו יבוטל והחיבור שלו יוסר מהרשימה. ההיסטוריה נשמרת — ההודעות ששלח והשיחות שהוא חבר בהן נשארות במקומן.'}
        :act==='key'?{ok:'החלפה',title:'להחליף את אישור הגישה של «'+name+'»?',
          body:'המפתח הקיים יפסיק לעבוד מיד. כל אוטומציה שמחזיקה אותו תצטרך למשוך את החדש ממאגר החיבורים, או לקבל אותו מהמסך הבא.'}
        :null;
      if(!ask) return run().then(done,function(e){ engState(e.message,true); tell(e.message,true); return loadEngine(); });
      ask.danger=true; ask.facts=[['מזהה',pid]]; ask.run=run;
      // Asked over the open screen, whose list is re-read whichever way the question ends: a refusal can
      // mean the screen was showing what is no longer so.
      return binaAsk(ask).then(function(ok){ return ok?done():loadEngine(); });
    }

    function createProfile(){
      if(ENG.busy)return;
      var ni=$('#engName'),ii=$('#engId'),ai=$('#engAdminNew');
      var name=((ni&&ni.value)||'').trim(),id=((ii&&ii.value)||'').trim().toLowerCase();
      // The service refuses a nameless or badly-named profile with its own 400; this only saves the
      // round-trip, and every other rule (charset, duplicates) stays the service's call, in its words.
      if(!name){ engState('נדרש שם',true); if(ni)ni.focus(); return; }
      if(!id){ engState('נדרש מזהה',true); if(ii)ii.focus(); return; }
      ENG.busy=true;
      var b=$('#engAdd'); b.disabled=true; b.style.opacity='.55';
      engState('יוצר…');
      post('/engine/profiles',{id:id,display_name:name,is_admin:!!(ai&&ai.checked)}).then(function(r){
        ENG.busy=false; b.disabled=false; b.style.opacity='1';
        var d=r.d||{};
        if(!r.ok||d.ok===false){
          var m=d.error||('היצירה נכשלה ('+r.status+')');
          engState(m,true); return tell(m,true);
        }
        if(ni)ni.value=''; if(ii)ii.value=''; if(ai)ai.checked=false;
        tell('הפרופיל «'+name+'» נוצר');
        return loadEngine().then(boot).then(function(){ showKey('הפרופיל נוצר',id,d.key); });
      });
    }

    function createContact(){
      if(ENG.busy)return;
      var ni=$('#cName'),hi=$('#cHandle'),st=$('#cState');
      var name=((ni&&ni.value)||'').trim(),handle=((hi&&hi.value)||'').trim();
      var say=function(m,bad){ if(st){ st.classList.toggle('bad',!!bad); st.textContent=m||''; } };
      if(!name){ say('נדרש שם',true); if(ni)ni.focus(); return; }
      ENG.busy=true; say('מוסיף…');
      var body={name:name}; if(handle)body.handle=handle;
      post('/engine/users',body).then(function(r){
        ENG.busy=false;
        var d=r.d||{};
        if(!r.ok||d.ok===false){ var m=d.error||('ההוספה נכשלה ('+r.status+')'); say(m,true); return tell(m,true); }
        if(ni)ni.value=''; if(hi)hi.value='';
        say('נוסף «'+(d.name||name)+'» כאיש קשר');
        tell('איש הקשר «'+(d.name||name)+'» נוסף');
        return loadEngine();
      });
    }

    /* conversation list */
    function filtered(){
      var arr=S.convs.slice();
      if(S.filter==='unread')arr=arr.filter(function(c){return c.unread>0;});
      else if(S.filter==='group')arr=arr.filter(function(c){return c.group;});
      if(S.q){var q=S.q.toLowerCase();arr=arr.filter(function(c){return (c.name+' '+c.last+' '+(c.handle||'')).toLowerCase().indexOf(q)>=0;});}
      return arr;
    }
    function counts(){var c={all:S.convs.length,unread:0,group:0};S.convs.forEach(function(x){if(x.unread>0)c.unread++;if(x.group)c.group++;});return c;}
    function renderList(){
      var c=counts(); Object.keys(c).forEach(function(k){var el=document.querySelector('[data-c="'+k+'"]');if(el)el.textContent=c[k];});
      $('#convCount').textContent=S.convs.length;
      var arr=filtered(),host=$('#convList');
      // an errored account has no conversations — on mobile the thread pane is hidden, so surface the
      // failure + reconnect right here in the list (otherwise the user sees a blank "no chats" and is stuck).
      if(!arr.length && S.activeAcct && S.activeAcct.status==='error'){
        host.innerHTML='<div class="list-err"><div class="le-ic"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg></div>'+
          '<b>החיבור נכשל</b><span>'+esc(S.activeAcct.reason||'החשבון אינו זמין כרגע.')+'</span>'+
          '<button class="le-btn" id="reconBtnL"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/></svg>חבר מחדש</button></div>';
        wireReconnect($('#reconBtnL'));
        return;
      }
      if(!arr.length){host.innerHTML='<div class="list-empty">'+(S.convs.length?'אין שיחות תואמות':'אין שיחות בחיבור זה עדיין')+'</div>';return;}
      host.innerHTML=arr.map(function(c){
        var pin=c.pinned?'<svg class="pin" viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M16 3v2l-1 1v4l2 2v2h-4v5l-1 1-1-1v-5H6v-2l2-2V6L7 5V3z"/></svg>':'';
        var badge=c.unread>0?'<span class="badge">'+c.unread+'</span>':'';
        var pres=c.online?'<span class="presence"></span>':'';
        var lead=c.lastDir==='out'?tickHtml(c.lastStatus==='sent'||c.lastStatus==='read'?c.lastStatus:'delivered'):'';
        return '<div class="conv'+(c.id===S.openId?' on':'')+(c.unread>0?' unread':'')+'" data-id="'+esc(c.id)+'" role="listitem" tabindex="0" aria-label="'+esc(c.name)+(c.unread>0?(', '+(c.unread===1?'אחת חדשה':c.unread+' חדשות')):'')+'">'+
          '<span class="avatar"><span class="av" style="background:'+c.color+'">'+esc(c.initials)+'</span>'+pres+'</span>'+
