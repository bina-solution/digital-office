    function renderThread(data){
      var ct=data.contact||{}; S.openContact=ct;
      $('#thread').innerHTML=
        '<div class="th-head"><button class="th-back" title="חזרה"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button><span class="avatar"><span class="av sm" style="background:'+(ct.color||'var(--muted)')+'">'+esc(ct.initials||'?')+'</span>'+((S.convs.filter(function(x){return x.id===data.id;})[0]||{}).online?'<span class="presence"></span>':'')+'</span>'+
          '<span class="cx"><div class="nm">'+esc(ct.name||'')+tagHtml(ct.tag)+'</div><div class="hn'+((S.convs.filter(function(x){return x.id===data.id;})[0]||{}).online?' online':'')+'">'+((S.convs.filter(function(x){return x.id===data.id;})[0]||{}).online?'מחובר/ת עכשיו':esc(ct.handle||''))+'</div></span>'+
          '<span class="ha">'+
            '<button title="שיחת וידאו"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg></button>'+
            '<button title="חיפוש בשיחה"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></button>'+
            '<button title="פרטים"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg></button>'+
          '</span></div>'+
        '<div class="msgs" id="msgs" role="log" aria-live="polite" aria-label="הודעות בשיחה"></div>'+
        '<div class="composer" id="composer">'+
          '<button class="ico" title="אמוג׳י"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg></button>'+
          '<button class="ico" title="צירוף קובץ"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 6.34l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg></button>'+
          '<div class="field"><textarea id="ta" rows="1" placeholder="הקלד/י הודעה…"></textarea></div>'+
          '<button class="send" id="sendBtn" title="שליחה"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></button>'+
        '</div>';
      var m=$('#msgs'); m.innerHTML=msgsHtml(data.messages||[], ct.group); renderBotnote(); m.scrollTop=m.scrollHeight;
      S.threadSig=threadSig(data.messages);
      // THE PAPERCLIP. It was decoration: the button has been rendered since this client was ported
      // from the sim, with no handler and no file input behind it, so attaching a file was a control
      // that silently did nothing. The input is created on demand rather than living in the markup,
      // so there is exactly one per composer render and no stale reference after a thread switch.
      var att=$('#composer .ico[title="צירוף קובץ"]');
      if(att) att.onclick=function(){
        var fi=document.createElement('input');
        fi.type='file'; fi.style.display='none';
        fi.onchange=function(){
          var f=fi.files&&fi.files[0]; if(!f||!S.openId) return;
          var fd=new FormData(); fd.append('file',f); fd.append('text',($('#ta')&&$('#ta').value)||'');
          if(S.active) fd.append('connection_id',S.active);
          att.disabled=true;
          jf('/conversation/'+encodeURIComponent(S.openId)+'/attach',{method:'POST',body:fd})
            .then(function(d){
              // A write that did not happen never reports success: say so and KEEP the typed text,
              // so the operator can retry instead of wondering whether it went.
              if(!d||d.ok===false){ tell((d&&d.error)||'שליחת הקובץ נכשלה',true); return; }
              if($('#ta')) $('#ta').value='';
              refreshThread(); loadConvs();
            })
            .catch(function(e){ tell('שליחת הקובץ נכשלה: '+e.message,true); })
            .then(function(){ att.disabled=false; fi.remove(); });
        };
        document.body.appendChild(fi); fi.click();
      };
      var ta=$('#ta');
      ta.addEventListener('input',function(){ta.style.height='auto';ta.style.height=Math.min(120,ta.scrollHeight)+'px';});
      ta.addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();doSend();}});
      $('#sendBtn').onclick=doSend;
      var bk=$('.th-back'); if(bk)bk.onclick=mobBack;
      if(!mob())ta.focus();
    }
    function renderThreadState(){
      var a=S.activeAcct;
      if(a&&a.status==='error'){
        $('#thread').innerHTML='<div class="th-empty"><div class="big err"><svg viewBox="0 0 24 24" width="42" height="42" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg></div>'+
          '<h3>החיבור נכשל</h3><p>'+esc(a.reason||'החשבון אינו זמין כרגע.')+'</p>'+
          '<button class="newbtn" id="reconBtn" style="margin:2px 0 0;background:var(--plum);color:var(--plum-ink)"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/></svg>חבר מחדש</button></div>';
        wireReconnect($('#reconBtn'));
        return;
      }
      $('#thread').innerHTML='<div class="th-empty"><div class="big"><svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>'+
        '<h3>הצ׳אט העסקי שלך</h3><p>בחר/י שיחה מהרשימה כדי להתחיל, או חבר/י חשבון צ׳אט נוסף (וואטסאפ · טלגרם · מקומי) מהמתג שבראש הדף.</p></div>';
    }
    function doSend(){
      var ta=$('#ta'); if(!ta)return; var text=ta.value.trim(); if(!text||!S.openId)return;
      var m=$('#msgs'); var note=m.querySelector('.botnote'); if(note)note.remove();
      m.insertAdjacentHTML('beforeend',bubble({dir:'out',text:text,mins:0,status:'sent'}, !lastIsOut(m)));
      var optimistic=m.querySelectorAll('.msg.out'); optimistic=optimistic[optimistic.length-1];
      m.scrollTop=m.scrollHeight; ta.value=''; ta.style.height='auto';
      var c=S.convs.filter(function(x){return x.id===S.openId;})[0]; if(c){c.last=text;c.lastDir='out';c.lastStatus='sent';c.mins=0;} renderList();
      var convId=S.openId;
      // Marked pending BEFORE the write, because the push can beat the response back — see onChange.
      pendingAdd(convId);
      post('/conversation/'+encodeURIComponent(convId)+'/send',{text:text}).then(function(r){
        pendingDone(convId);
        var res=r.d||{};
        // A write that did not happen must never look like one that did. The local backend answers a
        // failed send with {ok:false,…} and a 200, so the body is checked, not only the status.
        if(!r.ok||res.error||res.ok===false){
          if(optimistic){ optimistic.style.opacity='.55'; var t=optimistic.querySelector('.mt'); if(t)t.innerHTML='לא נשלח'; }
          return tell(res.error||'שליחת ההודעה נכשלה',true);
        }
        // The server's copy is the truth (real id, real timestamp, real status) — take it on the next
        // poll rather than keeping the optimistic bubble forever.
        S.threadSig='';
        setTimeout(function(){var os=m.querySelectorAll('.msg.out');var last=os[os.length-1];if(last&&last===optimistic){var t=last.querySelector('.mt');if(t)t.innerHTML=clock(0)+tickHtml('sent');}},700);
        if(convId===S.openId) refreshThread();
        loadConvs();
        // The abstract API deliberately does NOT answer a send with a bot reply (chatapi/server.js:
        // bots answer INBOUND messages, not what the operator types). The branch is kept for backends
        // that do return one — it simply never fires against this service.
        if(res.reply){
          var tp=document.createElement('div'); tp.className='typing'; tp.innerHTML='<i></i><i></i><i></i>'; m.appendChild(tp); m.scrollTop=m.scrollHeight;
          setTimeout(function(){ tp.remove(); m.insertAdjacentHTML('beforeend',bubble(res.reply,true)); renderBotnote(); m.scrollTop=m.scrollHeight;
            if(c){c.last=res.reply.text;c.lastDir='in';c.mins=0;renderList();} },1100);
        }
      },function(){
        /* The REJECTION arm, not a .catch: a .catch here would also swallow (and mis-handle) an
           error thrown inside the success handler above, and would call pendingDone a second time.
           jx() already turns an ordinary network failure into a resolved {ok:false,status:0}, so
           this only fires on a genuine throw — but an entry left in _pending suppresses THIS
           conversation's inbound refresh forever (see onChange), so it must not depend on the happy
           path running. */
        pendingDone(convId);
      });
    }
    /* ── new conversation ──────────────────────────────────────────────────────────
       "שיחה חדשה" used to open the CONNECT flow, because at the time the service had no route that
       could open a conversation. It has two now (GET api/users, POST api/conversations) and they are
       optional per connection, which is what this screen is really about:

         · WHO can be talked to is the SERVICE's answer, never a guess here. The search box passes
           `q` to the backend instead of filtering a cached page, so the list obeys whatever the
           address book actually is — including one too large to have been sent in full.
         · The SHAPE is decided by which field goes on the wire: `user_id` is a direct chat, `title`
           is a group. `name` is deliberately NOT the switch — in the direct shape it is the peer's
           display name, and sending it alone would create a group named after a person.
         · A direct chat is IDEMPOTENT at the backend: `created:false` means the 1:1 already existed
           and was reused. That gets its own words, because "נוצרה שיחה" would be contradicted by a
           conversation count that did not move.
         · A 400 is shown in the SERVICE's words. It names the problem (self-DM, nameless group);
           replacing that with a generic failure throws away the only useful part of the answer. */
    var NC={users:[],q:'',mode:'direct',picked:{},token:0,busy:false};
    /** The users endpoint returns a USER, not a conversation, so there is no `initials` on it. Same
     *  rule the backend applies to conversations: two words -> two firsts, else the first two chars. */
    function initialsOf(name){
      var s=String(name||'').trim(); if(!s) return '??';
      var p=s.split(/\s+/).filter(Boolean);
      return p.length>=2 ? (p[0][0]+p[1][0]) : s.slice(0,2);
    }
    function ncState(msg,bad){ var st=$('#ncState'); if(!st)return; st.classList.toggle('bad',!!bad); st.textContent=msg||''; }
    function ncPicked(){ return Object.keys(NC.picked); }
    function ncPickedLabel(){ var n=ncPicked().length; return n?(n===1?'נבחר משתתף אחד':'נבחרו '+n+' משתתפים'):'בחר/י משתתפים לקבוצה'; }
    /** The connection this modal is about — pinned onto every call, so a switch mid-flow cannot make
     *  the picker list one connection's people and open the conversation on another. */
    function ncConn(){ return S.active||null; }

    function openNewChat(){
      // Defensive only — the button is disabled when this is false. A toast here means the manifest
      // changed under an already-open screen.
      if(!canStartChat()){ binaTell(noStartReason(),'warn'); return; }
      NC={users:[],q:'',mode:canCreateDirect()?'direct':'group',picked:{},token:0,busy:false};
      var tabs = (canCreateDirect()&&canCreateGroup())
        ? '<div class="segtabs" id="ncTabs">'+
            '<button class="seg on" data-nc="direct" type="button">שיחה אישית</button>'+
            '<button class="seg" data-nc="group" type="button">קבוצה חדשה</button></div>'
        : '';
      modal('שיחה חדשה',
        tabs+
        '<div class="bset-row hidden" id="ncTitleRow"><span class="bset-x">'+
          '<label class="bset-lbl" for="ncTitle">שם הקבוצה</label>'+
          '<span class="bset-hint">כך הקבוצה תופיע ברשימת השיחות.</span></span>'+
          '<span class="bset-ctl"><input type="text" id="ncTitle" maxlength="60"></span></div>'+
        '<div class="search"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>'+
          '<input id="ncQ" placeholder="חיפוש לפי שם או כינוי…" autocomplete="off"></div>'+
        '<div class="mlbl" id="ncLbl">אנשים</div>'+
        '<div class="uwrap nclist" id="ncList"><div class="acct-empty">טוען אנשים…</div></div>'+
        '<div class="bset-foot"><button class="btn pri hidden" id="ncGo" type="button">יצירת קבוצה</button>'+
          '<span class="bset-state" id="ncState"></span></div>',
        [{label:'סגירה',pri:true,onclick:closeModal}]);

      var tw=$('#ncTabs');
      if(tw) tw.querySelectorAll('.seg').forEach(function(el){
        el.onclick=function(){
          tw.querySelectorAll('.seg').forEach(function(x){x.classList.remove('on');});
          el.classList.add('on'); setNCMode(el.getAttribute('data-nc'));
        };
      });
      // The query goes to the SERVER (?q=), so it is debounced like the conversation search rather
      // than fired per keystroke.
      var deb; $('#ncQ').addEventListener('input',function(e){
        var v=e.target.value.trim(); clearTimeout(deb);
        deb=setTimeout(function(){ if(v===NC.q)return; NC.q=v; loadNCUsers(); },160);
      });
      $('#ncGo').onclick=createGroupChat;
      setNCMode(NC.mode);
      loadNCUsers();
    }
    function setNCMode(m){
      NC.mode=m;
      var grp=(m==='group');
      var tr=$('#ncTitleRow'),go=$('#ncGo'),lbl=$('#ncLbl');
      if(tr) tr.classList.toggle('hidden',!grp);
      if(go) go.classList.toggle('hidden',!grp);
      if(lbl) lbl.textContent=grp?'חברי הקבוצה':('אנשים בחיבור «'+connLabel(ncConn())+'»');
      if(!grp) NC.picked={};
      ncState(grp?ncPickedLabel():'בחירה באדם פותחת את השיחה מיד.');
      renderNCList();
    }
    function loadNCUsers(){
      var tk=++NC.token, cid=ncConn();
      var p='/users?limit=200'+(NC.q?('&q='+encodeURIComponent(NC.q)):'')+
            (cid?('&connection_id='+encodeURIComponent(cid)):'');
      jx(p).then(function(r){
        if(tk!==NC.token) return;                       // the operator kept typing — that answer is stale
        var host=$('#ncList'); if(!host)return;
        // A 501 here is not "the request failed", it is the connection saying it has no address book
        // to show. Either way the SERVICE's sentence is what goes on screen.
        if(!r.ok||(r.d&&r.d.ok===false)){
          NC.users=[];
          host.innerHTML='<div class="note">'+esc((r.d&&r.d.error)||('לא ניתן לטעון אנשי קשר ('+r.status+')'))+'</div>';
          return;
        }
        NC.users=(r.d&&r.d.users)||[];
        renderNCList();
      });
    }
    function renderNCList(){
      var host=$('#ncList'); if(!host)return;
      if(!NC.users.length){
        host.innerHTML='<div class="acct-empty">'+(NC.q?'אין אנשים תואמים לחיפוש':'אין אנשים זמינים בחיבור הזה')+'</div>';
        return;
      }
      host.innerHTML=NC.users.map(function(u){
        var on=NC.mode==='group'&&!!NC.picked[u.id];
        return '<div class="brow'+(on?' on':'')+'" data-uid="'+esc(u.id)+'" role="button" tabindex="0"'+
          ' aria-pressed="'+(on?'true':'false')+'">'+
          '<span class="avatar"><span class="av sm" style="background:'+esc(u.color||'var(--muted)')+'">'+
            esc(initialsOf(u.name||u.handle||u.id))+'</span>'+
            (u.online?'<span class="presence"></span>':'')+'</span>'+
          '<span class="bx"><span class="bn">'+esc(u.name||u.id)+'</span>'+
            '<span class="bs">'+esc(u.handle||'')+(u.online?(u.handle?' · ':'')+'מחובר/ת עכשיו':'')+'</span></span>'+
          '<span class="nc-check">'+mark('check')+'</span></div>';
      }).join('');
      host.querySelectorAll('.brow').forEach(function(row){
        var go=function(){ pickUser(row.getAttribute('data-uid')); };
        row.onclick=go;
        row.onkeydown=function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); go(); } };
      });
    }
    function pickUser(id){
      var u=NC.users.filter(function(x){return x.id===id;})[0]; if(!u)return;
      if(NC.mode==='group'){
        if(NC.picked[id]) delete NC.picked[id]; else NC.picked[id]=u;
        renderNCList(); ncState(ncPickedLabel());
        return;
      }
      startDirect(u);
    }
    function startDirect(u){
      if(NC.busy)return; NC.busy=true;
      var who=u.name||u.id;
      ncState('פותח שיחה עם «'+who+'»…');
      var body={user_id:u.id,name:u.name,handle:u.handle}, cid=ncConn();
      if(cid) body.connection_id=cid;
      post('/conversations',body).then(function(r){
        NC.busy=false;
        var d=r.d||{};
        if(!r.ok||d.ok===false||!d.id){
          var msg=d.error||('פתיחת השיחה נכשלה ('+r.status+')');
          ncState(msg,true); return tell(msg,true);
        }
        closeModal();
        // created:false = the 1:1 was already there and was reused. Saying "נוצרה" would be a claim
        // the conversation count immediately contradicts.
        tell(d.created===false?('השיחה עם «'+who+'» כבר קיימת — נפתחה'):('נפתחה שיחה עם «'+who+'»'));
        openAfterCreate(d.id);
      });
    }
    function createGroupChat(){
      if(NC.busy)return;
      var t=$('#ncTitle'), title=((t&&t.value)||'').trim();
      // The service refuses a nameless group with its own 400; this only saves the round-trip, and
      // everything else (membership, duplicates) stays the service's call.
      if(!title){ ncState('נדרש שם לקבוצה',true); if(t)t.focus(); return; }
      var members=ncPicked().map(function(k){
        var u=NC.picked[k]; return {id:u.id,name:u.name,handle:u.handle,color:u.color};
      });
      NC.busy=true; ncState('יוצר קבוצה…');
      var body={title:title,members:members}, cid=ncConn();
      if(cid) body.connection_id=cid;
      post('/conversations',body).then(function(r){
        NC.busy=false;
        var d=r.d||{};
        if(!r.ok||d.ok===false||!d.id){
          var msg=d.error||('יצירת הקבוצה נכשלה ('+r.status+')');
          ncState(msg,true); return tell(msg,true);
        }
        closeModal();
        // The COUNT comes back from the service (it includes you, and it dedupes), so it is reported
        // rather than recomputed from what was ticked here.
        tell('הקבוצה «'+title+'» נוצרה'+(typeof d.members==='number'?(' · '+d.members+' משתתפים'):''));
        openAfterCreate(d.id);
      });
    }
    /** Re-read the list first, THEN open: openConv() reads the row out of S.convs for its unread
     *  badge and its header, and a conversation that is not in the list yet would open headerless. */
    function openAfterCreate(id){
      return loadConvs().then(function(){ openConv(id); });
    }
    function newChat(){
      if(!canStartChat()){ binaTell(noStartReason(),'warn'); return; }
      openNewChat();
    }

    /* ── live refresh · the FALLBACK ───────────────────────────────────────────────
       Chat is two-sided: the other person's message arrives in the database, not in this tab.
       Without a refresh the window is a snapshot of whenever it was opened. The poll is cheap (one
       list query), stops while the tab is hidden, and re-renders the open thread ONLY when its
       content actually changed — re-rendering unconditionally would wipe half-typed text out of the
       composer every few seconds.

       This is NOT dead code now that the block below can stream. `subscribe` is a protocol op, so a
       connection that cannot push (WhatsApp, Telegram) keeps exactly this, and a stream that fails
       to establish falls back to it. Both paths call the SAME two functions, which is why the app
       behaves identically either way — only the trigger differs. */
    function threadSig(list){ list=list||[]; var l=list[list.length-1]||{}; return list.length+':'+(l.id||'')+':'+(l.status||''); }
    function refreshThread(){
      var id=S.openId; if(!id)return;
      /* TWO identities, because `id!==S.openId` alone answers the wrong question. It is correct for
         "the operator clicked another conversation" and useless for "the connection changed":
         resetForConnection() nulls S.openId, so a later openConv() on the NEW connection re-sets it
         and this guard then passes trivially for an answer fetched about the OLD one. Conversation
         ids are not portable across connections, and GET /api/conversation/:id is the one read route
         that does not report which connection it answered for — so the generation is the only thing
         here that can tell those two apart. */
      var gen=S.gen;
      jf('/conversation/'+encodeURIComponent(id)).then(function(d){
        if(!fresh(gen))return;
        if(!d||!d.messages||id!==S.openId)return;
        var sig=threadSig(d.messages); if(sig===S.threadSig)return;
        S.threadSig=sig;
        var m=$('#msgs'); if(!m)return;
        var near=(m.scrollHeight-m.scrollTop-m.clientHeight)<90;
        S.openContact=d.contact||S.openContact;
        m.innerHTML=msgsHtml(d.messages,(d.contact||{}).group); renderBotnote();
        if(near)m.scrollTop=m.scrollHeight;
      });
    }
    var POLL_MS=8000,_poll=null;
    function tick(){
      if(document.hidden||!S.booted)return;
      loadConvs();
      if(S.openId) refreshThread();
    }
    function startPoll(){ if(_poll)return; _poll=setInterval(tick,POLL_MS); }
    function stopPoll(){ if(!_poll)return; clearInterval(_poll); _poll=null; }
    /* Still the right thing with a stream open: it is a ONE-SHOT resync, not a poll. A tab that was
       hidden may have been throttled, and coming back is the moment to re-read rather than to trust
       whatever the last event left on screen. */
    document.addEventListener('visibilitychange',function(){ if(!document.hidden) tick(); });

    /* ── push · the same refresh, driven by the server ─────────────────────────────
       GET /api/events is a Server-Sent Events stream: `ready` on connect, `change` per event, a
       keep-alive comment every 25s. Three things are deliberate here.

       IT IS GATED ON THE MANIFEST, exactly like the people picker is gated on `listUsers`. Where
       `subscribe` is advertised the stream replaces the 8s poll; where it is not, the poll STAYS.
       Deleting the poll outright would leave WhatsApp and Telegram — the two connections that cannot
       push — with no updates at all, which is a worse app than the one that polls.

       IT RE-READS RATHER THAN RECONSTRUCTS. The event carries IDS only, on purpose, and every
       refresh goes back through loadConvs() / refreshThread(). Building a bubble out of an event
       would make the pushed view and the fetched view two renderings that can disagree; this way
       there is still exactly one place a message is turned into HTML.

       IT DOES NOT RETRY. EventSource reconnects by itself, with its own backoff. A retry loop here
       would open a SECOND stream — and each stream holds a dedicated Postgres LISTEN client on the
       server, so a leak is measured in database connections, not in browser memory. The only thing
       handled below is the case the browser gives up on (readyState CLOSED, i.e. a non-200 such as
       the 501 a backend without `subscribe` answers), and that falls back to the poll. */
    var _es=null;
    /** How long a stream gets to say `ready` before it is written off — see startEvents(). Generous:
     *  the server writes that line the moment it accepts the request, so anything slower than this is
     *  something in the path holding the response, not a slow network. */
    var HELLO_MS=10000;
    /** Conversations this tab has an unacknowledged optimistic bubble in — see onChange. */
    var _pending={};
    function pendingAdd(id){ _pending[id]=(_pending[id]||0)+1; }
    function pendingDone(id){ if(!_pending[id])return; if(--_pending[id]<=0) delete _pending[id]; }

    function stopEvents(){
      if(!_es)return;
      var es=_es; _es=null;                 // cleared FIRST: the handlers below check identity
      try{ es.close(); }catch(e){}
    }
    /** One event. Ids only — nothing here builds a message. */
    function onChange(raw){
      var d={}; try{ d=JSON.parse(raw||'{}'); }catch(e){ return; }
      loadConvs();                          // the list changes for any conversation, not just the open one
      if(!S.openId) return;
      if(d.conversation_id && d.conversation_id!==S.openId) return;
      /* `fromMe` is the echo of what THIS identity just sent. doSend() has already drawn that bubble
         optimistically and re-reads the thread itself the moment the write is acknowledged, so
         refreshing on the echo too would render the same message a second time in the window between
         the two. Skipped only while the send is actually outstanding: a fromMe event with nothing
         pending came from another tab or device and IS news. */
      if(d.fromMe && _pending[S.openId]) return;
      refreshThread();
    }
    function startEvents(){
      if(typeof window.EventSource!=='function') return false;
      /* Pinned to the connection this tab believes it is on. Without it the server resolves whatever
         the ACTIVE pointer says at the instant the request arrives, and a switch racing a boot would
         hand this tab a stream about the other account. */
      var cid=S.active, es;
      try{ es=new EventSource('api/events'+(cid?('?connection_id='+encodeURIComponent(cid)):'')); }
      catch(e){ return false; }
      _es=es;
      /* A stream that never speaks is not a stream. This used to be aimed at the console's own embed
         proxy, which buffered the whole response before forwarding it — an event-stream never ends,
         so the request hung until that proxy's 40s read timeout and EventSource opened another,
         forever. That is FIXED (a92b6dc0): app_proxy in platform-base/console/app.py now buffers
         only text/html — the rewrite needs the whole document — and streams everything else through
         iter_content with direct_passthrough, disabling the read timeout when the client asked for
         text/event-stream and setting no-transform + X-Accel-Buffering: no on the way back.

         The deadline stays, and not out of superstition: the console is not the only hop. Traefik,
         an SSO forward-auth, or a corporate proxy in front of the console can each hold a response
         that never ends, and the failure looks identical from here — silence. So `ready` keeps a
         deadline, and missing it means push does not work ON THIS PATH: close the stream and stay on
         the poll, which every connection has anyway. This is the opposite of a retry — it is the one
         place that stops the browser reopening a stream that cannot work. */
      var hello=setTimeout(function(){
        if(_es!==es)return;
        stopEvents(); startPoll();
      },HELLO_MS);
      es.addEventListener('ready',function(){
        if(_es!==es)return;
        /* Fires on every connect INCLUDING the ones EventSource makes on its own after a drop.
           Whatever changed while the stream was down was never delivered, so the state is re-read
           rather than assumed — and only now, with a stream proven to be up, does the poll stop. */
        clearTimeout(hello);
        stopPoll();
        loadConvs(); if(S.openId) refreshThread();
      });
      es.addEventListener('change',function(ev){ if(_es===es) onChange(ev.data); });
      es.onerror=function(){
        if(_es!==es)return;
        if(es.readyState===2){ stopEvents(); startPoll(); }   // the browser gave up; poll again
      };
      return true;
    }
    /** Which of the two this connection gets. The poll runs until a stream says `ready`, so a
     *  connection whose stream never opens is never left with nothing. */
    function syncLive(){
      stopEvents();
      startPoll();
      if(S.booted&&canSubscribe()) startEvents();
    }
    /* An abandoned stream is not free: the server holds a Postgres LISTEN client per open one, and a
       browser that goes to the bfcache never fires `beforeunload`. Both, so neither case leaks. */
    window.addEventListener('pagehide',stopEvents);
    window.addEventListener('beforeunload',stopEvents);

    function wireReconnect(btn){
      if(!btn)return;
      // Local chat has nothing to re-pair (the op is absent from /manifest), so the button says what
      // it will actually do rather than promising a re-pair that answers 501.
      if(!canReconnect()&&btn.lastChild&&btn.lastChild.nodeType===3) btn.lastChild.textContent='בדיקה מחדש';
      btn.onclick=function(){
        btn.disabled=true; btn.style.opacity='.6';
        if(!canReconnect()) return window.__chatReload().then(function(){ tell('החיבור נבדק מחדש'); });
        post('/account/reconnect',{id:S.activeAcct&&S.activeAcct.id}).then(function(r){
          if(!r.ok){ btn.disabled=false; btn.style.opacity='1'; return tell((r.d&&r.d.error)||'החיבור מחדש נכשל',true); }
          tell('החיבור חודש בהצלחה'); window.__chatReload();
        });
      };
    }

    document.querySelectorAll('#segtabs .seg').forEach(function(el){el.onclick=function(){document.querySelectorAll('#segtabs .seg').forEach(function(x){x.classList.remove('on');});el.classList.add('on');S.filter=el.getAttribute('data-f');renderList();};});
    var deb; $('#convSearch').addEventListener('input',function(e){clearTimeout(deb);deb=setTimeout(function(){S.q=e.target.value.trim();renderList();},110);});
    $('#newChat').onclick=newChat;
    $('#mNew').onclick=newChat;
    $('#botCfg').onclick=openBots;
    $('#acctBtn').onclick=function(e){ e.stopPropagation(); toggleMenu(); };
    $('#mConn').onclick=function(e){ e.stopPropagation(); openConnPicker(); };
    document.addEventListener('click',hideMenu);
    document.addEventListener('keydown',function(e){ if(e.key==='Escape'){ hideMenu(); closeModal(); } });
    $('#mX').onclick=closeModal;
    $('#ov').onclick=function(e){ if(e.target===$('#ov')) closeModal(); };

    /* ── the shell tells the frame the pointer moved ───────────────────────────────
       The console's top-bar chip and the connect wizard both POST /connections/select, which writes
       the SAME single active pointer this app reads — but server-side, with nothing in the response
       that reaches this document. Before this listener the frame simply went on rendering the
       previous account: its label, its status dot, its bot card, its op-gated buttons and (on a local
       connection, whose stream had already stopped the poll) its frozen conversation list.

       postMessage rather than polling for it, because the console and the embedded app are
       SAME-ORIGIN — the app is served through /a/chat/ by app_proxy — so the message is cheap,
       instant, and origin-checkable at both ends. It carries no data: "something moved, re-read",
       which is the only thing the shell actually knows. Everything else comes from the service.

       THE CONTRACT (the console side is wired separately; this end is deliberately liberal about
       what it accepts and strict about who it accepts it from):
         in   { type: 'platform:connection-changed' | 'platform:reload', service?: 'chat' }
         out  { type: 'platform:reload-ack', service: 'chat' }   → posted back to the sender
       `service` is optional on the way in and ignored unless present, so a shell that broadcasts to
       every frame it owns does not need to know which app is in this one. The ack exists so the
       shell can keep Option B — reload the frame outright — as the fallback for an app that does not
       listen, without paying for it here: an app that answers is not reloaded, and an app that never
       answers gets today's behaviour. Nothing here is required for correctness; a console that sends
       nothing at all leaves this app exactly as it was.

       Everything else on the message is untrusted input and none of it is used: no connection id is
       taken from the shell, because the pointer's owner is the service and boot() is about to ask
       it. That keeps this listener incapable of pointing the app at a connection nobody selected. */
    window.addEventListener('message',function(ev){
      if(ev.origin!==window.location.origin) return;       // same-origin only, both ends
      var d=ev.data;
      if(!d||typeof d!=='object') return;
      if(d.type!=='platform:connection-changed'&&d.type!=='platform:reload') return;
      if(d.service&&d.service!=='chat') return;            // a broadcast meant for another frame
      try{ if(ev.source&&ev.source.postMessage) ev.source.postMessage({type:'platform:reload-ack',service:'chat'},window.location.origin); }catch(e){}
      /* null, not an id: the shell knows THAT the pointer moved, never where to. resetForConnection
         invalidates everything scoped to the old connection and bumps S.gen, so the answers still in
         flight for it are dropped instead of landing on the new screen; boot() then asks the service
         who we are now. This is the same door the in-app switcher uses — which is the point: the two
         controls now converge on one behaviour instead of one of them doing nothing. */
      resetForConnection(null);
      boot();
    });

    /* boot() ends in syncLive(), which is what starts the poll or the stream — so every path that
       re-boots (the connection switcher, __chatReload, the retry button) gets the right one for the
       connection it lands on, instead of only the first load getting it right. */
    boot();
  })();
  </script>
</body>
</html>
