#!/usr/bin/env bash
#: flow — the documents' events (issued, filed, needs review, each sync), the last 10 and then live:  ./bbox documents flow [-n N] [--once] [--json]
# The app's stream on the office's event stream (flow.v1, DGO-1402): the platform's reader, for `dgo:flow:documents`.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "${SCRIPT_DIR}/../../../platform-base/redis/hooks/flow" documents "$@"
