#!/usr/bin/env bash
#: search <words> — one search over the issued and the incoming documents:  ./bbox documents search חשמל
# Pipes the app's own CLI (apps/documents/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help|"") sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T documents python - search "$@" < "$(npath "${REPO_ROOT}")/apps/documents/cli.py"
