#!/usr/bin/env bash
#: show <id> — one document: the index row and the provider's own record:  ./bbox documents show local:42
# Pipes the app's own CLI (apps/documents/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help|"") sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T documents python - show "$@" < "$(npath "${REPO_ROOT}")/apps/documents/cli.py"
