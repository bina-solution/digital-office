#!/usr/bin/env bash
#: show <id> — one business document, with its lines (no download: that uses up its «מקור»):  ./bbox my-docs show <id>
# Pipes the app's own CLI (apps/my-docs/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help|"") sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T my-docs python - show "$@" < "$(npath "${REPO_ROOT}")/apps/my-docs/cli.py"
