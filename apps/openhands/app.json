{
  "id": "openhands",
  "title": {
    "he": "סוכן קוד",
    "en": "OpenHands"
  },
  "layer": 3,
  "people": "admins",
  "kind": "service",
  "share": {
    "local": "A coding agent that runs code in this office's workspace with a container runtime: served on a link, it would hand another office code execution here."
  },
  "version": "1.8.0",
  "summary": {
    "he": "סוכן קוד אוטונומי",
    "en": "Autonomous coding agent"
  },
  "capabilities": [
    {
      "name": "coding-agent",
      "type": "protocol",
      "endpoint": "http://openhands:3000"
    }
  ],
  "use": [
    {
      "capability": "llm-local",
      "strength": "wants",
      "after": false,
      "dependency": "weak"
    },
    {
      "capability": "secrets",
      "strength": "requires",
      "after": true
    }
  ],
  "connections": [
    {
      "id": "anthropic-key",
      "required": false
    },
    {
      "id": "openai-key",
      "required": false
    }
  ],
  "compose": "docker-compose.yml",
  "agent": {
    "context": "AGENT.md",
    "order": 96
  },
  "routing": [
    {
      "host": "openhands",
      "port": 3000,
      "auth": "sso",
      "emit_labels": false,
      "sso": {
        "slug": "openhands",
        "display_name": "OpenHands",
        "default_host": "openhands.localhost",
        "base_url_env": "OPENHANDS_BASE_URL",
        "local_twin": true
      },
      "module": {
        "name": "OpenHands",
        "icon": "bot",
        "desc": "סוכן קוד — כותב ומריץ קוד בסביבת עבודה של הלשכה",
        "group": "פיתוח ואוטומציות",
        "order": 250,
        "embed": false
      }
    }
  ],
  "health": {
    "structural": "auto"
  },
  "data": {
    "volumes": ["openhands_state", "openhands_config", "llm_gateway_config"],
    "on_uninstall": "prompt"
  },
  "resources": {
    "cpus": "2",
    "memory": "4g"
  }
}
