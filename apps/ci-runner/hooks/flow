#!/usr/bin/env bash
#: flow — the runner's events (a job waiting at the door, started, refused, ended; paused, resumed), the last 10 and then live:  ./bbox ci-runner flow [-n N] [--once] [--json]
# The app's stream on the office's event stream (flow.v1, DGO-1402): the platform's reader, for `dgo:flow:ci-runner`.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "${SCRIPT_DIR}/../../../platform-base/redis/hooks/flow" ci-runner "$@"
