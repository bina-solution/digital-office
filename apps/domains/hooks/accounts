#!/usr/bin/env bash
#: accounts — the office's domain accounts (API or browser), not probed:  ./bbox domains accounts
# Pipes the app's own CLI (apps/domains/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T domains python - accounts < "$(npath "${REPO_ROOT}")/apps/domains/cli.py"
