#!/usr/bin/env bash
#: ls [account] — the domains of one account (a browser account reads its panel in the office browser), or every domain the office knows:  ./bbox domains ls
# Pipes the app's own CLI (apps/domains/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T domains python - ls "$@" < "$(npath "${REPO_ROOT}")/apps/domains/cli.py"
