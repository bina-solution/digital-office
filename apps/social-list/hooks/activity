#!/usr/bin/env bash
#: activity — the log of everything done on the owner's behalf on the networks:  ./bbox social-list activity
# Pipes the app's own CLI (apps/social-list/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T social-list python - activity < "$(npath "${REPO_ROOT}")/apps/social-list/cli.py"
