{
  "id": "digital-assets",
  "title": {
    "he": "זהות",
    "en": "Identity"
  },
  "layer": 3,
  "people": "admins",
  "kind": "service",
  "page": "services",
  "version": "0.2.0",
  "summary": {
    "he": "המקום היחיד שבו מגדירים את העסק — שם, פרטים משפטיים, פרטי קשר, סמלים, צבעים, טקסטים, תוכן ומדיה — וכל הלשכה קוראת משם: מסמכים, אתרים, רשתות ומוצרים",
    "en": "The one place the business is defined — name, legal details, contact details, marks, colours, texts, content and media — and the whole office reads it from here: documents, websites, networks and products"
  },
  "capabilities": [
    {
      "name": "digital-assets",
      "type": "protocol",
      "interface": "digital-assets.v1",
      "endpoint": "http://digital-assets:8985",
      "contract": "platform-service.v1",
      "required_ops": [
        "listSlots",
        "getSlot",
        "addAsset",
        "setActive",
        "plan",
        "publish",
        "listMedia",
        "addMedia",
        "createPost"
      ],
      "optional_ops": [
        "getBrand",
        "getBundle",
        "listBlueprints",
        "applyBlueprint",
        "listChannels",
        "bindChannel"
      ]
    },
    {
      "name": "brand",
      "type": "protocol",
      "interface": "brand.v1",
      "endpoint": "http://digital-assets:8985",
      "required_ops": [
        "getBrand"
      ]
    }
  ],
  "use": [
    {
      "capability": "identity",
      "strength": "requires",
      "after": true
    },
    {
      "capability": "social",
      "strength": "wants",
      "after": false,
      "dependency": "weak",
      "ops": [
        "listAccounts",
        "updateProfile",
        "createPost",
        "capabilities"
      ]
    },
    {
      "capability": "sites",
      "strength": "wants",
      "after": false,
      "dependency": "weak",
      "ops": [
        "listSites"
      ]
    },
    {
      "capability": "ui-kit",
      "strength": "wants",
      "after": false,
      "dependency": "weak"
    }
  ],
  "connections": [],
  "compose": "docker-compose.yml",
  "routing": [
    {
      "host": "digital-assets",
      "port": 8985,
      "auth": "sso",
      "module": {
        "group": "ניהול העסק",
        "icon": "palette",
        "embed": true,
        "alias": "digital-assets",
        "id": "digital-assets",
        "name": "זהות",
        "desc": "הזהות של העסק, במקום אחד — ומשם לכל הלשכה ולכל ערוץ",
        "order": 4,
        "service": "digital-assets",
        "url_env": "DIGITAL_ASSETS_URL",
        "url": "http://digital-assets:8985"
      },
      "sso": {
        "slug": "digital-assets",
        "display_name": "Digital assets",
        "default_host": "digital-assets.localhost",
        "base_url_env": "DIGITAL_ASSETS_BASE_URL",
        "local_twin": true
      }
    }
  ],
  "health": {
    "structural": "auto",
    "probe": {
      "http": "http://digital-assets:8985/healthz",
      "interval": "30s"
    }
  },
  "data": {
    "volumes": [],
    "paths": ["data/digital-assets/state"],
    "moved_from": {"data/digital-assets/state": "digital_assets_state"},
    "on_uninstall": "keep"
  },
  "resources": {
    "cpus": "0.4",
    "memory": "256M"
  },
  "observability": {
    "sentry_platform": "python"
  },
  "agent": {
    "context": "AGENT.md",
    "order": 4
  }
}