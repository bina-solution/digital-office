#!/usr/bin/env bash
#: state — what this app holds, one `<name> <value>` per line:  ./bbox n8n state
#: In its database (data/n8n/db, read in n8n-postgres): its workflows and its credentials — never the executions,
#: which it prunes by age; -1 for a table this version does not have. In its home (data/n8n/home, read in n8n): the
#: key file n8n wrote on its first start (1 or 0) and the community node packages it carries. Counts only, never a
#: name or a value. The data move (platform/manager/datahome.py, DGO-2019) reads it before it moves a store and again
#: after, and sends the store back to its volume when what it held is gone. Plain sh: two images.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
# The data move names the container it measures; by hand, it is the office's own database.
if [ -n "${DGO_STATE_CONTAINER:-}" ]; then
  inside() { docker exec -i "${DGO_STATE_CONTAINER}" "$@"; }
else
  . "${REPO_ROOT}/scripts/lib.sh"
  inside() { dcx exec -T n8n-postgres "$@"; }
fi
inside sh -s <<'SH'
if command -v psql >/dev/null 2>&1; then
  # the local socket, as its POSTGRES_USER role — both counts in ONE query: a database that answers half says nothing.
  # Each count is run by name AT RUN TIME (query_to_xml): postgres resolves every table a query names before it runs
  # it, a CASE branch never taken included, so a table this version lacks would fail the whole query
  c() { printf "case when to_regclass('%s') is null then -1 else (xpath('/row/c/text()', query_to_xml('select count(*) as c from %s', false, true, '')))[1]::text::int end" "$1" "$1"; }
  # its own password too (the container has it): an office whose local socket is not `trust` still answers
  n="$(PGPASSWORD="${POSTGRES_PASSWORD:-}" psql -U "${POSTGRES_USER:-root}" -d "${POSTGRES_DB:-n8n}" -tA -F' ' -c "select
    $(c workflow_entity), $(c credentials_entity)" 2>/dev/null)" || exit 0
  set -- ${n}
  [ "$#" = 2 ] || exit 0
  echo "db.workflows $1"; echo "db.credentials $2"
else
  h=/home/node/.n8n
  echo "home.config $([ -s "${h}/config" ] && echo 1 || echo 0)"
  echo "home.nodes $(find "${h}/nodes/node_modules" -mindepth 1 -maxdepth 2 -name package.json 2>/dev/null | wc -l)"
fi
SH
