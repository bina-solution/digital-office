#!/usr/bin/env bash
#: state — what this app holds, one `<name> <value>` per line:  ./bbox entities state
#: The rows of every table of entities.db — the people and organizations the business works with, their roles and
#: relations, where each came from, and the audit of every change. The data move (platform/manager/datahome.py,
#: DGO-2019) reads it before it moves data/entities/state and again after, and sends the store back to its volume
#: when a table that held rows holds none.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
# The data move names the container it measures; by hand, it is the office's own.
if [ -n "${DGO_STATE_CONTAINER:-}" ]; then
  inside() { docker exec -i "${DGO_STATE_CONTAINER}" "$@"; }
else
  . "${REPO_ROOT}/scripts/lib.sh"
  inside() { dcx exec -T entities "$@"; }
fi
inside python - <<'PY'
import os, sqlite3
c = sqlite3.connect(os.path.join(os.environ.get("ENTITIES_DATA", "/data"), "entities.db"))
for (t,) in c.execute("select name from sqlite_master where type='table' and name not like 'sqlite_%' order by name"):
    print(f"rows.{t}", c.execute(f'select count(*) from "{t}"').fetchone()[0])
PY
