#!/usr/bin/env bash
#: logs <id> [lines] — the website container's log (default 200 lines):  ./bbox sites logs <id> 50
# Pipes the app's own CLI (apps/sites/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help|"") sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T sites python - logs "$@" < "$(npath "${REPO_ROOT}")/apps/sites/cli.py"
