#!/usr/bin/env bash
# verb — run one «סלאק» CLI verb (tools/cli.py) inside this office's slack container: every hooks/<verb> is one
# line that execs this. The code goes in as an ARGUMENT (python3 -c), so stdin stays free for the token
# (`login --token-stdin`). Exit: the verb's (0/1/2/3); 3 when the app is not running here.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${HERE}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
CODE="$(cat "${HERE}/cli.py" 2>/dev/null)" && [ -n "${CODE}" ] || { echo "slack: tools/cli.py could not be read" >&2; exit 3; }
running "slack-${DN}" || { echo "slack is not running here (./bbox apps enable slack && ./bbox run)" >&2; exit 3; }
# The token comes on stdin, and inside the container stdin is always a pipe — so the terminal is asked HERE.
case " $* " in
  *" --token-stdin "*)
    [ -t 0 ] && { echo "slack: the token is read from stdin, and stdin is a terminal — pipe it in (… < file)" >&2; exit 2; } ;;
esac
dcx exec -T slack python3 -c "${CODE}" "$@"
