#!/bin/sh
# /usr/local/bin/slack-desktop-session — the Selkies session's one application: Slack (DGO-1264). openbox runs it
# (through ~/.config/openbox/autostart, which names only this file) as the image's user `abc`, with HOME=/config,
# the volume's `desktop` folder. POSIX sh. Taken from apps/_template-wrapped/desktop/autostart.template.

# The keyring Slack keeps its sign-in in, unlocked at every start by a password minted once into HOME.
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || eval "$(dbus-launch --sh-syntax)"
KEYPW="${HOME}/.keyring-pass"
[ -s "${KEYPW}" ] || ( umask 077; head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n' > "${KEYPW}" )
eval "$(gnome-keyring-daemon --replace --unlock --components=secrets < "${KEYPW}" | sed 's/^/export /')"

# Electron picks its secret store from the desktop it sees; under openbox it sees none and keeps its tokens in
# plain text, so every recreate signs out (DGO-1335). Name the keyring.
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-GNOME}"

# No updater to turn off: Slack's Linux build updates through apt, whose source the image removed (Dockerfile).
# The image is the version, and an update is a rebuild.

# THE SIGN-IN'S BROWSER AND ITS WAY BACK (Dockerfile.desktop says why): the desktop user's mimeapps.list names
# the sign-in browser for http and https, and Slack's own .desktop file (now running slack-open-link) for
# slack://, at every start (a build cannot write into this volume). A window's profile left by a stop is cleared.
rm -rf "${TMPDIR:-/tmp}"/slack-signin.* 2>/dev/null
if command -v xdg-mime >/dev/null 2>&1; then
  xdg-mime default slack-web.desktop x-scheme-handler/https x-scheme-handler/http 2>/dev/null
  xdg-mime default slack.desktop x-scheme-handler/slack 2>/dev/null
fi
BROWSER=/usr/local/bin/slack-signin-browser
export BROWSER

# Brought back whenever it exits. --no-sandbox: Chromium's sandbox needs user namespaces that docker's default
# seccomp denies; the container is the sandbox. No GPU here. The package's own binary, by its path: the handler
# (desktop/open-link) knows the running Slack by it.
while :; do
  /usr/lib/slack/slack --no-sandbox --disable-gpu --password-store=gnome-libsecret >>"${HOME}/.slack-desktop.log" 2>&1
  sleep 3
done
