{
  "id": "portainer",
  "title": {
    "he": "Portainer",
    "en": "Portainer"
  },
  "layer": 3,
  "people": "admins",
  "kind": "tool",
  "share": {
    "local": "Docker management is root on this office's engine: it never crosses a link."
  },
  "version": "1.0.0",
  "summary": {
    "he": "ניהול מכולות Docker",
    "en": "Docker container management"
  },
  "capabilities": [],
  "use": [],
  "connections": [
    {
      "id": "portainer-admin",
      "required": true
    }
  ],
  "compose": "docker-compose.yml",
  "agent": {
    "context": "AGENT.md",
    "order": 97
  },
  "routing": [
    {
      "host": "portainer",
      "port": 9000,
      "auth": "sso",
      "sso": {
        "slug": "portainer",
        "display_name": "Portainer",
        "default_host": "portainer.localhost",
        "base_url_env": "PORTAINER_BASE_URL",
        "local_twin": true
      },
      "module": {
        "name": "Portainer",
        "icon": "box",
        "desc": "ניהול מכולות Docker — root על מנוע הלשכה, מאחורי הכניסה של הלשכה",
        "group": "תשתית",
        "order": 260,
        "embed": false
      }
    }
  ],
  "health": {
    "structural": "auto"
  },
  "data": {
    "volumes": [
      "portainer_data"
    ],
    "on_uninstall": "prompt"
  },
  "contributes": {
    "connection_providers": [
      {
        "id": "portainer-admin",
        "automint": {
          "type": "password",
          "chars": 24
        },
        "title": "Portainer admin password",
        "kind": "password",
        "pillar": "app-password",
        "app": {
          "name": "Portainer",
          "url_env": "PORTAINER_BASE_URL",
          "user": "admin"
        },
        "env": "PORTAINER_ADMIN_PASSWORD",
        "now": "debian-install.sh random-generates production/portainer/portainer_password.txt (gitignored); portainer reads it via --admin-password-file. CI writes the file from .env.",
        "probe": {
          "type": "http",
          "url": "http://portainer:9000/api/status"
        },
        "wizard": "auto-mint (owner never types it); rendered to the file by the injector"
      }
    ]
  }
}
