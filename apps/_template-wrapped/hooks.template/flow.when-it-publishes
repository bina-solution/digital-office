#!/usr/bin/env bash
#: flow — what <Name> did, as it happens: the last 10 events, then live ([-n N] [--once] [--json])
# The event stream (build-your-first-app.md «The event stream», flow.v1): the adapter publishes through
# platform-base/redis/flowpub.py onto dgo:flow:<id>, and this verb is the platform's own reader.
exec bash "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)/platform-base/redis/hooks/flow" <id> "$@"
