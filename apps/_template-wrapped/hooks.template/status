#!/usr/bin/env bash
#: status — is <Name> up, and signed in: [--json]
# One read of the adapter (capabilities[].endpoint), from inside its container: no address, no key, no rebuild.
# `dcx exec` is the platform's way in: this office's engine and compose project, so another deployment's
# container on the same engine is never the one asked (the worked example is apps/bina-claude/hooks/status).
# The read runs in the adapter's OWN runtime: node here; a Python adapter makes it `python3 -c` with the same
# three answers. The standard (ai/context/app-cli-api-standard.md): --json on every verb, exit 0 answered /
# 1 failed / 2 usage / 3 the app did not answer.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
JSON=0
for a in "$@"; do
  case "${a}" in
    -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;;
    --json) JSON=1 ;;
    *) echo "<id> status: unknown argument '${a}' (status [--json])" >&2; exit 2 ;;
  esac
done
dcx exec -T -e JSON="${JSON}" <id> node -e '
fetch("http://127.0.0.1:<adapter port>/v1/health").then(r => r.json()).then(h => {
  if (process.env.JSON === "1") { console.log(JSON.stringify(h)); return; }
  console.log(h.signed_in ? "signed in" : "not signed in — open the tile and sign in");
}).catch(e => { console.error("<id>: the adapter did not answer: " + e.message); process.exit(3); });'
rc=$?
# a container that is not running, or a runtime it does not have, is «the app did not answer», never an odd code
case "${rc}" in 0|1|2|3) exit "${rc}" ;; *) echo "<id> is not answering here (exit ${rc}; ./bbox apps enable <id> && ./bbox run)" >&2; exit 3 ;; esac
