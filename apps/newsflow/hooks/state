#!/usr/bin/env bash
#: state — what this app holds, one `<name> <value>` per line:  ./bbox newsflow state
#: The rows of every table of newsflow.db — the articles collected, their mentions, the owner's reviews and every run.
#: The data move (platform/manager/datahome.py, DGO-2019) reads it before it moves data/newsflow/state and again after,
#: and sends the store back to its volume when a table that held rows holds none.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
# The data move names the container it measures; by hand, it is the office's own.
if [ -n "${DGO_STATE_CONTAINER:-}" ]; then
  inside() { docker exec -i "${DGO_STATE_CONTAINER}" "$@"; }
else
  . "${REPO_ROOT}/scripts/lib.sh"
  inside() { dcx exec -T newsflow "$@"; }
fi
inside python - <<'PY'
import os, sqlite3
c = sqlite3.connect(f"file:{os.environ.get('NEWSFLOW_DB', '/data/newsflow.db')}?mode=ro", uri=True, timeout=30)
# every count first, then the lines: a database locked part-way (a pass writing) says nothing, never half of it
tables = [t for (t,) in c.execute("select name from sqlite_master where type='table' and name not like 'sqlite_%' "
                                   "order by name").fetchall()]
rows = [(t, c.execute(f'select count(*) from "{t}"').fetchone()[0]) for t in tables]
for t, n in rows:
    print(f"rows.{t}", n)
PY
