#!/usr/bin/env bash
#: speech-health — the transcriber: the model's state, the queue's depth, the limits:  ./bbox apitools speech-health
# Pipes the app's own CLI (apps/apitools/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T apitools python - speech-health < "$(npath "${REPO_ROOT}")/apps/apitools/cli.py"
