#!/usr/bin/env bash
#: speech-jobs — the 20 most recent transcription jobs, and the queue's counts:  ./bbox apitools speech-jobs
# Pipes the app's own CLI (apps/apitools/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T apitools python - speech-jobs < "$(npath "${REPO_ROOT}")/apps/apitools/cli.py"
