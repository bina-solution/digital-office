#!/usr/bin/env bash
#: state — what the OCR service holds, one `<name> <value>` per line:  ./bbox apitools state
#: In apitools (data/apitools/storage): the files of its store — the OCR cache, the rendered pages, the drawings — and
#: a fingerprint of its document signer, dev_signer.p12 (`k` + a hash's prefix, never the key; no line before its first
#: signed document), which must stay the same: a new one splits every document it signs from those before; and
#: (data/apitools/logs) its log files. Counts only, never a name. The data move (platform/manager/datahome.py,
#: DGO-2019) reads it before it moves a store and again after, and sends the store back to where it was when what it
#: held is gone.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
# The data move names the container it measures; by hand, it is the office's own apitools.
if [ -n "${DGO_STATE_CONTAINER:-}" ]; then
  inside() { docker exec -i "${DGO_STATE_CONTAINER}" "$@"; }
else
  . "${REPO_ROOT}/scripts/lib.sh"
  inside() { dcx exec -T apitools "$@"; }
fi
inside sh -s <<'SH'
[ -d /app/.storage ] || exit 0
echo "storage.files $(find /app/.storage -type f 2>/dev/null | wc -l)"
# the signer's line only once there is one: an office that has never signed has nothing to compare, and its first
# signed document after a move must not read as a changed key; a signer that vanishes after the move is still «gone»
s=/app/.storage/dev_signer.p12
[ -f "${s}" ] && echo "storage.signer k$(sha256sum "${s}" | cut -c1-16)"
echo "logs.files $(find /app/logs -type f 2>/dev/null | wc -l)"
SH
