FROM python:3.12-slim

WORKDIR /app

COPY api/requirements.txt /app/api/requirements.txt
RUN pip install --no-cache-dir -r /app/api/requirements.txt

# The feature dirs and lib are mounted as volumes, but copy the API code
COPY api/ /app/api/

EXPOSE 8100

CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8100"]
