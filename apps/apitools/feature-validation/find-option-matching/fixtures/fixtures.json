    "expected": {
      "has_result": false,
      "has_matches": false,
      "match_count": 0,
      "expected_options_found": [],
      "no_false_positives": [],
      "notes": "Neither candidate id appears in the document"
    }
  },
  {
    "name": "no-matches-expected",
