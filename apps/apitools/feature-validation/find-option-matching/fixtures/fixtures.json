        "514745819",
        "לא קיים בכלל"
      ],
      "value_validations": [],
      "is_rtl": true
    },
    "expected": {
      "match_count": 1,
      "expected_options_found": [
        "514745819"
      ],
      "no_false_positives": [],
      "notes": "EAN, סכום, חומר, תיאור חומר all appear in the price list header rows"
    }
  },
  {
    "name": "match-mode-id-with-known-id",
    "source_file": "fixtures/ciment.pdf",
    "notes": "match_mode:'id' wiring added for the company-id-ocr-recognition Phase 0 fix (issues/company-id-ocr-recognition-design.yaml). Same document as small-option-set-with-matches, but exercised through match_mode:'id' instead of the default fuzzy-annotation path, plus exclude_near — the exact shape wired into indoxV2FigureCompanyId01.json's Find Option node.",
    "ocr_json_query": {
      "action": "find option",
      "action_value": [
        "000000000",
        "514745819"
      ],
      "match_mode": "id",
      "exclude_near": ["הכהנים", "מ.ש הכהנים"],
      "value_validations": [],
      "is_rtl": true
    },
    "expected": {
      "match_count": 1,
      "expected_options_found": [
        "514745819"
      ],
      "no_false_positives": [],
      "notes": "514745819 (CIMENT's own עוסק מורשה / VAT file id) is printed near the top of the document; 000000000 never appears."
    }
  },
  {
    "name": "match-mode-id-no-match-expected",
    "source_file": "fixtures/ciment.pdf",
    "notes": "match_mode:'id' against ids that are not printed anywhere in the document — must return no match (ActionOutputNone), not a false positive.",
