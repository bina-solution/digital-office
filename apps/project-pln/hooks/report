#!/usr/bin/env bash
#: report --said | "<words>" | - (stdin) | "<title>" --body @<file>|"<text>"  [--priority urgent|high|medium|low] — a bug or a request as a DGO work item, at once: its DGO-<n> and link
#
# The owner's «I will be able to bug report» (DGO-952) in one command a small model can run. A report is
# a work item like every other — declared in a plan file, rendered into Plane by `plan` — in a file of
# the office's own: plans/reports-<office>.yaml, key rep-<office>-<yymmdd>-<HHMMSS> (report.py says why).
# This verb appends the item there, applies just that key, and prints the item as `tasks show` does,
# its console link included. The file stays in the checkout like any other edit, for whoever commits.
#
#   ./bbox project-pln report --said          # the agent: the person's last message in its session
#   ./bbox project-pln report 'הקונסול לא נטען בטלפון'      # the words; the title is made of them
#   ./bbox project-pln report 'a title' --body @/tmp/report.txt
#
# `--said` is what the agent's recipe runs: it carries no text at all, so there is nothing a small model
# can mangle on the way (report.py, said_in_session; apps/operatives/README.md, «Free text in a recipe»).
#
# Exit 0 once the item is in Plane — even if something after its creation failed, which is printed:
# a report run twice is two items. Exit 1 when it is declared but not in Plane, with the one command
# that applies it; exit 2 when it was refused before anything was written.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"   # say, colors, DN (this office's DEPLOYMENT_NAME), npath
APP_DIR="${REPO_ROOT}/apps/project-pln"
case "${1:-}" in
  "")        sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 2 ;;
  -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;;
esac

OUT="$(python3 "$(npath "${APP_DIR}")/report.py" add --office "${DN}" "$@")" || exit 2
KEY="$(printf '%s\n' "${OUT}" | sed -n 's/^KEY=//p')"
FILE="$(printf '%s\n' "${OUT}" | sed -n 's/^FILE=//p')"
[ -n "${KEY}" ] && [ -n "${FILE}" ] || { say "${cr}[project-pln] report: no key came back — nothing applied${c0}"; exit 2; }
PLAN="$(basename "${FILE}" .yaml)"
say "[project-pln] report ${KEY} declared in ${FILE#"${REPO_ROOT}/"}"

APPLY="$("${SCRIPT_DIR}/plan" "${PLAN}" --only "${KEY}" 2>&1)"; RC=$?
APPLY="$(printf '%s\n' "${APPLY}" | grep -v POSTGRES_PASSWORD)"
# A key is matched as text, not as a pattern: `created DGO-<n> [<key>]` is plan.py's own line.
REF="$(printf '%s\n' "${APPLY}" | grep -F "[${KEY}]" | grep -oE '(created|updated) DGO-[0-9]+' | head -1 | grep -oE 'DGO-[0-9]+')"
if [ -z "${REF}" ]; then
  printf '%s\n' "${APPLY}" | sed 's/^/  /'
  say "${cr}[project-pln] ${KEY} is declared but NOT in Plane — apply it once more, not the report: ./bbox project-pln plan ${PLAN} --only ${KEY}${c0}"
  exit 1
fi
if printf '%s\n' "${APPLY}" | grep -F "[${KEY}]" | grep -q "updated ${REF} "; then
  say "${cr}[project-pln] ${KEY} was ALREADY an item, and ${REF} has just been rewritten with this report — look at its history${c0}"
elif [ "${RC}" -ne 0 ]; then
  printf '%s\n' "${APPLY}" | sed 's/^/  /'
  say "${cy}[project-pln] ${REF} was created; what failed after it is above${c0}"
fi
"${SCRIPT_DIR}/tasks" show "${REF}" || say "[project-pln] ${REF} — tasks show did not answer"
exit 0
