#!/usr/bin/env bash
#: project-pln — assert the instance is one a person can actually USE, not merely one that is up
#
# verify — Plane's own post-bring-up assertion, invoked generically by `run_app_hooks verify`
# (`bbox baseline` P6); nothing outside this folder knows what Plane needs to be usable.
#
# A running container is not a working office product, and Plane is the extreme case: it can be
# perfectly healthy while refusing every sign-in (`Instance.is_setup_done` false), and healthy again
# while offering an empty workspace with no project to click on. `hooks/onboard` is what fixes both,
# so what this asserts is exactly what that hook promises:
#
#   1. the API answers through the container     — the app is really serving
#   2. the declared state is in the database     — owner, workspace, project, states, membership
#   3. the owner can SIGN IN with the password in .env — the end of the story, and the only check
#      that would have caught the original problem (a green container, a login screen, and no way in)
#
# The password is read from .env, used, and never printed — not in the message, not on failure.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"   # say/ok/bad/warn, cn, dcx, read_env

SVC=project-pln
HOSTHDR="$(read_env PROJECT_PLN_BASE_URL)"; HOSTHDR="${HOSTHDR:-plane.localhost:8080}"
MANAGE="python3 /app/backend/manage.py"
FAILED=0

# ── 1. is it serving? ───────────────────────────────────────────────────────────────────────────
CODE="$(dcx exec -T "${SVC}" sh -c 'curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1/api/instances/' 2>/dev/null | tr -d '\r' | tail -1)"
if [ "${CODE}" = "200" ]; then
  ok "project-pln-api — /api/instances/ answers 200 inside the container"
else
  bad "project-pln-api — /api/instances/ answered '${CODE:-nothing}' (expected 200)"
  FAILED=1
fi

# ── 1b. is a sign-in answered on the host that was ASKED? ───────────────────────────────────────
# Every answer of a sign-in is a redirect, and a browser sent to another host than the one it is on
# has left its new session behind (Caddyfile, `asked`). Asked with no credentials at all: a provider
# callback that carries no state is refused with the same redirect a sign-in ends in.
ASKED="https://plane.asked.test:8443"
WENT="$(dcx exec -T "${SVC}" sh -c "curl -s -o /dev/null -w '%{redirect_url}' -H 'X-Forwarded-Proto: ${ASKED%%://*}' -H 'X-Forwarded-Host: ${ASKED#*://}' http://127.0.0.1/auth/google/callback/" 2>/dev/null | tr -d '\r' | tail -1)"
case "${WENT}" in
  "${ASKED}/"*) ok "project-pln-origin — a sign-in is answered on the host the browser asked" ;;
  *) bad "project-pln-origin — a sign-in asked on ${ASKED} was answered on '${WENT:-nothing}': a framed window leaves its host and loses the session"
     FAILED=1 ;;
esac

# ── 2. the declared state ───────────────────────────────────────────────────────────────────────
STATE="$(dcx exec -T "${SVC}" ${MANAGE} shell -c '
import json
from plane.db.models import User, Workspace, Project, State, Label, Profile, ProjectMember, WorkspaceMember
from plane.license.models import Instance, InstanceAdmin
i = Instance.objects.first()
ws = Workspace.objects.first()
p = Project.objects.first()
print("STATE|" + json.dumps({
    "setup_done": bool(i and i.is_setup_done),
    "telemetry": bool(i and i.is_telemetry_enabled),
    # user__isnull=False on purpose: a deleted user leaves its admin row behind (`SET_NULL`), and a
    # row pointing at nobody is not an administrator — counting it would pass an instance that has
    # no one able to sign in.
    "admins": InstanceAdmin.objects.filter(user__isnull=False).count(),
    "dangling_admins": InstanceAdmin.objects.filter(user__isnull=True).count(),
    "users": User.objects.count(),
    "workspaces": Workspace.objects.count(),
    "projects": Project.objects.count(),
    # The DECLARED objects by name, not a count of everything: this office gained a second workspace
    # and a plan project (DGO), and a gate that calls growth a failure is a gate nobody keeps.
    "declared_ws": Workspace.objects.filter(slug="bina").exists(),
    "declared_project": Project.objects.filter(identifier="GEN").exists(),
    "owner_is_member": WorkspaceMember.objects.filter(ws_slug="bina").exists()
                       if False else WorkspaceMember.objects.filter(workspace__slug="bina").exists(),
    "onboarded": bool(Profile.objects.filter(is_onboarded=True).first()),
    "workspace": ws.slug if ws else None,
    "identifier": p.identifier if p else None,
}))' 2>/dev/null | tr -d '\r' | sed -n 's/^STATE|//p' | tail -1)"

if [ -z "${STATE}" ]; then
  bad "project-pln-bootstrap — could not read the instance state (is the database migrated?)"
  FAILED=1
else
  printf '%s' "${STATE}" | python3 -c '
import json, sys
d = json.load(sys.stdin)
need = {"setup_done": True, "admins": 1, "declared_ws": True, "declared_project": True,
        "owner_is_member": True, "onboarded": True, "telemetry": False}
wrong = {k: d.get(k) for k, v in need.items() if d.get(k) != v}
if not d.get("workspace") or not d.get("identifier"):
    wrong["workspace/project"] = None
detail = "workspaces=%s projects=%s states=%s users=%s admins=%s" % (
    d.get("workspaces"), d.get("projects"), d.get("states"), d.get("users"), d.get("admins"))
if d.get("dangling_admins"):
    # Plane SET_NULL residue from deleting an admin user. Leftover rows are worth naming and are
    # NOT a failure: deleting a user is a legitimate operation, and the live owner is unaffected.
    detail += " (%s admin row(s) point at a deleted user)" % d["dangling_admins"]
print("OK|" + detail if not wrong else "NO|" + detail + " — wrong: " + json.dumps(wrong))
' > /tmp/pln-verify.$$ 2>/dev/null
  if grep -q '^OK|' /tmp/pln-verify.$$; then
    ok "project-pln-bootstrap — declared state in place ($(sed 's/^OK|//' /tmp/pln-verify.$$))"
  else
    bad "project-pln-bootstrap — $(sed 's/^NO|//' /tmp/pln-verify.$$)"
    FAILED=1
  fi
  rm -f /tmp/pln-verify.$$
fi

# ── 2b. the office's own sign-in is Plane's (DGO-371) ───────────────────────────────────────────
# A person who has already signed in to the office must not be asked for a second sign-in by this
# app. Four facts, in the order they fail, and each is the one the NEXT check assumes:
#   · the middleware is in the IMAGE (a hand-patched container is not a fix)
#   · the declared map is APPLIED, and every account it names exists and is active
#   · a hand-written identity header is NOT a door — the acceptance of DGO-371 itself
#   · the identity service this app asks is answering (302 to a stranger = answering, refusing)
# The positive half — a browser carrying the office's cookie lands in the workspace, with no form —
# is not reproducible here without a browser session, and is proven with the acceptance screenshots
# recorded on DGO-371.
SSO="$(dcx exec -T "${SVC}" ${MANAGE} shell -c '
import json, os
from django.conf import settings
from plane.db.models import User
path = os.environ.get("PLANE_SSO_MAP") or "/app/data/office-identity.json"
try:
    declared = (json.load(open(path, encoding="utf-8")) or {}).get("users") or []
except (OSError, ValueError):
    declared = []
missing = [e.get("plane") for e in declared
           if not User.objects.filter(email__iexact=str(e.get("plane") or ""), is_active=True).exists()]
print("SSO|" + json.dumps({
    "wired": any("office_identity" in m for m in settings.MIDDLEWARE),
    "declared": len(declared),
    "missing": missing,
}))
' 2>/dev/null | tr -d '\r' | grep '^SSO|' | tail -1)"
if [ -z "${SSO}" ]; then
  bad "project-pln-sso — could not read the office-identity state (is the API serving?)"
  FAILED=1
elif printf '%s' "${SSO}" | grep -q '"wired": true'; then
  DECL="$(printf '%s' "${SSO}" | sed -n 's/.*"declared": \([0-9]*\).*/\1/p')"
  MISSING="$(printf '%s' "${SSO}" | sed -n 's/.*"missing": \[\(.*\)\].*/\1/p')"
  if [ -n "${MISSING}" ]; then
    bad "project-pln-sso — the declared office identity maps to ${MISSING}, which is not an active Plane account"
    FAILED=1
  elif [ "${DECL}" = "0" ]; then
    warn "project-pln-sso — no office identity is declared (bootstrap.yaml → sso:), so the office's own sign-in is off and Plane's password is the only door"
  else
    ok "project-pln-sso — ${DECL} declared office identity(ies) sign in without Plane's password"
  fi
else
  bad "project-pln-sso — the middleware is not wired into MIDDLEWARE: the image is not the fix"
  FAILED=1
fi

# …and the header a neighbour container can write is worth nothing. Asked at the API with a
# hand-written identity and no cookie at all: the answer must be a refusal, and above all it must
# not carry a session cookie (that cookie IS the signed-in state).
FORGED="$(dcx exec -T "${SVC}" sh -c 'curl -s -D - -o /dev/null -H "X-authentik-username: akadmin" \
  -H "X-authentik-email: ci@example.com" -H "X-authentik-jwt: forged" http://127.0.0.1/api/users/me/ \
  | tr -d "\r" | tr "A-Z" "a-z"' 2>/dev/null | tail -20)"
case "${FORGED}" in
  *"set-cookie: session-id"*)
    bad "project-pln-sso-forged — a hand-written X-authentik-username was given a session: any container on the office network can sign in"
    FAILED=1 ;;
  *" 401 "*|http/1.1\ 401*)
    ok "project-pln-sso-forged — a hand-written identity header is refused (401, no session cookie)" ;;
  *)
    warn "project-pln-sso-forged — unexpected answer to a forged identity header ($(printf '%s' "${FORGED}" | head -1))" ;;
esac

# ── 2c. a request that crossed a LINK is signed by the door (DGO-545) ───────────────────────────
# The other half of "no second sign-in": a browser on a LINKED office's console carries no cookie of
# this office's provider — it was authenticated by that office, and its request arrives through the
# link's door, which writes this office's mapped user and SIGNS it with the pair's own secret
# (`apps/dgo-extend/link-proxy.py`). Both directions are asserted here, and they are the whole
# contract: a request whose signature is computed from this office's own vault secret is signed in;
# one whose signature does not match gets no session at all. The signature is computed INSIDE the
# container, from the vault, exactly as the door computes it — so this check is also the proof that
# the two implementations of the format still agree.
DOOR_SIG="$(dcx exec -T "${SVC}" python3 -c '
import hashlib, hmac, json, os, time, urllib.request
base = (os.environ.get("CONNECTIONS_URL") or "http://connections:8990").rstrip("/")
def get(path):
    with urllib.request.urlopen(base + path, timeout=8) as r:
        return json.loads(r.read() or b"{}")
office, token = "", ""
for row in (get("/api/instances?protocol=dgo_link").get("instances") or []):
    iid = str(row.get("id") or "")
    # a PAIRING row, `dgo_link-<office>`, and its office whole: an office id carries hyphens (hp-laptop), and the
    # checker matches it exactly (office_identity.names_office, hos-005); an agent credential is not a pair
    if not iid.startswith("dgo_link-") or (iid.startswith("dgo_link-serve-") and iid.endswith("-agent")):
        continue
    peer = iid[len("dgo_link-"):]
    sec = get("/api/instances/" + iid + "/secret").get("secret") or {}
    office, token = str(sec.get("peer") or peer), str(sec.get("token") or "")
    if office == peer and token:
        break
    office, token = "", ""
user = ""
try:
    users = (json.load(open("/app/data/office-identity.json", encoding="utf-8")) or {}).get("users") or []
    names = (users[0].get("authentik") or []) if users else []
    user = str(names[0] if names else "")
except (OSError, ValueError, IndexError, KeyError):
    user = ""
if not (office and token and user):
    print("UNSIGNED")
else:
    ts = int(time.time())
    mac = hmac.new(token.encode("utf-8"), ("v1\n" + office + "\n" + user + "\n" + str(ts)).encode("utf-8"),
                   hashlib.sha256).hexdigest()
    print("v1 " + office + " " + user + " " + str(ts) + " " + mac)
' 2>/dev/null | tr -d '\r' | tail -1)"
if [ -z "${DOOR_SIG}" ] || [ "${DOOR_SIG}" = "UNSIGNED" ]; then
  warn "project-pln-link-identity — no link secret in this office's vault, so the door's signature cannot be checked here (a single-office install: nothing to prove)"
else
  # The positive half: the door's own request, at the API, with no cookie of any kind.
  DOORED="$(dcx exec -T -e DOOR_SIG="${DOOR_SIG}" "${SVC}" sh -c 'curl -s -D - -o /dev/null \
    -H "X-Dgo-Identity: ${DOOR_SIG}" -H "X-Dgo-Office: vps1" -H "Host: plane.localhost" \
    http://127.0.0.1/api/users/me/ | tr -d "\r" | tr "A-Z" "a-z"' 2>/dev/null | tail -20)"
  case "${DOORED}" in
    *"set-cookie: session-id"*|*" 200 "*)
      ok "project-pln-link-identity — a request signed by the link's door enters the workspace (no form)" ;;
    *)
      bad "project-pln-link-identity — a signed request from a linked office was refused: opening Plane from a linked console asks for a password again (DGO-545)"
      FAILED=1 ;;
  esac
  # …and the negative half: the same shape with a signature that does not match the secret.
  FORGED_SIG="$(printf '%s' "${DOOR_SIG}" | sed 's/.\{8\}$/00000000/')"
  faked="$(dcx exec -T -e DOOR_SIG="${FORGED_SIG}" "${SVC}" sh -c 'curl -s -D - -o /dev/null \
    -H "X-Dgo-Identity: ${DOOR_SIG}" -H "Host: plane.localhost" \
    http://127.0.0.1/api/users/me/ | tr -d "\r" | tr "A-Z" "a-z"' 2>/dev/null | tail -20)"
  case "${faked}" in
    *"set-cookie: session-id"*)
      bad "project-pln-link-identity-forged — a signature that does not match the link's secret was given a session"
      FAILED=1 ;;
    *)
      ok "project-pln-link-identity-forged — a signature that does not match is refused (no session cookie)" ;;
  esac
  # …and the token API (`/api/v1/…`) — the one a CLI or an agent reads — is open to that same proved
  # identity and to no other: a linked office's agent has no key of ours, and this is the exact
  # request that answered `401 Authentication credentials were not provided` before
  # `patches/api-door-identity.py` (measured on vps1, 2026-10-13 — the app was reachable through the
  # link and the work items were not).
  TOKENIZED="$(dcx exec -T -e DOOR_SIG="${DOOR_SIG}" "${SVC}" sh -c 'curl -s -o /dev/null -w "%{http_code}" \
    -H "X-Dgo-Identity: ${DOOR_SIG}" -H "Host: plane.localhost" \
    http://127.0.0.1/api/v1/workspaces/bina/projects/' 2>/dev/null | tr -d '\r' | tail -1)"
  case "${TOKENIZED}" in
    200) ok "project-pln-link-api — the token API answers a signed link request (no key needed)" ;;
    *) bad "project-pln-link-api — /api/v1/ answered '${TOKENIZED:-nothing}' to a signed link request: an agent of a linked office cannot read the work items (lnk-027)"
       FAILED=1 ;;
  esac
  # …and the same path with no signature at all must stay closed.
  UNSIGNED="$(dcx exec -T "${SVC}" sh -c 'curl -s -o /dev/null -w "%{http_code}" -H "Host: plane.localhost" \
    http://127.0.0.1/api/v1/workspaces/bina/projects/' 2>/dev/null | tr -d '\r' | tail -1)"
  case "${UNSIGNED}" in
    200)
      bad "project-pln-link-api-unsigned — the token API answered an UNSIGNED request: it is open to anyone who can reach the container"
      FAILED=1 ;;
    *) ok "project-pln-link-api-unsigned — with no signature the token API still refuses (${UNSIGNED})" ;;
  esac
fi

# The service the middleware asks. A stranger's request (no cookie) is answered with a redirect to
# the office's authorization endpoint — an answer means the dependency is up; a timeout means this
# app cannot sign anybody in, and it says so instead of looking broken in the console.
# Which service: the office's DGO_IDENTITY, as the middleware picks it (office_identity.PROVIDERS). The
# host asked about is this office's own Plane host (DOMAIN_NAME): forward-auth answers 400, not a
# redirect, for a host its office does not serve, so `plane.localhost` on a real domain reads as down.
ASKED="$(dcx exec -T "${SVC}" sh -c 'case "${DGO_IDENTITY:-}" in
    forward-auth) u=http://forward-auth:9078/auth/traefik ;;
    *) u=http://authentik-server:9000/outpost.goauthentik.io/auth/traefik ;;
  esac
  curl -s -o /dev/null -w "%{http_code}" --max-time 8 \
  -H "X-Forwarded-Host: ${DOMAIN_NAME:-plane.localhost}" -H "X-Forwarded-Proto: http" -H "X-Forwarded-Uri: /" \
  "${PLANE_SSO_OUTPOST:-$u}"' 2>/dev/null | tr -d '\r' | tail -1)"
case "${ASKED}" in
  302|200) ok "project-pln-sso-provider — the office's identity service answers (${ASKED})" ;;
  *) bad "project-pln-sso-provider — the identity service answered '${ASKED:-nothing}': nobody can be signed in from the office"
     FAILED=1 ;;
esac

# ── 3. can the owner sign in? (the promise, end to end) ─────────────────────────────────────────
EMAIL="$(read_env PLANE_OWNER_EMAIL)"; EMAIL="${EMAIL:-$(read_env N8N_OWNER_EMAIL)}"
PASSWORD="$(read_env PLANE_OWNER_PASSWORD)"
if [ -z "${EMAIL}" ]; then
  bad "project-pln-login — no PLANE_OWNER_EMAIL (or N8N_OWNER_EMAIL) in .env, so nobody can be handed this instance"
  FAILED=1
elif [ -z "${PASSWORD}" ]; then
  bad "project-pln-login — no PLANE_OWNER_PASSWORD in .env; run ./bbox project-pln onboard"
  FAILED=1
else
  # The session that a browser would get, obtained the way the page obtains it: a CSRF token, then
  # the form. `error_code` in the redirect IS the failure (Plane reports "wrong password" and
  # "instance not configured" the same way: a 302 back to the sign-in page).
  LOGIN="$(dcx exec -T -e PLANE_CHECK_EMAIL="${EMAIL}" -e PLANE_CHECK_PASSWORD="${PASSWORD}" -e PLANE_CHECK_HOST="${HOSTHDR}" "${SVC}" sh -c '
    set -e
    jar="$(mktemp)"
    tok="$(curl -s -c "$jar" -H "Host: $PLANE_CHECK_HOST" http://127.0.0.1/auth/get-csrf-token/ | sed -n "s/.*\"csrf_token\":\"\([^\"]*\)\".*/\1/p")"
    [ -n "$tok" ] || { echo "NO_CSRF"; exit 0; }
    curl -s -b "$jar" -c "$jar" -o /dev/null -w "%{http_code} %{redirect_url}" -X POST \
      http://127.0.0.1/auth/sign-in/ -H "Host: $PLANE_CHECK_HOST" -H "Referer: http://$PLANE_CHECK_HOST/" \
      --data-urlencode "email=$PLANE_CHECK_EMAIL" --data-urlencode "password=$PLANE_CHECK_PASSWORD" \
      --data-urlencode "csrfmiddlewaretoken=$tok"
    rm -f "$jar"' 2>/dev/null | tr -d '\r' | tail -1)"
  unset PASSWORD
  # `error_code` FIRST. Plane answers a refused sign-in and a successful one the same way — a 302
  # back to the app — so matching "302" first calls an instance that refuses everyone a pass. (Found
  # by making this check fail on purpose: as written, it did not fail.)
  case "${LOGIN}" in
    *error_code*)
      if [ "${PLANE_OWNER_SET_PASSWORD:-$(read_env PLANE_OWNER_SET_PASSWORD)}" != "1" ]; then
        # The owner registered himself and keeps his own credentials (DGO-13): this deployment cannot
        # prove a sign-in it does not hold the password for, and calling that a failure would train
        # everyone to ignore the gate. The door that IS verifiable is the office SSO (DGO-11).
        warn "project-pln-login — ${EMAIL} keeps his own password (not verified here); the office SSO is the door"
        exit "${FAILED}"
      fi
      # The code is numeric (5065) and the human-readable half is error_message; name the latter.
      bad "project-pln-login — ${EMAIL} cannot sign in: the instance refused the credentials ($(printf '%s' "${LOGIN}" | sed -n 's/.*error_message=\([A-Z_]*\).*/\1/p'))"
      FAILED=1 ;;
    "302 "*)                        # 302 with no error_code — a real session
      ok "project-pln-login — ${EMAIL} signs in (302 to the app)" ;;
    *)
      bad "project-pln-login — sign-in for ${EMAIL} answered '${LOGIN}' (expected 302)"
      FAILED=1 ;;
  esac
fi

exit "${FAILED}"
