#!/usr/bin/env bash
#: repo <account> <repo> [ref] — one repository: its branches, its files at a ref:  ./bbox git repo <account> owner/name main
# Pipes the app's own CLI (apps/git/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help|"") sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T git python - repo "$@" < "$(npath "${REPO_ROOT}")/apps/git/cli.py"
