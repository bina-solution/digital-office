#!/usr/bin/env bash
#: repos [account] [query] — the repositories matching a query, among each account's 100 most recently pushed:  ./bbox git repos "" dgo
# Pipes the app's own CLI (apps/git/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T git python - repos "$@" < "$(npath "${REPO_ROOT}")/apps/git/cli.py"
