#!/usr/bin/env bash
#: state — what this app holds, one `<name> <value>` per line:  ./bbox git state
#: In the git service (data/git/state): the active account's pointer and the mirror registry, each 1 or 0. In the
#: forge (data/git/forge): its repositories and its sqlite database. Counts only: a number may grow between two reads,
#: a word may not change. The data move (platform/manager/datahome.py, DGO-2019) reads it before it moves a store and
#: again after, and sends the store back to its volume when what it held is gone. Plain sh: the forge has no python.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
# The data move names the container it measures; by hand, it is the office's own.
if [ -n "${DGO_STATE_CONTAINER:-}" ]; then
  inside() { docker exec -i "${DGO_STATE_CONTAINER}" "$@"; }
else
  . "${REPO_ROOT}/scripts/lib.sh"
  inside() { dcx exec -T git "$@"; }
fi
inside sh -s <<'SH'
if [ -d /data/gitea ]; then                 # the forge: its first start made it
  echo "forge.repos $(find /data/git/repositories -mindepth 2 -maxdepth 2 -type d -name '*.git' 2>/dev/null | wc -l)"
  echo "forge.db $([ -s /data/gitea/gitea.db ] && echo 1 || echo 0)"
else
  echo "active $([ -s /data/active.json ] && echo 1 || echo 0)"
  echo "mirrors.registry $([ -s /data/mirrors.json ] && echo 1 || echo 0)"
fi
SH
