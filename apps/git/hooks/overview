#!/usr/bin/env bash
#: overview — the forge, the repositories, the accounts and the mirrors, each naming its own failure:  ./bbox git overview
# Pipes the app's own CLI (apps/git/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T git python - overview < "$(npath "${REPO_ROOT}")/apps/git/cli.py"
