#!/usr/bin/env bash
#: connections — the mailboxes, and which one is selected:  ./bbox mail connections
# Pipes the app's own CLI (apps/mail/cli.py) into the mailview container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T mailview python - connections < "$(npath "${REPO_ROOT}")/apps/mail/cli.py"
