#!/usr/bin/env bash
#: connections — the mailboxes, and which one is selected, as the service's JSON:  ./bbox mail connections   (a table: ./bbox mail profile list)
# The app's one door (hooks/cli → apps/mail/cli.py), here or on the office that runs the mail.
exec bash "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cli" connections "$@"
