#!/usr/bin/env bash
#: inbox [N] [-p <mailbox>] — the newest N in the inbox, one line each (default 10):  ./bbox mail -p office@example.com inbox 5
# The app's one door (hooks/cli → apps/mail/cli.py, its answer through the operatives' formatter
# apps/mail/operatives/lines.py, which flattens what a sender wrote).
exec bash "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cli" inbox "$@"
