#!/usr/bin/env bash
#: history — a listened-to chat's last N messages, oldest first:  ./bbox telegram history <chat_id> [N]
# Pipes the app's own CLI (apps/telegram/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T telegram python - history "$@" < "$(npath "${REPO_ROOT}")/apps/telegram/cli.py"
