#!/usr/bin/env bash
#: media-save — a listened-to chat message's file, any size, into the office's drive:  ./bbox telegram media-save <chat_id> <message_id>
# The file is streamed from Telegram to the drive in pieces (DGO-1805): a 97 MB video costs the app one piece of
# memory. It lands at «טלגרם/<chat>/<message>-<name>»; the answer (JSON) carries its `path`. A file small enough to
# read in place is still `./bbox telegram media <chat_id> <message_id>`.
# Pipes the app's own CLI (apps/telegram/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T telegram python - media-save "$@" < "$(npath "${REPO_ROOT}")/apps/telegram/cli.py"
