#!/usr/bin/env bash
#: screenshot [out.png] — the running device's screen as a PNG (default android-screen.png):  ./bbox android-emulator screenshot
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
out="${1:-android-screen.png}"
dcx exec -T android-emulator python3 -c '
import sys, urllib.error, urllib.request
try:
    sys.stdout.buffer.write(urllib.request.urlopen("http://127.0.0.1:8080/api/screenshot", timeout=60).read())
except urllib.error.HTTPError as e:
    print(e.read().decode("utf-8", "replace"), file=sys.stderr); sys.exit(1)' > "${out}" || { rm -f "${out}"; exit 1; }
echo "${out}: $(wc -c < "${out}") bytes"
