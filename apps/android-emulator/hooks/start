#!/usr/bin/env bash
#: start [--by <who>] — ask for the device: it waits for the heat (under 80°C), then boots:  ./bbox android-emulator start
# The supervisor decides when (server/governor.py); this only asks. Who asked is on the status and on «כל מקביל».
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
by="cli"
[ "${1:-}" = "--by" ] && [ -n "${2:-}" ] && by="$2"
dcx exec -T -e "BY=${by}" android-emulator python3 -c '
import json, os, urllib.request
req = urllib.request.Request("http://127.0.0.1:8080/api/start", data=json.dumps({"by": os.environ["BY"]}).encode(), method="POST")
print(json.dumps(json.load(urllib.request.urlopen(req, timeout=10)), ensure_ascii=False, indent=1))'
