#!/usr/bin/env bash
#: status — is Signal's screen up, is the client running under it, and when does its build expire: [--json]
# Signal has no headless side to ask (app.json `wraps`), so this asks the desktop itself, through the image's
# own /usr/local/bin/signal-health (desktop/health), which is also the container's healthcheck: the front door
# answers inside the container, Signal Desktop's main process runs, and the build is not past the deadline
# Signal compiled into it. Whether the phone is linked is on the screen only.
# Exit 0 well / 1 the door does not answer, the client is not running, or the build has expired / 2 usage /
# 3 the screen's container is not running here.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
JSON=0
for a in "$@"; do
  case "${a}" in
    -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;;
    --json) JSON=1 ;;
    *) echo "signal status: unknown argument '${a}' (status [--json])" >&2; exit 2 ;;
  esac
done
running "signal-desktop-${DN}" || {
  [ "${JSON}" = 1 ] && echo '{"up": false, "client": false, "expires_in_days": null, "expired": false}'
  echo "signal is not running here (./bbox apps enable signal && ./bbox run)" >&2; exit 3; }
if [ "${JSON}" = 1 ]; then
  dcx exec -T signal-desktop signal-health --json; rc=$?
else
  dcx exec -T signal-desktop signal-health; rc=$?
fi
if [ "${rc}" -ne 0 ] && [ "${JSON}" = 0 ]; then
  # an expired build is not cured by a rebuild from the cache, which keeps the old Signal: the package step must run again
  echo "a Signal past its deadline needs a fresh package: ./scripts/dc build --no-cache signal-desktop && ./scripts/dc up -d signal-desktop" >&2
fi
[ "${rc}" -eq 0 ] && exit 0
exit 1
