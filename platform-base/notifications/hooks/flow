#!/usr/bin/env bash
#: flow — the notice board's events (a notice posted, its level), the last 10 and then live:  ./bbox notifications flow [-n N] [--once] [--json]
# The app's stream on the office's event stream (flow.v1, DGO-1402): the platform's reader, for `dgo:flow:notifications`.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec bash "${SCRIPT_DIR}/../../redis/hooks/flow" notifications "$@"
