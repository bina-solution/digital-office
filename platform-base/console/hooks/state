#!/usr/bin/env bash
#: state — what this app holds, one `<name> <value>` per line:  ./bbox console state
#: The ledger of the links a person was given and of every time each was opened again (ledger.jsonl, DGO-1433): its
#: lines, appended and never edited. The data move (platform/manager/datahome.py, DGO-2019) reads it before it moves
#: data/console/links and again after, and sends the store back to its volume when the ledger is gone.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
# The data move names the container it measures; by hand, it is the office's own.
if [ -n "${DGO_STATE_CONTAINER:-}" ]; then
  inside() { docker exec -i "${DGO_STATE_CONTAINER}" "$@"; }
else
  . "${REPO_ROOT}/scripts/lib.sh"
  inside() { dcx exec -T console "$@"; }
fi
inside python - <<'PY'
import os
f = os.path.join(os.environ.get("LINKS_DIR", "/app/links"), "ledger.jsonl")
try:
    with open(f, encoding="utf-8") as fh:
        print("links.lines", sum(1 for line in fh if line.strip()))
except FileNotFoundError:
    print("links.lines", 0)
PY
