#!/usr/bin/env bash
#: restore the identity provider's database from a `bbox export` archive
#
# restore <indir> <mode>   — invoked by scripts/deployment-archive.py, never by hand.
#
# AUTHENTIK_SECRET_KEY MUST MATCH, and the driver has already put .env in place before this runs.
# It is not merely a session-cookie key: authentik uses it to sign and to encrypt stored provider
# secrets, so a restore under a fresh key gives you every user, every group, every provider — and an
# instance that cannot decrypt its own OAuth client secrets. That failure surfaces as a login loop,
# not as an error, which is precisely the shape of restore this whole capability exists to prevent.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
. "${REPO_ROOT}/scripts/archive-lib.sh"   # archive_require / archive_stop / archive_project

IN="${1:?usage: restore <indir> <mode>}"
[ -f "${IN}/authentik.dump" ] || { echo "[authentik/restore] authentik.dump missing" >&2; exit 1; }
C="$(archive_require authentik-postgres)"
[ -n "${C}" ] || { echo "[authentik/restore] no authentik-postgres container running" >&2; exit 1; }
U="${AUTHENTIK_PG_USER:-authentik}"; D="${AUTHENTIK_PG_DB:-authentik}"

# Stop the app before dropping its database out from under it: authentik-server and -worker keep
# pooled connections, and `drop database` fails on an open connection rather than waiting.
archive_stop authentik-server authentik-worker authentik-bootstrap

PX() { docker exec "${C}" psql -U "${U}" -d postgres -tAc "$1"; }
PX "select pg_terminate_backend(pid) from pg_stat_activity where datname='${D}' and pid<>pg_backend_pid();" >/dev/null 2>&1 || true
PX "drop database if exists \"${D}\";" >/dev/null || { echo "[authentik/restore] drop failed" >&2; exit 1; }
PX "create database \"${D}\" owner \"${U}\";" >/dev/null || { echo "[authentik/restore] create failed" >&2; exit 1; }
docker exec -i "${C}" pg_restore -U "${U}" -d "${D}" --no-owner --no-acl < "${IN}/authentik.dump" \
  2> "${BBOX_TMP}/authentik-restore.err" || true
[ -s "${BBOX_TMP}/authentik-restore.err" ] && {
  echo "[authentik/restore] diagnostics (last 5):" >&2; tail -5 "${BBOX_TMP}/authentik-restore.err" >&2; }

q() { docker exec "${C}" psql -U "${U}" -d "${D}" -tAc "$1" 2>/dev/null | tr -d '\r' | tr -d ' '; }
echo "FACT users $(q 'select count(*) from authentik_core_user;')"
echo "FACT groups $(q 'select count(*) from authentik_core_group;')"
echo "FACT tokens $(q 'select count(*) from authentik_core_token;')"
echo "FACT providers $(q 'select count(*) from authentik_core_provider;')"
echo "FACT applications $(q 'select count(*) from authentik_core_application;')"
echo "FACT user_sha $(q "select md5(string_agg(username||coalesce(password,''), '|' order by username)) from authentik_core_user;")"
exit 0
