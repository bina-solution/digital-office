#!/usr/bin/env bash
#: state — what the office's sign-in holds, one `<name> <value>` per line:  ./bbox authentik state
#: In its database (data/authentik/db, read in authentik-postgres): the users, the applications and the flows — -1
#: for a table this version does not have. In authentik-server: the files of its uploads (data/authentik/media) and
#: of its email templates (data/authentik/templates). Counts only, never a name or a value. The data move
#: (platform/manager/datahome.py, DGO-2019) reads it before it moves a store and again after, and sends the store back
#: to its volume when what it held is gone. Plain sh: two images, each branch chosen by what its container mounts.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
# The data move names the container it measures; by hand, it is the office's own database.
if [ -n "${DGO_STATE_CONTAINER:-}" ]; then
  inside() { docker exec -i "${DGO_STATE_CONTAINER}" "$@"; }
else
  . "${REPO_ROOT}/scripts/lib.sh"
  inside() { dcx exec -T authentik-postgres "$@"; }
fi
inside sh -s <<'SH'
if [ -d /var/lib/postgresql/data ] && command -v psql >/dev/null 2>&1; then
  # the local socket, as its POSTGRES_USER role — every count in ONE query, each table looked up at run time
  # (query_to_xml): postgres resolves every table a query names before it runs it, a branch never taken included
  c() { printf "case when to_regclass('%s') is null then -1 else (xpath('/row/c/text()', query_to_xml('select count(*) as c from %s', false, true, '')))[1]::text::int end" "$1" "$1"; }
  n="$(PGPASSWORD="${POSTGRES_PASSWORD:-}" psql -U "${POSTGRES_USER:-authentik}" -d "${POSTGRES_DB:-authentik}" -tA -F' ' \
    -c "select $(c authentik_core_user), $(c authentik_core_application), $(c authentik_flows_flow)" 2>/dev/null)" || exit 0
  set -- ${n}
  [ "$#" = 3 ] || exit 0
  echo "db.users $1"; echo "db.applications $2"; echo "db.flows $3"
elif [ -d /media ]; then
  echo "media.files $(find /media -type f 2>/dev/null | wc -l)"
  echo "templates.files $(find /templates -type f 2>/dev/null | wc -l)"
fi
SH
