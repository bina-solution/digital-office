#!/usr/bin/env bash
#: ip <address> — one address: its hits, sign-ins and bans:  ./bbox security ip 203.0.113.9
# Pipes the app's own CLI (platform-base/security/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help|"") sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T security python - ip "$@" < "$(npath "${REPO_ROOT}")/platform-base/security/cli.py"
