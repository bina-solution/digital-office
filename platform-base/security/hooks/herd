#!/usr/bin/env bash
#: herd — every linked office's security summary:  ./bbox security herd
# Pipes the app's own CLI (platform-base/security/cli.py) into its container: no address, no key, no rebuild.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
case "${1:-}" in -h|--help) sed -n 's/^#: //p' "${BASH_SOURCE[0]}"; exit 0 ;; esac
dcx exec -T security python - herd < "$(npath "${REPO_ROOT}")/platform-base/security/cli.py"
