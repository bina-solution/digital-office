#!/usr/bin/env bash
#: restore error-tracking state (full-mode archives only)
#
# restore <indir> <mode>   — invoked by scripts/deployment-archive.py, never by hand.
#
# In config mode there is no dump and the correct behaviour is to say so and report nothing, so the
# driver has no FACTs to diff. Emitting zeros instead would manufacture a mismatch against the
# source's real counts and make a correct restore look broken.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
. "${REPO_ROOT}/scripts/lib.sh"
. "${REPO_ROOT}/scripts/archive-lib.sh"   # archive_require / archive_stop / archive_project

IN="${1:?usage: restore <indir> <mode>}"
if [ ! -f "${IN}/glitchtip.dump" ]; then
  echo "[glitchtip/restore] no dump in this archive (config mode) — hooks/prepare will provision on 'bbox run'"
  exit 0
fi
C="$(archive_require glitchtip-postgres)"
[ -n "${C}" ] || { echo "[glitchtip/restore] no glitchtip-postgres container running" >&2; exit 1; }
U="$(docker exec "${C}" printenv POSTGRES_USER 2>/dev/null | tr -d '\r')"; U="${U:-glitchtip}"
D="$(docker exec "${C}" printenv POSTGRES_DB   2>/dev/null | tr -d '\r')"; D="${D:-glitchtip}"

archive_stop glitchtip glitchtip-worker
PX() { docker exec "${C}" psql -U "${U}" -d postgres -tAc "$1"; }
PX "select pg_terminate_backend(pid) from pg_stat_activity where datname='${D}' and pid<>pg_backend_pid();" >/dev/null 2>&1 || true
PX "drop database if exists \"${D}\";" >/dev/null || exit 1
PX "create database \"${D}\" owner \"${U}\";" >/dev/null || exit 1
docker exec -i "${C}" pg_restore -U "${U}" -d "${D}" --no-owner --no-acl < "${IN}/glitchtip.dump" \
  2> "${BBOX_TMP}/glitchtip-restore.err" || true
[ -s "${BBOX_TMP}/glitchtip-restore.err" ] && {
  echo "[glitchtip/restore] diagnostics (last 5):" >&2; tail -5 "${BBOX_TMP}/glitchtip-restore.err" >&2; }

q() { docker exec "${C}" psql -U "${U}" -d "${D}" -tAc "$1" 2>/dev/null | tr -d '\r' | tr -d ' '; }
echo "FACT organizations $(q 'select count(*) from organizations_organization;')"
echo "FACT projects $(q 'select count(*) from projects_project;')"
echo "FACT project_keys $(q 'select count(*) from projects_projectkey;')"
echo "FACT issues $(q 'select count(*) from issue_events_issue;')"
exit 0
