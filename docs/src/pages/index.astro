---
// The site's root has no page of its own: Hebrew is the source (blueprint D2), so "/" sends the reader to /he/.
const to = `${import.meta.env.BASE_URL.replace(/\/*$/, '/')}he/`;
---
<!doctype html>
<html lang="he" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${to}`} />
		<link rel="canonical" href={new URL('he/', Astro.site).href} />
		<meta name="robots" content="noindex" />
		<title>הלשכה הדיגיטלית</title>
	</head>
	<body><a href={to}>{to}</a></body>
</html>
