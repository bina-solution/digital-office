#!/usr/bin/env python3
"""Apply the machine's performance profile (B1 of the perf-profiles design).

Reads PERFORMANCE_PROFILE from .env, loads platform/profiles/perf-profiles.yml, and applies the
profile through its TWO delivery mechanisms — one per kind of knob:

  1. `env:`      rewritten into .env as ONE marked block (# ── perf-profile:<name> (generated) ──),
                 duplicate definitions of profile-owned keys removed. Compose reads these at `up`.
  2. `settings:` substituted into the STAGED copies of the n8n workflows at push time (`--stage`),
                 per apps/n8n/perf-manifest.json. Repo files keep their defaults.

THERE IS NO THIRD MECHANISM, and there used to appear to be one. This script also upserted the
`settings:` block as perf_* rows into supabase's `public.settings` table, on the stated theory that
"workflows read them as perf_*". No workflow ever did. Measured 2026-07-30 against the live stack:

  * zero of the 82 live n8n workflows mention `perf_` anywhere in their node JSON;
  * zero tracked workflow JSON in the repo does either — the ONLY file in the tree that names a
    perf_* key is perf-manifest.json, which is this script's own substitution map;
  * `public.settings` held zero `perf%` rows, i.e. the table the deployment supposedly ran from was
    empty and nothing noticed.

So the rows were written for a reader that does not exist, while the substitution — the mechanism
that does the actual work — had been silently dead since commit 16b92ecd moved perf-manifest.json
from production/n8n/ to apps/n8n/ and this file kept the old path. `apply_stage` opens with
`if not os.path.exists(mf): return`, so every push since has staged workflows at their defaults and
said nothing. The dead half is deleted; the live half is repaired.

`--settings-only` is kept ONLY as an accepted no-op, because scripts/onboarding still passes it.

Exit 0 always when PERFORMANCE_PROFILE is unset (no-op). Env changes affect compose only
on the next `docker compose up -d` — the caller prints which services to re-up.
Zero third-party deps (hand-rolled 2-level YAML parse; the file is plain key: value).
"""
import os, re, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ENV = os.path.join(ROOT, '.env')
YML = os.path.join(ROOT, 'platform', 'profiles', 'perf-profiles.yml')
MARK_BEGIN = '# ── perf-profile:%s (generated by scripts/perf-profile-apply) ──'
MARK_ANY = re.compile(r'^# ── perf-profile:.*?──$')
MARK_END = '# ── end perf-profile ──'

def parse_profiles(path):
    profiles, cur, sect = {}, None, None
    for raw in open(path, encoding='utf-8'):
        line = raw.split('#', 1)[0].rstrip() if not raw.lstrip().startswith('#') else ''
        if not line.strip():
            continue
        indent = len(raw) - len(raw.lstrip())
        key, _, val = line.strip().partition(':')
        val = val.strip().strip("'\"")
        if indent == 0:
            cur = key; profiles[cur] = {'env': {}, 'settings': {}}; sect = None
        elif indent == 2 and not val:
            sect = key
        elif sect and val:
            profiles[cur][sect][key] = val
    return profiles

def env_get(key):
    for ln in open(ENV, encoding='utf-8', errors='replace'):
        if ln.startswith(key + '='):
            return ln.split('=', 1)[1].strip()
    return ''

def apply_stage(stage_dir, prof):
    """--stage <dir>: rewrite manifest-listed workflow knobs in the staged copies.

    THIS IS THE ONLY THING THAT DELIVERS A `settings:` KNOB TO A WORKFLOW. It therefore does not get
    to fail quietly. The manifest path was `production/n8n/perf-manifest.json` and the file moved to
    `apps/n8n/` in commit 16b92ecd; the missing-file branch below simply `return`ed, so from
    that commit onward every `bbox n8n push` staged the workflows at their defaults while the profile
    claimed otherwise — the same shape of failure the settings upsert was fixed for, one layer over.
    A manifest that is not where this file expects it is now a hard error.
    """
    import json as _json
    mf = os.path.join(ROOT, 'apps', 'n8n', 'perf-manifest.json')
    if not os.path.exists(mf):
        sys.exit(f'[perf-profile] stage: perf-manifest.json NOT FOUND at {mf} — no workflow knob '
                 f'can be applied. Every staged workflow would push at its default.')
    entries = [e for e in _json.load(open(mf, encoding='utf-8')) if 'file' in e]
    hits = 0
    for e in entries:
        knob, val = e['knob'], prof['settings'].get(e['knob'])
        if val is None:
            continue
        fp = os.path.join(stage_dir, e['file'])
        if not os.path.exists(fp):
            print(f'[perf-profile] stage: {e["file"]} not staged — skip {knob}'); continue
        wf = _json.load(open(fp, encoding='utf-8'))
        nodes = [n for n in wf['nodes'] if n['name'] == e['node']]
        if not nodes:
            print(f'[perf-profile] stage: node {e["node"]!r} missing in {e["file"]} — skip'); continue
        tgt = {'nodes0': nodes[0]}; cur = nodes[0]
        parts = e['path'].split('.')
        for p in parts[:-1]:
            cur = cur[int(p)] if p.isdigit() else cur[p]
        leaf = parts[-1]
        if e.get('template'):
            v = e['template'].replace('{v}', str(val))
        else:
            v = int(val) if e.get('cast') == 'int' else val
        cur[int(leaf) if leaf.isdigit() else leaf] = v
        _json.dump(wf, open(fp, 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
        hits += 1
        print(f'[perf-profile] stage: {e["file"]}::{e["node"]} {e["path"]} = {v}  ({knob})')
    print(f'[perf-profile] staged knobs applied: {hits}/{len(entries)}')

def main():
    name = env_get('PERFORMANCE_PROFILE')
    if not name:
        print('[perf-profile] PERFORMANCE_PROFILE unset — skipping (defaults everywhere)')
        return
    profiles = parse_profiles(YML)
    if name not in profiles:
        sys.exit(f'[perf-profile] unknown profile {name!r} (have: {", ".join(profiles)})')
    prof = profiles[name]

    if '--stage' in sys.argv:
        apply_stage(sys.argv[sys.argv.index('--stage') + 1], prof)
        return

    # `--settings-only` USED to mean "skip the .env half and write the perf_* rows instead", and it
    # existed because the two halves belonged at different moments: .env before containers start,
    # settings after the schema exists. The rows had no reader (see the module docstring), so there
    # is now only one non-stage half and this flag has nothing to select. It stays ACCEPTED and
    # explicitly does nothing, rather than being removed, because scripts/onboarding still passes it
    # — and falling through to the .env rewrite there would be worse than a no-op: onboarding runs
    # with the stack already up, so it would rewrite a file nothing is going to re-read and print a
    # "applies on next bring-up" note about a bring-up that already happened.
    if '--settings-only' in sys.argv:
        print('[perf-profile] --settings-only: nothing to do. The perf_* settings rows had no '
              'reader and the upsert was removed; workflow knobs are delivered by --stage at '
              '`bbox n8n push` (apps/n8n/perf-manifest.json).')
        return 0

    # `--env-only` is likewise now a synonym for the default. bbox passes it from ensure_perf_profile
    # to mean "do not touch the database at this point"; nothing here touches it any more.

    # ── 1. rewrite .env: drop old marked block + any duplicate owned keys, append fresh block
    owned = set(prof['env'])
    out, in_block = [], False
    for ln in open(ENV, encoding='utf-8', errors='replace'):
        s = ln.rstrip('\n')
        if MARK_ANY.match(s):
            in_block = True; continue
        if in_block:
            if s.strip() == MARK_END:
                in_block = False
            continue
        if '=' in s and not s.lstrip().startswith('#') and s.split('=', 1)[0] in owned:
            continue   # dedupe: the generated block owns this key
        out.append(ln.rstrip('\n'))
    while out and not out[-1].strip():
        out.pop()
    out.append('')
    out.append(MARK_BEGIN % name)
    for k, v in prof['env'].items():
        out.append(f'{k}={v}')
    out.append(MARK_END)
    open(ENV, 'w', encoding='utf-8').write('\n'.join(out) + '\n')
    print(f'[perf-profile] .env block written: {name} ({len(prof["env"])} keys, duplicates removed)')

    # ── 2. the CPU plan (gate G65): every enabled service's `cpus` cap at the scale that fits the
    # profile's host_cpus x cpu_overcommit. Rendered into .generated; lib.sh tells it to the running
    # containers after every `up` (docker update), and compose is handed only the caps this machine
    # cannot create. A profile without a CPU envelope renders nothing (G65 then fails in CI).
    import subprocess
    gen = os.path.join(ROOT, '.generated'); os.makedirs(gen, exist_ok=True)
    rc = subprocess.call([sys.executable, os.path.join(ROOT, 'scripts', 'refactor', 'cpu-budget-lint.py'),
                          '--profile', name, '--render', os.path.join(gen, 'cpu-budget.yml')])
    if rc != 0:
        print('[perf-profile] WARNING: cpu-budget overlay not rendered (see G65 output above)')

    print('[perf-profile] NOTE: env limits apply on next bring-up (apitools, n8n workers).')

if __name__ == '__main__':
    main()
