#!/usr/bin/env bash
# bbox — the deployment CLI. Single entry point for operating this self-hosted stack
# (n8n + apitools + authentik + browser42 + …). Runs on Linux: the Debian VPS in production, and the
# WSL distro on Windows — where the entry point is bbox.cmd, never Git-Bash (see scripts/lib.sh).
#
#   bbox <command> [args]              lifecycle: run | stop | reset | status | logs
#   bbox <group> <subcommand> [args]   groups: n8n | b42 | install
#   bbox onboarding [--auth-state]     first-run orchestration
#
# Thin dispatcher: delegates to scripts/* and existing tools; the blueprint (git) is the
# source of truth (see ai/context/automation-iac.md). Run `bbox help` for the full tree.
set -euo pipefail
# Physical (`pwd -P`): relative bind sources resolve against this path on the Docker host, and a
# symlinked spelling (/workspace/office inside bina-ds) is a path only the caller has — see lib.sh.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SCRIPTS="${REPO_ROOT}/scripts"
. "${SCRIPTS}/lib.sh"   # Git-Bash guard, engine selection, read_env, DN, colors, ok/warn/bad/log, running, pgq
say() { echo "${c1}[bbox]${c0} $*"; }
die() { echo "${cr}[bbox] error:${c0} $*" >&2; exit 1; }
dc()  { dcx "$@"; }   # compiled .generated/ file list + --project-directory (scripts/lib.sh)

# ── macOS: bbox runs INSIDE the project engine's guest, never on the host ────────────────────
# On macOS the engine is Docker 28 inside a Lima/vz Linux guest (packaging/macos/engine.yaml) —
# the twin of the WSL distro on Windows. The repo is mounted at the same path in the guest, so
# every verb is handed across exactly as bbox.cmd hands to WSL: one checkout, one engine, and every
# Linux assumption in this file (systemd drop-in, /run/bbox-docker.sock, GNU coreutils) holds
# unchanged. Docker Desktop is never used. Only the engine's own lifecycle runs on the host:
# `bbox engine …` and its alias `bbox install macos`. See packaging/macos.md.
if [ "$(uname -s 2>/dev/null)" = Darwin ] && [ -z "${BBOX_IN_GUEST:-}" ]; then
  case "${1:-}" in
    engine)  shift; exec bash "${REPO_ROOT}/packaging/macos/engine.sh" "$@" ;;
    install) [ "${2:-}" = macos ] && exec bash "${REPO_ROOT}/packaging/macos/engine.sh" start ;;
    # The office agent's CLI runs HERE, on the host: it is plain python speaking agent.v1 to the
    # provider on 127.0.0.1 (Lima forwards the guest's loopback port), so there is nothing to hand
    # across. Measured 2026-09-30: through the guest, a call cost a hand-off, two bash start-ups and
    # four docker round trips before the first byte — minutes under load; natively it is one socket.
    agent)   shift; exec python3 "$(npath "${REPO_ROOT}/scripts")/agent.py" "$@" ;;
  esac
  exec bash "${REPO_ROOT}/packaging/macos/engine.sh" exec -- ./bbox "$@"
fi

# ensure_project_engine — make the PROJECT ENGINE answer on ${BBOX_DOCKER_SOCK}.
#
# Vocabulary, because conflating these is what makes this hard to read: `docker` is the CLI, which
# does no work and only dials a socket; `dockerd` is the ENGINE, which owns the images, containers
# and volumes; a socket is just an address. The PROJECT ENGINE is the one dockerd this stack uses.
# Docker Desktop's engine is a different dockerd with its own data — never used.
#
# Why a private address at all: Docker Desktop's WSL integration re-binds /var/run/docker.sock
# INSIDE the distro, so that address does not reliably reach the project engine. See the long note
# on bbox_select_engine in scripts/lib.sh.
#
# There are exactly TWO cases here, and the difference is not "which engine" — it is "does an engine
# exist yet":
#
#   1. An engine is already running (VPS, WSL) → teach IT the extra address. Never start a second
#      one: two dockerds sharing /var/lib/docker corrupt it, and two engines cannot both publish
#      :80 for traefik anyway.
#   2. No engine exists at all (the cloud sandbox boots without one) → start one. You cannot add a
#      flag to a service that does not exist.
#
# A dedicated engine with its own data-root is deliberately NOT an option: it would be no more
# isolated from Docker Desktop than the project engine already is, and it would start empty, so
# every image would rebuild and every volume would need migrating.
ensure_project_engine() {
  local sock="${BBOX_DOCKER_SOCK:-/run/bbox-docker.sock}" sudo=""
  # ROOT IS A ONE-TIME BOOTSTRAP COST, NOT AN ONGOING REQUIREMENT. Creating the address needs root
  # once; after that the socket is root:docker rw, so any user in the `docker` group runs the stack
  # with no privilege at all. This is not a third behaviour — it is the message you get before the
  # first successful provision.
  #
  # Establish privilege up front rather than discovering it halfway through: the old form set
  # sudo="sudo -n" without checking it works, so an unprivileged run got a raw "permission denied"
  # from tee and a half-written drop-in. Nothing here is required for the stack to come up — the
  # selector still finds whatever engine answers — so this degrades to one honest line.
  if [ "$(id -u)" != 0 ]; then
    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
      sudo="sudo -n"
    else
      say "${cy}cannot provision ${sock} (needs root or passwordless sudo) — using whichever daemon answers${c0}"
      return 0
    fi
  fi

  # systemd host (Debian VPS, modern WSL): extend the unit that already owns the data-root.
  if command -v systemctl >/dev/null 2>&1 && systemctl cat docker.service >/dev/null 2>&1; then
    local dir=/etc/systemd/system/docker.service.d conf want
    want="$(printf '%s\n' '[Service]' \
      'Environment=DOCKER_MIN_API_VERSION=1.24' \
      'ExecStart=' \
      "ExecStart=/usr/bin/dockerd -H fd:// -H unix://${sock} --containerd=/run/containerd/containerd.sock")"
    conf="${dir}/10-bbox-endpoint.conf"
    # Only rewrite+restart when it actually differs — otherwise every `bbox run` would bounce the
    # daemon and take all 39 containers with it.
    if [ "$(${sudo} cat "${conf}" 2>/dev/null)" != "${want}" ]; then
      say "teaching docker.service to listen on ${sock}…"
      ${sudo} mkdir -p "${dir}"
      printf '%s\n' "${want}" | ${sudo} tee "${conf}" >/dev/null
      ${sudo} systemctl daemon-reload
      ${sudo} systemctl restart docker.service
    fi
    for _ in $(seq 1 30); do [ -S "${sock}" ] && break; sleep 1; done
    return 0
  fi

  # No systemd (cloud sandbox, older WSL): we own the daemon, so start it ourselves — on the
  # project socket AND the conventional one.
  #
  # `setsid`, not just `nohup`. nohup only ignores SIGHUP; the process stays in the caller's
  # SESSION, and when that session is torn down the whole group goes with it. Measured on WSL,
  # where a `wsl.exe -- <cmd>` invocation owns a session: dockerd started with nohup died minutes
  # after the invoking shell went away, and took all 37 containers down with it — cleanly, as
  # `Exited (0)`, which reads like somebody ran `bbox stop`. Any environment where this runs
  # detached from a login shell has the same exposure.
  say "no docker daemon — starting dockerd on ${sock} (DOCKER_MIN_API_VERSION=1.24)…"
  if command -v setsid >/dev/null 2>&1; then
    ${sudo} setsid env DOCKER_MIN_API_VERSION=1.24 dockerd -H "unix://${sock}" -H unix:///var/run/docker.sock >"${BBOX_TMP:-/tmp}/dockerd.log" 2>&1 </dev/null &
  else
    ${sudo} env DOCKER_MIN_API_VERSION=1.24 nohup dockerd -H "unix://${sock}" -H unix:///var/run/docker.sock >"${BBOX_TMP:-/tmp}/dockerd.log" 2>&1 &
  fi
  for _ in $(seq 1 30); do [ -S "${sock}" ] && break; sleep 1; done
}

need_docker() {
  command -v docker >/dev/null 2>&1 || die "docker not found — run: bbox install <debian|windows>"
  # Provision the project endpoint BEFORE selecting, not as a fallback after Desktop has already
  # taken /var/run/docker.sock. Selecting first would bind this run to the conventional socket
  # whenever Desktop happens to be closed, and the NEXT run — Desktop now open — would resolve
  # somewhere else. Same stack, same host, different engine depending on whether a GUI was running.
  # Provisioning first makes the choice independent of that entirely. It is idempotent: the drop-in
  # is only rewritten when it differs, so this is a no-op on every run after the first.
  if [ ! -S "${BBOX_DOCKER_SOCK:-/run/bbox-docker.sock}" ] && command -v dockerd >/dev/null 2>&1; then
    ensure_project_engine || true
  fi
  # Resolves and EXPORTS DOCKER_HOST to an endpoint that is provably not Docker Desktop.
  bbox_select_engine && return 0
  # Nothing of ours answers: either no daemon at all, or the only one answering is Docker
  # Desktop's, which is not ours to deploy into.
  command -v dockerd >/dev/null 2>&1 && { ensure_project_engine; bbox_select_engine && return 0; }
  # Still nothing of ours. dockerd is absent, or it is up but only Docker Desktop answers and the
  # project endpoint could not be provisioned (no root, no systemd, no dockerd binary).
  #
  # DOCKER_MIN_API_VERSION only helps up to Docker 28. On 29 the daemon's hard minimum is 1.40 and
  # the variable is capped there, so the flag ensure_project_engine sets is accepted and silently
  # does nothing — traefik v3.3's 1.24 client is refused, the docker provider never loads, and every
  # *.localhost host 404s while traefik reports healthy. If that happens the daemon is what to
  # change, not the flag; run Docker 28.x, which is what the production VPS runs.
  die "the project engine is not reachable (tried ${BBOX_DOCKER_SOCK:-/run/bbox-docker.sock}, \$DOCKER_HOST, /var/run/docker.sock). Docker Desktop's engine, if running, is deliberately NOT used: every image and volume this stack owns belongs to the project engine. Start the docker service, or set BBOX_DOCKER_HOST to choose an endpoint explicitly."
}
# ensure_network and run_app_hooks moved to scripts/lib.sh — `scripts/onboarding` needs both, and
# a second copy of either is how the two paths drift.
#
# ensure_volumes is GONE, and both premises of the comment that justified it were false.
#
# It created a bare `wa_media` because that volume was `external: true` and shared with
# development/agent-runner. Neither holds now: apps/chat/docker-compose.yml declares `wa_media: null`
# under a comment that says exactly why — "NOT `external: true` … Only this app writes it, nothing
# pre-seeds it, nothing shares it, so compose should own it exactly like mail_state or n8n_storage"
# — and development/agent-runner was deleted with attic/. The compose file was fixed; this was not.
#
# Measured cost of leaving it: the engine carried BOTH `deployment-hacohen_wa_media` (compose's, the
# real one chat uses) and a bare `wa_media` that bbox minted on every run and nothing ever read.
#
# A volume belongs to the app that declares it — chat already declares it in app.json's
# `data.volumes`, which is the contract app-management's _remove_volumes reads on uninstall.
# traefik REFUSES to use its ACME account if acme.json is group/world readable:
#   "unable to get ACME account: permissions 644 for /etc/traefik/acme.json are too open, please use 600"
# and the consequence is not a warning — it SKIPS the resolver, so every router that names
# `myresolver` falls back to traefik's self-signed TRAEFIK DEFAULT CERT and the whole deployment
# serves an untrusted certificate. The site works; the browser warns; nothing says why.
#
# The file is GITIGNORED (it accumulates the ACME account key and every issued TLS private key), and
# git could not carry the mode anyway — it records only the executable bit, so while this was tracked
# every clone landed at 644 and no deployment could obtain a real certificate on first bring-up.
# Creating it here at 0600 is therefore the only place the mode can live.
# .generated/ is COMPILED from apps/*/app.json + platform.state.yaml, and it is gitignored — so it
# is the one part of a deployment that `git pull` cannot update. compose_args() (scripts/lib.sh)
# renders it only when it is MISSING, which self-heals a fresh clone and nothing else: a compiled
# config that is merely STALE is used forever.
#
# That is not a cosmetic staleness. Rename an app — as `whatsapp-hacohanim` -> `chat` did — and the
# stale include list still names apps/whatsapp-hacohanim/docker-compose.yml. Compose does not skip a
# missing include; it ABORTS THE WHOLE `up` with "no such file or directory" and starts ZERO
# services. Observed on the 2026-07-29 from-scratch re-stage: pull, `bbox onboarding`, and not one
# container came up. Add an app instead of renaming one and it is worse — the bring-up succeeds and
# silently runs the OLD topology.
#
# So render on bring-up, with the same guarantee ensure_network gives, and FAIL rather
# than continue: bringing the stack up on a configuration that does not match the repo is the exact
# fault this prevents. `bbox rollback` deliberately does not come through here — it restores an
# older .generated/ ON PURPOSE, and re-rendering would silently undo it.
ensure_rendered() {
  ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py render ) >/dev/null \
    || die "reconcile render failed — refusing to bring up a stale .generated/ (run: python3 platform/manager/reconcile.py render)"
}
# A FRESH GlitchTip is EMPTY: 0 orgs, 0 projects, 0 DSN keys, 0 API tokens. In that state the
# whole alert path is dead in both directions — every app's Sentry event is REJECTED (no project
# key to authenticate against) and `notifications` (התראות) gets 401 from the issues API (no
# token), so it polls nothing. `glitchtip-push` closes both, but it was only ever invoked from
# scripts/ci-verify.sh — never from bring-up. So every non-CI deployment ran with a decorative
# GlitchTip: containers healthy, dashboards up, alert path dead. That is exactly what bit us on
# 2026-07-17 — ~1,700 real errors, התראות showed 0.
#
# So provision it from bring-up, with the same guarantee ensure_network gives.
# Idempotent by construction: the ORM work is get_or_create and the DSN public keys are
# DETERMINISTIC (sha256(GLITCHTIP_SECRET_KEY:name)), so re-running rewrites the same values and
# the DSNs already in .env stay valid across `down -v`. Runs unconditionally rather than
# only-if-empty: it is also the self-heal when .env lost the values but the DB still has them.
# The compose files size some services (apitools, n8n workers) for a big prod host: their
# deploy.resources.limits.cpus is env-driven (APITOOLS_CPUS etc.), and perf-profile-apply is a NO-OP
# when PERFORMANCE_PROFILE is unset — so a clean `cp .env.ex .env && bbox run` leaves them at the
# compose defaults (apitools cpus 4), and `docker compose up` then ABORTS on any host with fewer
# cores: "range of CPUs is from 0.01 to 2.00". A fresh install must size itself to the host. If the
# operator has not chosen a profile, pick one by core count and apply it before compose up.
#
# --env-only, because at THIS point no container is running. The profile's other half writes 8 perf
# knobs into INDOX's `settings` table, which does not exist until the schema migration runs during
# onboarding — so from bring-up it could only ever fail, and it did, on every from-scratch install:
# "settings upsert (8 keys): ERROR: relation settings does not exist". Invisibly, because of the
# `>/dev/null 2>&1` below. scripts/onboarding applies the settings half once the schema is there.
ensure_perf_profile() {
  if grep -qE "^PERFORMANCE_PROFILE=.+" "${REPO_ROOT}/.env" 2>/dev/null; then
    python3 "$(npath "${SCRIPTS}")/perf-profile-apply" --env-only >/dev/null 2>&1 || true
    bbox_clamp_cpus_to_host
    # A profile somebody chose is applied — and when it is not the one this machine would be given,
    # that is SAID, once, in one line. It was silent, and an office could run for days on a profile
    # nobody had picked for it: hp-laptop (6 cores, a 9.7 GiB VM) ran `ci-small`, the default the
    # .env generator writes for CI, while the selector's answer for it is `wsl-10g`.
    local cur fit
    cur="$(grep -E '^PERFORMANCE_PROFILE=.+' "${REPO_ROOT}/.env" | tail -1 | cut -d= -f2- | tr -d "\"'[:space:]")"
    fit="$(python3 "$(npath "${REPO_ROOT}")/platform/manager/select-profile.py" 2>/dev/null || true)"
    if [ -n "${fit}" ] && [ "${fit}" != "${cur}" ]; then
      say "profile: ${cur} (set in .env) — this machine ($(ncores) cores) would be sized ${fit}; PERFORMANCE_PROFILE=${fit} in .env adopts it"
    fi
    return 0
  fi
  # Resolve from the `requires:` envelope declared by each profile in perf-profiles.yml — cores
  # AND memory. This replaced:
  #     prof="prod"; [ $n -le 4 ] && prof="vps"; [ $n -le 2 ] && prof="ci-small"
  # which selected on core count alone and never looked at memory, even though every profile has
  # always declared host_mem. A 6-core / 9.7 GiB WSL2 VM was therefore handed `prod` (host_mem:
  # 16G) and the whole stack was sized for 65% more memory than the machine has — the origin of
  # APITOOLS_MEM=8G on a 9.7 GiB box, and of a declared-limit sum at 4.46x physical.
  #
  # Adding a profile must never require editing this function again: the envelope lives with the
  # profile. Do not reintroduce a hard-coded name or a `if mem > X` here.
  n="$(ncores)"
  prof="$(python3 "$(npath "${REPO_ROOT}")/platform/manager/select-profile.py" 2>/dev/null)"
  if [ -z "$prof" ]; then
    # Selector unavailable (no python3, missing file). Fall back to the SMALLEST profile, never
    # the largest: under-sizing is slow, over-sizing is what tears the host down.
    prof="ci-small"
    say "${cy}profile selector unavailable — falling back to the floor profile (${prof}).${c0}"
  fi
  say "no PERFORMANCE_PROFILE set — sizing to this host (${n} cores → ${prof})"
  printf '\nPERFORMANCE_PROFILE=%s\n' "$prof" >> "${REPO_ROOT}/.env"
  python3 "$(npath "${SCRIPTS}")/perf-profile-apply" --env-only >/dev/null 2>&1 || say "${cy}perf-profile-apply had a warning — check cpus limits vs host${c0}"
  # and clamp on THIS path too: a machine that had no profile yet is precisely the one that has
  # never been sized to itself, and docker ABORTS `up` on a single limit above the host's cores.
  bbox_clamp_cpus_to_host
}
# ensure_sso_current — sign-in serves the hosts this deployment declares NOW, not the set its server
# loaded at boot. The condition, the probe and the cure are the sign-in app's own
# (`<its dir>/hooks/refresh`, where the whole story is written down); this only says WHEN, and
# reaches that app by the ROLE it plays — whichever enabled app provides `forward-auth` — the same
# lookup `ensure_converged` makes for the control plane, so no app is named here (gate G31). The
# control plane runs the same hook after it compiles a new host, which is why it is a hook and not
# a function of this file: a host declared from the apps screen needs it as much as one declared
# from this CLI.
ensure_sso_current() {
  local id root hook
  id="$(cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py capability-provider --capability forward-auth 2>/dev/null)"
  [ -n "${id}" ] || return 0
  for root in platform-base apps; do
    hook="${REPO_ROOT}/${root}/${id}/hooks/refresh"
    [ -x "${hook}" ] && { bash "${hook}" || true; return 0; }
  done
  return 0
}
# ensure_converged — every enabled app's declared state is REAL, as part of `bbox run` itself.
#
# THE GAP THIS CLOSES. AGENTS.md's own goal is "fully declarative — git clone + ./bbox run brings
# the whole stack live". It didn't: `bbox run` brought up containers and stopped, so an app that
# declares `blueprints.n8n` (its automations) had them imported only at the moment its state
# transitioned to enabled — never again. `bbox reset` wipes the volumes while platform.state.yaml
# still says enabled: n8n comes back with zero workflows, no transition fires because none
# happened, and nothing notices. A memory of exactly this ("bbox first run needs onboarding")
# existed because the platform never healed the gap it recorded.
#
# THE MECHANISM ALREADY EXISTS, correctly, in app-management — reconcile_once() (this repo's
# control-plane owner of "App lifecycle") walks every ENABLED app's OWN manifest, and for each one
# that declares blueprints.n8n, asks n8n whether it actually holds those workflows
# (_blueprint_present) before doing anything. Only a genuine gap triggers an import, scoped to that
# one app (`apps/n8n/hooks/push --app <id>`). This is NOT bbox re-deciding what an app
# needs — it is bbox asking the app that already owns that decision to act on its own answer.
#
# So this is one HTTP call to the control plane already running in the stack, not new logic here:
# POST /api/reconcile on app-management, documented "safe to call repeatedly; a converged estate
# reports nothing done" — which is exactly why calling it on EVERY `bbox run` costs nothing extra
# on an already-provisioned stack (one bounded round of presence checks, no imports, no restarts)
# and does the real work exactly when something is actually missing.
ensure_converged() {
  # Reached by CAPABILITY, not by name — bbox does not know which app is the control plane, only
  # that whichever enabled app declares "control-plane" (if any) is the one to ask. Resolving that
  # is the manifest-aware compiler's job, not the CLI's; hardcoding the app id here is precisely the
  # layer-0-carries-app-knowledge defect gate G31 (layer0-lint) exists to catch.
  local cp_id; cp_id="$(cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py capability-provider --capability control-plane 2>/dev/null)"
  [ -n "${cp_id}" ] || return 0
  local am; am="$(cn "${cp_id}" 2>/dev/null)"
  [ -n "${am}" ] || return 0
  local out
  # [2026-08-23] A 500 FROM /api/reconcile IS A REPORT, NOT A CRASH — read the body.
  # app-management returns `jsonify(ok=not rep["errors"], **rep), (200 if not rep["errors"] else
  # 500)`, so a 500 means reconcile RAN and is telling us which apps failed to converge. urllib
  # raises HTTPError on 500, the old bare `except` printed "ERR HTTP Error 500: INTERNAL SERVER
  # ERROR", and the body — the only place the actual errors exist — was discarded.
  # Measured on a fresh `down -v` bring-up: that one opaque line was all the operator got, and the
  # consequence was concrete. Convergence is what imports every app's blueprints into n8n, and it
  # runs BEFORE the onboard hooks on purpose; when it silently failed, indox's onboard hook
  # reached for a workflow n8n did not have yet ("workflow not found: IndoxResetFull01") and the
  # blueprints only arrived later. The ordering was right the whole time. The failure was unread.
  out="$(docker exec "${am}" python3 -c '
import urllib.request, urllib.error
try:
    r = urllib.request.urlopen(urllib.request.Request(
        "http://127.0.0.1:8080/api/reconcile", data=b"", method="POST"), timeout=1200)
    print(r.read().decode())
except urllib.error.HTTPError as e:
    body = ""
    try:
        body = e.read().decode()[:2000]
    except Exception:
        pass
    print("ERR HTTP", e.code, body)
except Exception as e:
    print("ERR", e)
' 2>/dev/null)"
  case "${out}" in
    *'"converged": []'*|*'"converged":[]'*) : ;;   # nothing to do — the common case, say nothing
    ERR*) say "${cy}convergence check failed: ${out#ERR }${c0}" ;;
    *) say "converged: ${out}" ;;
  esac
}
# ── the app command surface, read from the apps themselves ────────────────────────────────────
# bbox must not contain a list of apps, their aliases, or their verbs. These three helpers derive
# all of it: app_resolve maps a CLI token to an app via `id` or the `cli.alias` the app declares;
# app_verbs lists the files in its hooks/ directory; app_help_block renders the help section. Add
# an app, or a verb, and the CLI picks it up with no edit here.
#
# `#:` is the convention for a hook's one-line summary — its first line after the shebang. Hooks
# without one still work; they simply appear without a description.

#: app_resolve <token> -> "<root> <id> <fallback-or-id>", non-zero when the token is not an app
app_resolve() {
  local tok="${1:?}"
  # npath: this path is an ARGUMENT to a native binary, and on Windows python3 mis-resolves the
  # /c/... form. Gate G10 catches exactly this.
  python3 - "$(npath "${REPO_ROOT}")" "${tok}" <<'PY' 2>/dev/null
import json, pathlib, sys
repo, tok = pathlib.Path(sys.argv[1]), sys.argv[2]
for root in ("apps", "platform-base"):
    for m in sorted((repo / root).glob("*/app.json")):
        try: d = json.loads(m.read_text(encoding="utf-8"))
        except Exception: continue
        cli = d.get("cli") or {}
        if tok == d.get("id") or tok == cli.get("alias"):
            print(f"{root} {d['id']} {cli.get('fallback') or d['id']}")
            raise SystemExit(0)
raise SystemExit(1)
PY
}

#: app_verbs <root> <id> — the app's verbs, i.e. the executable files in its hooks/ directory
app_verbs() {
  local d="${REPO_ROOT}/${1}/${2}/hooks"
  [ -d "${d}" ] || return 0
  # BASE NAMES: a verb is `doc-trace`, whether the file is doc-trace, doc-trace.py or doc-trace.mjs.
  # Listing raw filenames offered `.py` verbs nobody could type and hid the ones they could.
  ( cd "${d}" && ls 2>/dev/null | grep -v '^__pycache__$' | sed -E 's/\.(py|mjs|sh)$//' | sort -u )
}

app_verbs_line() { local v; v="$(app_verbs "$1" "$2" | tr '\n' ' ')"; [ -n "${v}" ] && printf '  (%s)' "${v% }"; }

#: app_help_block — the `apps` section of `bbox help`, generated from every app that has hooks
app_help_block() {
  local root aid alias tok verbs vb desc
  for root in apps platform-base; do
    for d in "${REPO_ROOT}/${root}"/*/hooks; do
      [ -d "${d}" ] || continue
      aid="$(basename "$(dirname "${d}")")"
      verbs="$(app_verbs "${root}" "${aid}")"
      [ -n "${verbs}" ] || continue
      alias="$(python3 -c "import json,sys;print((json.load(open(sys.argv[1],encoding='utf-8')).get('cli') or {}).get('alias') or '')" "$(npath "${REPO_ROOT}/${root}/${aid}/app.json")" 2>/dev/null)"
      tok="${alias:-${aid}}"
      printf '\n%s%s%s%s\n' "${c1}" "${tok}" "${c0}" "$([ -n "${alias}" ] && printf '  (%s)' "${aid}")"
      while IFS= read -r vb; do
        [ -n "${vb}" ] || continue
        # Resolve the real file: app_verbs yields BASE names, so `accept` is accept.py. Reading
        # "${d}/${vb}" directly failed under `set -e` and killed the whole listing after the first
        # extensionless miss — indox's section rendered as a heading with nothing under it.
        f=""; for e in "" .sh .py .mjs; do [ -f "${d}/${vb}${e}" ] && { f="${d}/${vb}${e}"; break; }; done
        desc="$(sed -n '2,4p' "${f:-/dev/null}" 2>/dev/null | sed -n 's/^#: *//p' | head -1 || true)"
        printf '  %-34s %s\n' "bbox ${tok} ${vb}" "${desc}"
      done <<EOF
${verbs}
EOF
    done
  done
}

# ensure_glitchtip_provisioned moved to platform-base/glitchtip/hooks/prepare.
# One app's provisioning, its own four services, and a fallback re-run were three
# separate things layer 0 knew about glitchtip. run_app_hooks invokes it generically now.
confirm() { # confirm "msg" ; honor --force/$2
  [ "${FORCE:-0}" = "1" ] && return 0
  printf '%s [y/N] ' "$1"; read -r ans </dev/tty 2>/dev/null || ans=""
  case "$ans" in y|Y|yes|YES) return 0;; *) return 1;; esac
}

usage() {
  cat <<EOF
${c1}bbox${c0} — deployment CLI  (DEPLOYMENT_NAME=${DN})

${c1}Lifecycle${c0}
  bbox run [svc...]        bring the stack up (docker compose up -d; ensures traefik-network)
  bbox stop               bring the stack down (containers removed, data volumes KEPT)
  bbox reset [--force]     ${cr}DESTROY all data${c0} (docker compose down -v) — asks to confirm
  bbox status             deployment health overview (containers + n8n + creds)
  bbox agent <verb>       the office agent from the terminal: list|new|send|follow|watch|show|log|wait|cancel|
                          rename|fork|cmd|goal|model|presets|upload|login|doctor  (bbox agent --help)
  bbox remote [office [alias [path]]]  the apps of a LINKED office, and one call through the link
  bbox dialable [-Check|-Undo]  can another office DIAL this one? On Windows: switches WSL to mirrored
