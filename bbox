cmd="${1:-help}"; shift || true
# global --force flag
FORCE=0; args=(); for a in "$@"; do [ "$a" = "--force" ] && FORCE=1 || args+=("$a"); done; set -- "${args[@]+"${args[@]}"}"

case "${cmd}" in
  run)
    need_docker
    # one heavy job at a time on this engine (heavy_admit, scripts/lib.sh) — a run builds and starts
    heavy_admit "bbox run $*"
    # Fresh cloud sandbox with no .env yet → generate a secretless one (localhost/http) and re-exec so
    # DN and every read_env pick it up. On a laptop/VPS you bring your own .env; we never overwrite it.
    #
    # The macOS engine (BBOX_IN_GUEST, see packaging/macos.md) is the same shape as the sandbox — a
    # fresh Linux guest with no .env and a *.localhost edge — so `git clone` + `./bbox run` on a Mac
    # gets the same generated .env: random secrets, DEPLOYMENT_NAME=local, and the auth redirect
    # carrying the host port the edge is forwarded to (8080). Set BUSINESS_NAME in it afterwards.
    if [ ! -f "${REPO_ROOT}/.env" ] && { ccr_have_proxy_ca || [ -n "${BBOX_IN_GUEST:-}" ]; }; then
      if [ -n "${BBOX_IN_GUEST:-}" ]; then
        say "no .env — generating a local one for the macOS engine (scripts/ci-env.sh, DEPLOYMENT_NAME=local, edge on :8080)…"
        ( cd "${REPO_ROOT}" && CI_DEPLOYMENT_NAME=local CI_EDGE_PORT=8080 bash scripts/ci-env.sh ) >/dev/null 2>&1 || say "${cy}ci-env.sh reported an issue${c0}"
      else
        say "no .env — generating a secretless cloud .env (scripts/ci-env.sh)…"
        ( cd "${REPO_ROOT}" && bash scripts/ci-env.sh ) >/dev/null 2>&1 || say "${cy}ci-env.sh reported an issue${c0}"
      fi
      exec "${REPO_ROOT}/bbox" run "$@"
    fi
    ensure_rendered; ensure_network; ensure_perf_profile
    # A name this stack needs, held under ANOTHER compose project, is said HERE — the compile
    # is current, and no hook has run and nothing has been built yet: over such a container compose
    # aborts partway and leaves half a stack (lib.sh: foreign_containers).
    held="$(foreign_containers)"
    [ -z "${held}" ] || die "another compose project holds container names this stack needs:
$(printf '%s\n' "${held}" | sed 's/^/    /')
  Bring that project down where it was started, or remove just these containers (their volumes are kept):
    docker rm -f $(printf '%s\n' "${held}" | awk '{print $1}' | tr '\n' ' ')
  then run this again."
    # `|| true`: a failed bootstrap is LOUD (run_app_hooks names the app) but must not deny
    # every later app its own prepare, nor abort a bring-up that is otherwise fine.
    run_app_hooks prepare || true   # each app's OWN bootstrap; bbox names none of them
    # Cloud-sandbox accommodations (see scripts/lib.sh). Each is a GUARDED NO-OP on a normal
    # Windows/VPS host, so this block changes nothing there. On a MITM-proxy sandbox it: caps the
    # postgres nofile ulimit to what the kernel allows, CA-shadows the base images, and pre-builds
    # the first-party images serially — so a plain `bbox run` just works instead of failing on
    # in-container pip/npm TLS, a rlimit denial, or a concurrent-npm OOM.
    ccr_clamp_nofile || true
    # [2026-08-23] A host whose DEFAULT BRIDGE has no egress still builds fine over the host
    # network. Measured on portable-ubuntu: a docker0 container pings 1.1.1.1 but cannot open
    # TCP/443 or UDP/53, while the stack's own user-defined network reaches both -- so nothing
    # the platform RUNS is affected and only `docker build`, which uses docker0, fails.
    # This replaces a hard refusal added a day earlier. Refusing was wrong twice: it stopped a
    # host that can build perfectly well, and it left 19 of 42 services unbuilt -- including
    # app-management, so the console's apps screen had no catalog to read and showed nothing.
    if ! ccr_have_proxy_ca && bbox_container_dns_broken; then
      say "${cy}default-bridge egress is dead on this host — building first-party images over the host network${c0}"
      if ccr_build_serial; then BBOX_PREBUILT=1; else
        say "${cy}some first-party builds failed — see above; continuing to up${c0}"
      fi
    fi
    if ccr_have_proxy_ca && [ "${CCR_BASES_READY:-0}" != 1 ]; then
      say "MITM egress proxy detected — CA-shadowing bases + serial-building first-party images…"
      ccr_shadow_bases || true
      # If a needed base image couldn't be pulled, the network policy is blocking registries — stop
      # now with the clear hint rather than grinding through builds that can't fetch their layers.
      [ "${CCR_REGISTRY_BLOCKED:-0}" = 1 ] && die "base images unavailable — fix the environment's network policy (see hint above), then re-run 'bbox run'"
      ccr_build_serial || say "${cy}some first-party builds failed — see above; continuing to up${c0}"
    fi
    # The authentik-first HEAD START used to sit here: four of one app's services started by name,
    # then a 15s sleep, because its first-boot migrations and serial blueprint application are
    # CPU-heavy and racing the whole stack stretched init from a few minutes to ~20. It is now
    # platform-base/authentik/hooks/prepare, invoked generically by the run_app_hooks call above —
    # the app starts what it owns and blocks on its OWN SSO sentinel, so the behaviour is intact
    # and this file names no app to get it. The `$#` guard went with it: a prepare hook is the
    # app's own business on every bring-up, targeted or not, and it no-ops when it is already up.
    # GlitchTip BEFORE the whole-stack wait, for the same reason authentik gets a head start:
    # something downstream cannot be healthy until it is done.
    #
    # `notifications` (התראות) polls GET /organizations/<slug>/issues/, and its health is
    # deliberately RED whenever it is not polling — blind is not healthy, that check exists
    # because ~1,700 errors once went unreported behind a green container. But the org it polls is
    # created by glitchtip-push, which ran AFTER `up --wait`. So on every fresh deploy the wait
    # could not succeed: notifications 404'd on an org that provisioning had not created yet, the
    # full timeout burned (300s warm, 600s cold), `bbox run` printed "not all services healthy",
    # and only the provisioning step after it made the deployment correct. First impression of a
    # one-command install: a stack that reports itself broken and then quietly fixes itself.
    #
    # Observed on the 2026-07-29 staging re-stage, and it is not a rename artefact — a genuinely
    # fresh company hits it identically: its org slug (COMPANY_SLUG) has never existed either.
    #
    # So: bring glitchtip's own services up, wait for THEM, provision, and only then wait on the
    # stack. Provisioning writes <APP>_SENTRY_DSN + GLITCHTIP_API_TOKEN into .env, and the `up`
    # below re-creates consumers — so notifications gets both its token and an org that exists,
    # on its FIRST start. `$#` guard: a targeted `bbox run <svc>` is not a whole-stack bring-up.
    say "bringing up the stack (${DN})… waiting for healthy (SSO gated by authentik-bootstrap)"
    # --wait blocks until every service is healthy/completed; the authentik-bootstrap sentinel
    # only goes healthy once the embedded outpost serves all gated hosts → no post-up 404 window.
    #
    # ONE GENERIC CEILING. This used to be a cold/warm decision made HERE, by probing one app's
    # postgres volume by name — the CLI both knowing which app dominates a cold start (identity:
    # migrations, serial blueprints, embedded-outpost sync, measured past 300s on a fresh `reset`)
    # and knowing which volume proves it has booted before. Two pieces of one app's knowledge, in
    # the file that is supposed to hold none.
    #
    # That decision now belongs to the app that owns the volume: its hooks/prepare picks its own
    # cold/warm allowance and BLOCKS on its own readiness sentinel, before this line is reached.
    # So the slow initialiser is already done by the time we wait on the stack, and what is left
    # here is a ceiling for everything else. Callers wanting more headroom on a cold runner still
    # export BBOX_WAIT_TIMEOUT — scripts/onboarding, scripts/baseline.sh and ci-verify.yml all set
    # 600 — which is a generic knob, not an app talking to the CLI about itself.
    # `--build`: without it, `up -d` starts whatever image already exists under a service's tag and
    # never asks whether the Dockerfile it names has moved since. That is exactly how a VPS redeploy
    # goes stale silently — `git pull && bbox run` moves the checkout and the schema (whatever hook
    # applies it) forward, but a first-party service keeps serving the OLD image, because nothing
    # ever told compose to look again. Found the hard way: staging's `incoming-documents` ran code
    # from before a schema migration landed, while its Postgres was already migrated — one write
    # path 400'd on every call, surfaced to a user as "the database is unavailable" with a perfectly
    # healthy database. Docker's own build cache is what keeps this cheap on the common `bbox run`
    # where nothing changed — a cache hit per service is a filesystem walk plus a manifest compare,
    # not a rebuild; the redeploy case is the one this exists for, not the routine one it also runs on.
    _wt="${BBOX_WAIT_TIMEOUT:-300}"
    # [2026-08-23] --build is deliberate (see above) and stays the default. It is dropped in
    # exactly one case: the serial host-network build above already rebuilt every first-party
    # image this run, and on a host with a dead default bridge compose's own build CANNOT
    # succeed -- it uses docker0 and dies in pip with "Temporary failure in name resolution".
    # Measured: the serial pass tagged incoming-documents/machine/mailapi/mailview/notifications
    # fine, then `up --build` rebuilt them over docker0 and failed. Skipping it here loses
    # nothing: the freshness guarantee --build exists for was just provided seconds earlier.
    _bf="--build"; [ -n "${BBOX_PREBUILT:-}" ] && _bf=""
    dc up -d ${_bf} --wait --wait-timeout "${_wt}" "$@" \
      || say "${cy}not all services healthy within ${_wt}s — check 'bbox status' / 'bbox logs'${c0}"
    # Safety net: --wait can return (timeout) with services still 'Created' that were waiting on a
    # slow depends_on (e.g. n8n workers wait for n8n main service_healthy; first-run migrations +
    # image builds can exceed the window). A plain `up -d` now starts them — their deps have since
    # gone healthy. Without this the queue never drains (workers stuck Created). Idempotent no-op
    # when everything is already running.
    #
    # Provision GlitchTip BEFORE that `up`, not after: glitchtip-push writes <APP>_SENTRY_DSN and
    # GLITCHTIP_API_TOKEN into .env, and containers only read .env at (re)create time. Compose
    # resolves .env on every invocation and recreates whatever's config hash changed, so the `up`
    # below is what actually hands `notifications` its poller token. Provisioning after it would
    # write the values and leave every consumer running on the stale (empty) env until the next
    # unrelated restart — green config, dead runtime. Safe here: `--wait` above already returned,
    # so glitchtip is healthy (migrations done) and its ORM is usable.
    #
    # Now a FALLBACK. The whole-stack wait is no longer the first chance to provision — the
    # glitchtip phase above is — so this only fires for a targeted `bbox run <svc>`, or when
    # glitchtip was still coming up during that phase. Skipped when it already ran: it is
    # idempotent (get_or_create + DETERMINISTIC DSNs), but it is also a minute of ORM work.
    # …and make sure SSO is actually serving the hosts this deployment declares, not the ones
    # authentik-server happened to load at boot. Runs after the wait: the sentinel must have
    # applied the blueprints and computed its host list before there is anything to check.
    ensure_sso_current
    dc up -d "$@" >/dev/null 2>&1 || true
    # NOTE: the INDOX UI 'בדיקות' (tests) tab drives the n8n E2E suites via lane webhooks (part of
    # the core n8n stack) — it does not need feature-validation-api. That service is
    # apps/apitools/feature-validation, a CI/dev quality tool reached via `bbox test apitools`
    # (apps/apitools/hooks/test); it is intentionally NOT part of the default bring-up.
    ensure_converged
    # Each enabled app's own first-run seeding (schema, demo state, whatever it declares it needs).
    # `ensure_converged` above already guarantees n8n holds every enabled app's blueprint — including,
    # via the schema-apply now folded into `apps/n8n/hooks/push` itself, the platform schema
    # every app's onboard hook can assume exists — so ordering is correct by construction, not by
    # phase placement. `|| true`: onboard hooks are LOUD on failure (run_app_hooks names the app) but
    # must not fail a `bbox run` that otherwise brought the stack up fine — each hook is responsible
    # for being safe to call unconditionally (i.e. a no-op once its own app is already onboarded).
    run_app_hooks onboard || true
    # Last, so it is the last thing on the screen: are the hosts sign-in is DECLARED on hosts the
    # edge routes (gate G70)? The one failure here that comes up green — every container healthy,
    # a bare 404 at the first login. Said, not fatal: the office is up either way. Whole-stack
    # runs only — a targeted `bbox run <svc>` may leave a router's container down on purpose.
    [ $# -gt 0 ] || python3 "$(npath "${REPO_ROOT}/scripts/refactor/declared-host-routing-lint.py")" --quiet || true
    say "up. check health with: bbox status" ;;
  stop)
    need_docker; say "stopping the stack (containers removed, data kept)…"; dc down "$@"; say "stopped."
    # `down` stops what THIS compose project owns. A container another project holds under one of
    # this stack's names goes on serving, and "stopped." would be a lie about it.
    held="$(foreign_containers)"
    [ -z "${held}" ] || printf '%s\n' "${held}" | sed "s/^/  ${cy}still there — held by another compose project:${c0} /" ;;
  reset)
    need_docker
    echo "${cr}This DESTROYS all data for '${DN}' (docker compose down -v: postgres, redis, n8n, browser42 profile, …).${c0}"
    confirm "Proceed?" || { say "aborted."; exit 0; }
    say "wiping…"; dc down -v --remove-orphans "$@"
    # `down -v` only removes containers labelled with THIS compose project. A service whose
    # container_name carries no ${DEPLOYMENT_NAME} suffix, created by a DIFFERENT project or
    # invocation (a pre-refactor run, the CI overlay, a manual docker run), is not owned by that
    # line — it survives, and the next `bbox run` dies with "container name already in use".
    #
    # DERIVED, not enumerated. This was a hand-kept list of four names, and it had already drifted:
    # it still removed `chat` and `chat-ci` after apps/chat moved to
    # `container_name: chat-${DEPLOYMENT_NAME:-...}`, so two of its four entries could never match
    # anything, while a NEW fixed-name service would have been missed entirely. The compiled compose
    # already knows every container_name; ask it, and the answer cannot go stale.
    # DN is passed EXPLICITLY: lib.sh sets it as a shell variable, not an exported one, so a bare
    # subprocess sees it empty — and an empty suffix makes the filter match nothing, which would
    # have force-removed EVERY container in the stack instead of the two bare-named ones.
    dc config --format json 2>/dev/null \
      | DN="${DN}" python3 -c 'import json,sys,os
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
dn=os.environ.get("DN","")
if not dn: sys.exit(0)          # never guess: no deployment name, nothing is safe to force-remove
for s in (d.get("services") or {}).values():
    n=s.get("container_name")
    # only the ones compose cannot reclaim by project label: no deployment suffix
    if n and not n.endswith("-"+dn): print(n)' 2>/dev/null \
      | while read -r c; do [ -n "$c" ] && docker rm -f -v "$c" >/dev/null 2>&1 || true; done
    say "reset done. 'bbox run' for a fresh stack, then 'bbox n8n push' + 'bbox onboarding'." ;;
  agent)
    # the office agent, through the agent.v1 contract (ai/context/agent-contract.md) — provider-agnostic.
    # No docker probe: the CLI speaks HTTP to the provider on the host's loopback; only `login` (once)
    # reaches into the engine, and does so by itself.
    exec python3 "$(npath "${REPO_ROOT}/scripts/agent.py")" "$@" ;;
  remote)
    # the apps of a LINKED office, and one authenticated call through the link (DGO-32/37; the
    # remote-apps contract §6–7). Discovery is the compiled registry plus the link plane's own
    # `GET /api/link`, and the reach decision — this process, or a container on the office network —
    # is the CLI's own, because `<alias>.<office>` is a docker network alias and resolves nowhere else.
    exec python3 "$(npath "${REPO_ROOT}/scripts/remote.py")" "$@" ;;
  dialable)
    # Whether another office can DIAL this one is a fact of the MACHINE, so the verb acts where the
    # machine is. On Windows that is bbox.cmd (scripts/windows/wsl-mirrored.ps1): WSL's networking
    # mode is a file in the user's Windows profile and a restart of WSL — neither reachable from
    # inside the distro, so bbox.cmd answers this verb itself and it only arrives HERE when somebody
    # typed it in a Linux shell. Elsewhere there is nothing to switch; this says which case it is.
    if grep -qi microsoft /proc/version 2>/dev/null; then
      say "WSL is in '$(wslinfo --networking-mode 2>/dev/null || echo unknown)' networking. To change it run ${c1}bbox.cmd dialable${c0} from CMD or PowerShell (it asks before it restarts WSL)."
    elif [ -n "${BBOX_IN_GUEST:-}" ]; then
      if [ -n "${BBOX_HOST_LAN_ADDR:-}" ] && [ -n "${BBOX_HOST_UDP_PORT:-}" ]; then
        say "the macOS engine forwards UDP ${BBOX_HOST_UDP_PORT} from ${BBOX_HOST_LAN_ADDR} into this office: it can be dialed there."
      else
        say "on macOS this is the engine's: it forwards no UDP port inward, so this office dials and cannot be dialed (ai/context/dgo-pairing-contract.md, \"the engine's half\")."
      fi
    else
      say "a Linux machine can be dialed as it is: 'bbox run' declares a local office's LAN address by itself; a public server's address is its owner's to declare (DGO_WG_ENDPOINT / DGO_WG_PUBLISH_PORT in .env)."
    fi ;;
  status)
    need_docker
    # …and the compose PROJECT these answers are about: a checkout reached by a path compose names
    # differently talks to a project of its own, and "0 containers" from it reads as "the office is down".
    say "deployment ${DN} · compose project $(dcx config --format json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("name") or "?")' 2>/dev/null || echo '?')"
    total=$(docker ps -a --format '{{.Names}}' | grep -c -- "-${DN}$" || true)
    up=$(docker ps --format '{{.Names}}\t{{.Status}}' | grep -- "-${DN}" | grep -c 'Up' || true)
    healthy=$(docker ps --format '{{.Status}}' | grep -c 'healthy' || true)
    echo "  containers: ${cg}${up} up${c0} / ${total} (${healthy} healthy; one-shot init containers exit 0)"
    # only flag genuine problems: not Up and not a clean Exited (0) init container
    docker ps -a --format '{{.Names}}\t{{.Status}}' | grep -- "-${DN}" | grep -viE 'Up |Exited \(0\)' | sed "s/^/  ${cr}DOWN:${c0} /" || true
    # …the ones another compose project holds under this stack's names (lib.sh: foreign_containers)
    held="$(foreign_containers)"
    [ -z "${held}" ] || printf '%s\n' "${held}" | sed "s/^/  ${cr}held by another compose project:${c0} /"
    # …and the ones that are up but are not what the files say now (lib.sh: stale_containers)
    stale="$(stale_containers | tr '\n' ' ')"
    [ -z "${stale}" ] || echo "  ${cy}not what the files say now:${c0} ${stale}— ${c1}bbox run${c0} re-creates exactly these"
    [ -x "${REPO_ROOT}/apps/n8n/hooks/status" ] && bash "${REPO_ROOT}/apps/n8n/hooks/status" --brief || true ;;
  verify)
    sub="${1:-dependencies}"
    case "${sub}" in
      dependencies|deps) bash "${SCRIPTS}/verify-dependencies" ;;
      *) die "unknown: bbox verify ${sub}  (dependencies)" ;;
    esac ;;
  logs)
    need_docker; dc logs --tail=200 "$@" ;;

  update)
    # bbox update <app|service> […] — apply a rebuilt image to the RUNNING office and prove it
    # landed: build, compare the image the container runs against the one just built, replace only
    # when they differ (or --force), wait for the container's own healthcheck, roll back if it never
    # gets healthy. Written because `dc up -d --build <app>` did nothing twice in one hour and read
    # as success (see scripts/app-update.sh). bina-ds is handed to its own self-update door.
    need_docker
    # `--force` is bbox's own global flag and is consumed before dispatch (line ~509), so it is
    # handed to the verb through the environment rather than re-parsed.
    APP_UPDATE_FORCE="${FORCE}" \
      bash -c 'cd "$1" && exec bash "$2" "${@:3}"' _ "${REPO_ROOT}" "$(npath "${SCRIPTS}/app-update.sh")" "$@" ;;

  export|import)
    # Move a whole deployment to another machine. See scripts/deployment-archive.py for why a zip
    # of this folder is not a backup: every database, workflow, credential, document, auth user and
    # sync cursor lives in a docker named volume OUTSIDE the tree.
    #
    # Dispatched here rather than as an app verb because the archive spans every app — but it owns
    # no app knowledge: the inventory comes from each app's `data.volumes` (gate G26 keeps that
    # honest) and the store-specific work comes from each app's own hooks/backup + hooks/restore.
    need_docker
    ( cd "${REPO_ROOT}" && exec python3 "$(npath "${SCRIPTS}/deployment-archive.py")" "${cmd}" "$@" ) ;;

  app)
    # bbox app install <ref> — install an app that is NOT a folder in this repo (roadmap item 5).
    # Checked BEFORE the <id> <verb> form: `install` is a reserved word here, not an app id (no app
    # may be called that), so there is no ambiguity to resolve.
    if [ "${1:-}" = "install" ]; then
      shift
      ( cd "${REPO_ROOT}" && exec python3 "$(npath "${REPO_ROOT}/platform/manager/appinstall.py")" "$@" )
      exit $?
    fi
    # bbox app <id> <verb> [args] — run an app's OWN hook.
    #
    # An app is a folder; its tooling belongs inside it, not in a shared scripts/ pile named by
    # convention. Hooks live at <root>/<id>/hooks/<verb> where <root> is apps/ or platform-base/,
    # so deleting an app takes its tooling with it. Falls back to the legacy scripts/<id>-<verb>
    # while the migration is in progress, and says which one it ran.
    aid="${1:-}"; verb="${2:-}"; shift 2 2>/dev/null || true
    [ -n "${aid}" ] && [ -n "${verb}" ] || die "usage: bbox app <id> <verb> [args]"
    hook=""
    for root in apps platform-base; do
      for ext in "" .sh .py .mjs; do
        [ -f "${REPO_ROOT}/${root}/${aid}/hooks/${verb}${ext}" ]           && { hook="${REPO_ROOT}/${root}/${aid}/hooks/${verb}${ext}"; break 2; }
      done
    done
    if [ -z "${hook}" ]; then
      for legacy in "${SCRIPTS}/${aid}-${verb}" "${SCRIPTS}/${aid}-${verb}.py" "${SCRIPTS}/${aid}-${verb}.sh"; do
        [ -f "${legacy}" ] && { hook="${legacy}"; break; }
      done
    fi
    [ -n "${hook}" ] || die "no hook '${verb}' for app '${aid}' (looked in {apps,platform-base}/${aid}/hooks/ and scripts/)"
    # .mjs runs under node. It was already in the resolution list above and in app_verbs(), so a
    # .mjs hook was offered by `bbox help` and then handed to bash, which choked on line 2 of every
    # one of them. Both existing .mjs hooks carry "run via node directly" in their headers for
    # exactly this reason; they are reachable now.
    case "${hook}" in
      *.py)  exec python3 "$(npath "${hook}")" "$@" ;;
      *.mjs) exec node "$(npath "${hook}")" "$@" ;;
      *)     exec bash "${hook}" "$@" ;;
    esac ;;

  n8n)
    sub="${1:-}"; shift || true
    case "${sub}" in
      # ── Blueprint verbs are EXPLICITLY TARGETED (owner mandate 2026-08-16, plan in
      # ai/context/n8n-as-code-migration.md): bare `push`/`pull` is a hard error — say WHAT.
      #   bbox n8n push <app>    rapid per-app deploy: compile .workflow.ts → n8n API update+activate
      #                          (no restart, hot triggers) — the everyday dev verb
      #   bbox n8n push all      full instance reconciler (owner/creds/schema/gates/import/RESTART)
      #   bbox n8n pull <app>    live → that app's blueprint as .workflow.ts code files
      #   bbox n8n pull all      live → every blueprint, routed by each workflow's app:* tag
      pull)
        # bbox n8n pull <app> [wfId ...]  — the agent's FIRST step, always (live is truth):
        # pull what you are about to edit, edit the code, push immediately.
        tgt="${1:-}"; shift || true
        case "${tgt}" in
          all)  bash "${REPO_ROOT}/apps/n8n/hooks/pull" "$@" ;;
          "")   die "bbox n8n pull needs a target: 'all' (estate + credentials + manifest) or '<app> [wfId ...]' (e.g. 'bbox n8n pull indox indoxV2Driver01')." ;;
          *)    [ "${tgt}" = "base" ] && tgt="n8n"
                bash "${REPO_ROOT}/apps/n8n/hooks/pull-app" "${tgt}" "$@" ;;
        esac ;;
      push)
        # bbox n8n push <app> <wfId> [...] — push exactly what you edited (agent default).
        # No ids = changed-only. --all = whole app. 'all' = full instance reconciler.
        tgt="${1:-}"; shift || true
        case "${tgt}" in
          all)  bash "${REPO_ROOT}/apps/n8n/hooks/push" "$@" ;;
          "")   die "bbox n8n push needs a target: 'all' (full reconciler + RESTART) or '<app> [wfId ...]' (e.g. 'bbox n8n push indox indoxV2Driver01')." ;;
          *)    [ "${tgt}" = "base" ] && tgt="n8n"
                # [2026-08-23] RE-EMIT --force. bbox strips it globally (see the "global --force
                # flag" line near the top: it sets FORCE=1 and REMOVES the token from "$@"), so
                # push-app -- which parses --force itself and guards its whole conflict check on
                # it -- never saw the flag. The failure was quiet and expensive: the push reports
                # "CONFLICT <wf> - changed LIVE (likely a human in the editor)" and prescribes
                # `bbox n8n pull <app> <wf>` instead. That pull round-trips the workflow through
                # n8n, and n8n does not store the .workflow.ts decorator comments -- pulling three
                # indox action workflows here removed 151 lines of source, including notes nothing
                # else records. So the documented remedy destroyed source while the escape hatch
                # that avoids it was disabled by an argument parser two hundred lines away.
                _force=(); [ "${FORCE}" = "1" ] && _force=(--force)
                bash "${REPO_ROOT}/apps/n8n/hooks/push-app" "${tgt}" "$@" "${_force[@]+"${_force[@]}"}" ;;
        esac ;;
      code)
        # toolchain + authoring intelligence: render|compile|verify <src> [out]
        #                                     validate|info|schema|search|docs|guides <args>
        node "${REPO_ROOT}/apps/n8n/tooling/wrap.mjs" "$@" ;;
      test|plan|exec)
        # live testing + diagnosis (agent exit semantics: 0 = don't block, 1 = iterate)
        #   bbox n8n test <app> <wfId> [--prod] · plan <app> <wfId> [--json] · exec list|get ...
        if [ "${sub}" = "exec" ]; then
          bash "${REPO_ROOT}/apps/n8n/hooks/test-app" exec "$@"
        else
          _app="${1:-}"; shift || true
          [ -n "${_app}" ] || die "bbox n8n ${sub} needs: <app> <wfId> [flags]"
          bash "${REPO_ROOT}/apps/n8n/hooks/test-app" "${sub}" "$@"
        fi ;;
      execute)
        # run ONE node against a set of items (throwaway workflow, removed by default)
        #   bbox n8n execute -n <node.json> <input.json> [--ex-link]
        bash "${REPO_ROOT}/apps/n8n/hooks/execute-node" "$@" ;;
      status)          bash "${REPO_ROOT}/apps/n8n/hooks/status" "$@" ;;
      verify)          bash "${REPO_ROOT}/apps/n8n/hooks/verify" "$@" ;;
      clean-recreate)  [ "${FORCE}" = "1" ] && bash "${REPO_ROOT}/apps/n8n/hooks/clean-recreate" --yes || bash "${REPO_ROOT}/apps/n8n/hooks/clean-recreate" "$@" ;;
      load-dump)       bash "${REPO_ROOT}/apps/n8n/hooks/load-dump" "$@" ;;
      automations)
        a2="${1:-}"; shift || true
        case "${a2}" in
          reset)
            # app-STATE reset (not infra). Dry-run by default; needs --force to mutate.
            extra=(--dry-run); [ "${FORCE}" = "1" ] && extra=(--force)
            bash "${SCRIPTS}/automations-reset" "${extra[@]}" "$@" ;;
          *) die "unknown: bbox n8n automations ${a2:-<none>}  (reset)" ;;
        esac ;;
      *)
        # PER-APP blueprint: `bbox n8n <app> push|pull` — e.g. `bbox n8n indox push`,
        # `bbox n8n base pull`. An app OWNS its workflows (manifest `blueprints.n8n`), so the
        # blueprint verbs are scoped to one app instead of one global pile. `base` is the alias
        # for the n8n app's own central blueprint (shared stdlib + platform/CI workflows).
        v2="${1:-}"
        case "${v2}" in
          push)
            # legacy order alias — same rapid API path as `bbox n8n push <app>`
            shift || true
            _app="${sub}"; [ "${_app}" = "base" ] && _app="n8n"
            bash "${REPO_ROOT}/apps/n8n/hooks/push-app" "${_app}" "$@" ;;
          pull|unpush)
            shift || true
            _app="${sub}"; [ "${_app}" = "base" ] && _app="n8n"
            bash "${REPO_ROOT}/apps/n8n/hooks/${v2}" --app "${_app}" "$@" ;;
          *) die "unknown: bbox n8n ${sub:-<none>} ${v2:-}  (push all|<app> · pull all|<app> · code · status|verify|clean-recreate|load-dump|automations)" ;;
        esac ;;
    esac ;;

  seed)
    # seed the platform with demo data so every UI renders real content (same path local + CI).
    need_docker; bash "${SCRIPTS}/ui-coverage/seed.sh" "$@" ;;

  ui-map)
    # capture the whole platform UI into one map image + coverage. Reads a running stack; drives
    # inventory → seed → resolve → sharded containerized capture → report → compose. No browser42.
    need_docker; heavy_admit "ui-map $*"; bash "${SCRIPTS}/ui-coverage/ui-map.sh" "$@" ;;

  baseline)
    # prove a HEALTHY BASELINE in one fresh command: reset → build → up → ci-verify → indox test →
    # any-concurrency + notifications review → ui-map → scorecard. See ai/context/healthy-baseline.md.
    need_docker; heavy_admit "baseline $*"; bash "${SCRIPTS}/baseline.sh" "$@" ;;

  test)
    # bbox test <app> [args] — ONE way to test any app. Every app that has tests exposes them at
    # <root>/<id>/hooks/test, so the command is identical whether the app is an automation app
    # (indox), a service+UI app (drive, mail) or a base app. This is just the canonical spelling
    # of `bbox app <id> test`; it exists so "how do I test app X" has a single answer.
    aid="${1:-}"; shift || true
    [ -n "${aid}" ] || die "usage: bbox test <app> [args]   (apps with tests: $(for d in apps/*/hooks/test platform-base/*/hooks/test; do [ -e "$d" ] && basename "$(dirname "$(dirname "$d")")"; done | tr '\n' ' '))"
    hook=""
    for root in apps platform-base; do
      [ -f "${REPO_ROOT}/${root}/${aid}/hooks/test" ] && { hook="${REPO_ROOT}/${root}/${aid}/hooks/test"; break; }
    done
    [ -n "${hook}" ] || die "app '${aid}' has no tests (expected ${aid}/hooks/test)"
    exec bash "${hook}" "$@" ;;

  install)
    sub="${1:-}"; shift || true
    case "${sub}" in
      debian)  bash "${REPO_ROOT}/debian-install.sh" "$@" ;;
      windows) bash "${SCRIPTS}/install-windows" "$@" ;;
      # Reaching here means we are already inside the guest (the host intercepts `install macos`
      # above and starts the engine) — so there is nothing left to install.
      macos)   say "already inside the macOS project engine — nothing to install" ;;
      *) die "unknown: bbox install ${sub:-<none>}  (debian|windows|macos)" ;;
    esac ;;

  apply)
    # Apply a plan written by `bbox plan` — refuses if the catalog/state moved underneath, so a
    # stale plan can never be mistaken for a deliberate one.
    need_docker
    ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py apply "$@" ) || exit 1
    dc up -d --remove-orphans ;;

  generations)
    # every `reconcile render` archives the previous .generated/ — list what we can roll back to
    ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py generations "$@" ) ;;

  rollback)
    # restore a previous rendered configuration, then converge Docker onto it.
    # NOTE: this rolls back the CONFIGURATION, not your data — volumes are untouched.
    need_docker
    ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py rollback "$@" ) || exit 1
    say "bringing the stack onto the restored configuration…"
    dc up -d --remove-orphans ;;

  reconcile)
    # platform-OS: compile apps/*/app.json + platform.state.yaml -> .generated/ -> docker.
    # `bbox reconcile` with no verb renders; pass plan|render|up|validate explicitly.
    need_docker
    ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py "${1:-render}" ) ;;

  apps)
    sub="${1:-list}"; shift || true
    case "${sub}" in
      # `"$@"` is passed on: `plan` grew flags (--json) that are the CLI's own answer to "which apps
      # does this office show, machine-readable", and a wrapper that swallows them makes the flag
      # exist and do nothing.
      list)     ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py plan "$@" ) ;;
      validate) ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py validate ) ;;
      # The disposition write is reconcile.py's, not ours. It used to be twenty lines of inline
      # python here doing its own regex surgery on platform.state.yaml — one of FOUR independent
      # writers of that file, in two incompatible shapes, against a single shared reader. The CLI
      # has no business owning the format of the platform's desired state.
      enable|disable)
        app="${1:?usage: bbox apps ${sub} <app-id>}"
        _dispo=enabled; [ "${sub}" = disable ] && _dispo=disabled
        # --create: the FIRST enable of a newly added app is precisely the case this verb exists
        # for — apps/<id>/app.json is on disk and platform.state.yaml has no entry for it yet.
        # Without the flag set-state refuses with "not found in platform.state.yaml (use --create
        # to add it)", which is advice this wrapper had no way to act on.
        ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py set-state --app "${app}" --state "${_dispo}" --by cli --create ) \
          || die "could not set '${app}' to ${_dispo}"
        say "${cy}state written. Containers and n8n blueprints are NOT converged by this command —${c0}"
        say "${cy}  run 'bbox run', or use the apps screen, which does the whole lifecycle.${c0}"
        ( cd "${REPO_ROOT}" && python3 platform/manager/reconcile.py render ) ;;
      install) ( cd "${REPO_ROOT}" && exec python3 "$(npath "${REPO_ROOT}/platform/manager/appinstall.py")" "$@" ) ;;
      *) die "unknown: bbox apps ${sub}  (list|validate|enable|disable|install)" ;;
    esac ;;

  catalog)
    # platform-OS: the SIGNED app catalog (F-Droid index-v2 model) — build it from apps/, verify a
    # signature + every per-entry hash, and disclose what an app will do before it is installed.
    ( cd "${REPO_ROOT}" && exec python3 "$(npath "${REPO_ROOT}/platform/manager/catalog.py")" "$@" ) ;;

  onboarding|onboard)
    bash "${SCRIPTS}/onboarding" "$@" ;;

  help|-h|--help|"") usage ;;

  # ── generic app dispatch ─────────────────────────────────────────────────────────────────────
  # Anything not matched above is an APP ID or an app's declared alias, and the next word is a verb:
  #
  #   bbox <id|alias> <verb> [args]   →   <root>/<id>/hooks/<verb> [args]
  #
  # This is the whole reason `bbox` no longer has a `case` per app. It used to carry a 40-line
  # `indox)` block and a 20-line `b42)` block, and their verbs again in the help heredoc, so adding
  # an app meant editing the CLI in three places — the exact coupling G31 forbids everywhere else.
  # An app's command surface is now the set of files in its hooks/ directory, and nothing else.
  #
  # `cli.fallback` (app.json) lets one implementation answer several verbs: browser42 declares
  # fallback "state", so `bbox b42 dump` runs `hooks/state dump` without four files of boilerplate.
  *)
    _res="$(app_resolve "${cmd}")" || die "unknown command '${cmd}'. Run 'bbox help'."
    _root="${_res%% *}"; _aid="${_res#* }"; _aid="${_aid%% *}"; _fb="${_res##* }"
    [ "${_fb}" = "${_aid}" ] && _fb=""
    verb="${1:-}"; shift || true
    hook=""
    if [ -n "${verb}" ]; then
      for _ext in "" .sh .py .mjs; do
        [ -e "${REPO_ROOT}/${_root}/${_aid}/hooks/${verb}${_ext}" ]         && { hook="${REPO_ROOT}/${_root}/${_aid}/hooks/${verb}${_ext}"; break; }
      done
    elif [ -z "${_fb}" ]; then
      # No verb and no declared fallback: the usage line is the answer.
      die "usage: bbox ${cmd} <verb> [args]$(app_verbs_line "${_root}" "${_aid}")"
    fi
    # `bbox <app>` with no verb runs the app's declared fallback with no arguments — a short name is a
    # command (`bbox dgo`), not a usage error. Only an app that declares `cli.fallback` gets this;
    # everything else keeps the explicit-verb contract.
    if [ -z "${hook}" ] && [ -n "${_fb}" ]; then
      # no hooks/<verb> — hand the verb to the declared fallback as its first argument
      hook="${REPO_ROOT}/${_root}/${_aid}/hooks/${_fb}"; set -- "${verb}" "$@"
    fi
    [ -n "${hook}" ] && [ -e "${hook}" ] || die "unknown: bbox ${cmd} ${verb}$(app_verbs_line "${_root}" "${_aid}")"
    case "${hook}" in
      *.py)  exec python3 "$(npath "${hook}")" "$@" ;;
      *.mjs) exec node "$(npath "${hook}")" "$@" ;;
      *)     exec bash "${hook}" "$@" ;;
    esac ;;
esac
